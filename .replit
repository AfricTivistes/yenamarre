modules = ["nodejs-20", "web", "nix"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 43
externalPort = 3001

[[ports]]
localPort = 4321
externalPort = 80

[[ports]]
localPort = 4322
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 33807
externalPort = 4200

[[ports]]
localPort = 38857
externalPort = 3002

[[ports]]
localPort = 39355
externalPort = 5173

[[ports]]
localPort = 39823
externalPort = 3003

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Dev Server"
author = 38311320
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
