---
import Header from "../components/Header.astro"
import ProjectNavbar from "../components/ProjectNavbar.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"

export interface Props {
  title: string
  description?: string
  currentPath?: string
}

const {
  title,
  description = "Y'EN A MARRE - Mouvement citoyen sénégalais pour la démocratie et la bonne gouvernance",
  currentPath = "",
} = Astro.props
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/yem.webp" />
    <meta name="generator" content={Astro.generator} />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VYVJ1XLM6W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VYVJ1XLM6W');
    </script>

    <!-- Netlify Identity Widget -->
      <script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header currentPath={currentPath} />
    <ProjectNavbar currentPath={currentPath} />

    <main>
      <slot />
    </main>

    <Footer currentPath={currentPath} />
  </body>
</html>