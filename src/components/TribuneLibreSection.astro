---
export interface Props {
  tribuneArticles: {
    id: number;
    title: string;
    excerpt: string;
    date: string;
    category: string;
    image: string;
    url: string;
  }[];
}

const { tribuneArticles } = Astro.props;
---

<!-- Tribune libre - Section mise en avant -->
<section class="py-16 bg-gradient-to-br from-gray-50 to-white">
  <div class="container-custom">
    <div
      class="bg-white rounded-2xl overflow-hidden shadow-xl border border-gray-100"
    >
      <div class="grid md:grid-cols-2 gap-0">
        <div
          class="bg-gradient-to-br from-gray-800 to-gray-900 text-white p-8 md:p-12 flex flex-col justify-center"
        >
          <div class="flex items-center mb-6">
            <div
              class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm mr-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl md:text-3xl font-bold mb-2">Tribune libre</h3>
              <p class="text-gray-300">Espace d'expression citoyenne</p>
            </div>
          </div>
          <p class="text-lg text-gray-200 mb-6">
            Découvrez les réflexions et analyses de nos membres et sympathisants
            sur les enjeux démocratiques du Sénégal.
          </p>
          <a
            href="/actualites/categories/tribune-libre"
            class="inline-flex items-center bg-white text-gray-900 hover:bg-gray-100 font-bold py-3 px-6 rounded-lg transition-all group"
          >
            Lire toutes les tribunes
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 ml-2 transform transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

        <div class="p-8 bg-gray-50">
          <div class="space-y-6">
            {
              tribuneArticles?.slice(0, 2).map((news) => (
                <article class="group cursor-pointer">
                  <a href={news.url}>
                    <div class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-all">
                      <div class="flex items-start space-x-4">
                        <img
                          src={
                            news.image ||
                            "https://placehold.co/800x600?text=Y+EN+MARRE"
                          }
                          alt="Article"
                          class="w-12 h-12 rounded-full object-cover"
                        />
                        <div class="flex-1">
                          <h4
                            class="font-medium text-gray-800 line-clamp-1"
                            set:html={news.title}
                          />
                          <p class="text-sm text-gray-500 mb-2">
                            {new Date(news.date).toLocaleDateString("fr-FR")} •{" "}
                            {news.category}
                          </p>
                          <p
                            class="text-gray-600 text-sm line-clamp-2"
                            set:html={
                              news.excerpt.slice(0, 100) +
                              (news.excerpt.length > 150 ? "..." : "")
                            }
                          />
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))
            }

            {
              (!tribuneArticles || tribuneArticles.length === 0) && (
                <div class="text-center py-8">
                  <p class="text-gray-500">
                    Aucun article de tribune libre disponible pour le moment.
                  </p>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
