---
export interface TimelineItem {
  year: string;
  title: string;
  description: string;
}

export interface Props {
  items: TimelineItem[];
  accentColor?: string;
  textColor?: string;
}

const { items, accentColor = "bg-yam-red", textColor = "text-yam-red" } = Astro.props;
---

<div class="relative">
  <!-- Vertical line -->
  <div class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 h-full w-1 bg-gray-200"></div>
  
  <div class="space-y-12">
    {items.map((item, index) => (
      <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
        <!-- Timeline dot -->
        <div class="absolute left-0 md:left-1/2 transform -translate-x-1/2 w-6 h-6 rounded-full border-4 border-white shadow-md z-10" class:list={[accentColor]}></div>
        
        <!-- Content -->
        <div class="md:w-1/2 pl-10 md:pl-0 md:pr-12 md:text-right">
          <div class={`inline-block px-3 py-1 rounded-full text-sm font-bold mb-2 ${accentColor} text-white`}>
            {item.year}
          </div>
          <h3 class="text-xl font-bold mb-2" class:list={[textColor]}>{item.title}</h3>
          <p class="text-gray-600">{item.description}</p>
        </div>
        
        <!-- Spacer for alternate layout -->
        <div class="hidden md:block md:w-1/2"></div>
      </div>
    ))}
  </div>
</div>