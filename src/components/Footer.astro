---
import { getSiteSettings, field } from "../utils/wp";
import { getMenu } from "../utils/wp-menus";

export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

// Réglages globaux éditables dans WordPress (page « Réglages du site »).
const settings = await getSiteSettings();
const facebookUrl = field(settings, "reseau_facebook", "#");
const xUrl = field(settings, "reseau_x", "https://x.com/yenamarre_nts?s=21&t=mFXqvOy5agR8QxDPpKZo5Q");
const instagramUrl = field(settings, "reseau_instagram", "https://www.instagram.com/yem_nts?utm_source=qr");
const youtubeUrl = field(settings, "reseau_youtube", "https://www.youtube.com/channel/UCWkHjPJOt6K7kKyQ7kw5CwQ");

// Menus du footer éditables dans WordPress (Apparence › Éditeur › Navigation).
const liensRapides = await getMenu("footer-liens-rapides");
const nosProjets = await getMenu("footer-nos-projets");
const liensLegaux = await getMenu("footer-liens-legaux");

// Determine project-specific styling
let projectLogo = "https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp";
let projectName = "Y'EN A MARRE";
let projectDescription = field(settings, "footer_description", "Y'EN A MARRE est un mouvement citoyen sénégalais créé en 2011, en réponse à la frustration liée à la mauvaise gouvernance, à la corruption et aux coupures d'électricité fréquentes.");
let hoverColor = "hover:text-yam-red";
let bgColor = "bg-yam-red";
let btnHoverColor = "hover:bg-red-700";

if (currentPath.startsWith("/karibu")) {
  projectLogo = "https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-karibu-fkSP6Sl0AUSZtdNJdL0POuaoH1uL4F.png";
  projectName = "Karibu";
  projectDescription = "Karibu est une initiative qui vise à promouvoir l'engagement artistique et citoyen à travers des résidences culturelles, des mobilités citoyennes et des projets éducatifs.";
  hoverColor = "hover:text-karibu-green";
  bgColor = "bg-karibu-green";
  btnHoverColor = "hover:bg-green-700";
} else if (currentPath.startsWith("/ltc")) {
  projectLogo = "https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-ltc-8W4L2tgdjU72mMqlBWEQghrV3Vj7Z1.png";
  projectName = "La Télé Citoyenne (LTC)";
  projectDescription = "La Télé Citoyenne (LTC) est un média alternatif créé par Y'EN A MARRE pour diffuser ses messages et promouvoir l'engagement citoyen à travers des programmes télévisés et des contenus numériques.";
  hoverColor = "hover:text-white";
  bgColor = "bg-black";
  btnHoverColor = "hover:bg-gray-800";
}
---

<footer class="bg-black text-white">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Logo and About -->
      <div class="space-y-4">
        <img 
          src={projectLogo || "/placeholder.svg"}
          alt={`${projectName} Logo`}
          class="h-16"
        />
        <p class="text-sm">
          {projectDescription}
        </p>
        <div class="flex space-x-4">
          <a href={facebookUrl} target="_blank" aria-label="Facebook" class={`text-white ${hoverColor}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
            </svg>
          </a>
          <a href={xUrl} target="_blank" aria-label="Twitter" class={`text-white ${hoverColor}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
            </svg>
          </a>
          <a href={instagramUrl} target="_blank" aria-label="Instagram" class={`text-white ${hoverColor}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={youtubeUrl} target="_blank" aria-label="YouTube" class={`text-white ${hoverColor}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-bold mb-4">Liens Rapides</h3>
        <ul class="space-y-2">
          {liensRapides.map((item) => (
            <li><a href={item.url} target={item.externe ? "_blank" : undefined} class={hoverColor}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Projects -->
      <div>
        <h3 class="text-lg font-bold mb-4">Nos Projets</h3>
        <ul class="space-y-2">
          {nosProjets.map((item) => (
            <li><a href={item.url} target={item.externe ? "_blank" : undefined} class={hoverColor}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-lg font-bold mb-4">Newsletter</h3>
        <p class="text-sm mb-4">Inscrivez-vous pour recevoir nos dernières actualités</p>
        <form class="space-y-2">
          <div>
            <input 
              type="email" 
              placeholder="Votre email" 
              class="w-full px-4 py-2 rounded bg-gray-800 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-opacity-50"
              required
            />
          </div>
          <button type="submit" class={`w-full ${bgColor} ${btnHoverColor} text-white font-bold py-2 px-4 rounded transition-colors`}>
            S'inscrire
          </button>
        </form>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-6 text-sm text-center md:flex md:justify-between md:text-left">
      <p>&copy; {new Date().getFullYear()} {projectName}. Tous droits réservés.</p>
      <div class="mt-4 md:mt-0 space-x-4">
        {liensLegaux.map((item) => (
          <a href={item.url} target={item.externe ? "_blank" : undefined} class={hoverColor}>{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>