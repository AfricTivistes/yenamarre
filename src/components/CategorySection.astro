
---
export interface CategoryNews {
  id: number;
  title: string;
  excerpt: string;
  date: string;
  category: string;
  image: string;
  url: string;
}

export interface CategoryConfig {
  name: string;
  slug: string;
  color: string;
  bgGradient: string;
  icon: string;
  description: string;
  news: CategoryNews[];
}

export interface Props {
  categories: CategoryConfig[];
}

const { categories } = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Nos actualités par catégorie</h2>
      <p class="text-xl text-gray-600">
        Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {categories.map((category) => (
        <div class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 border border-gray-100">
          <div class={`h-32 ${category.bgGradient} relative overflow-hidden`}>
            <div class="absolute top-4 left-4">
              <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <Fragment set:html={category.icon} />
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class={`text-xl font-bold mb-3 group-hover:${category.color} transition-colors`}>
              {category.name}
            </h3>
            <p class="text-gray-600 mb-4">{category.description}</p>
            <div class="space-y-3 mb-6">
              {category.news.slice(0, 2).map((news) => (
                <div class="text-sm">
                  <h4 class="font-medium text-gray-800 line-clamp-1" set:html={news.title}></h4>
                  <p class="text-gray-500 text-xs">{new Date(news.date).toLocaleDateString('fr-FR')}</p>
                </div>
              ))}
            </div>
            <a href={`/actualites/${category.slug}`} class={`${category.color} font-medium group-hover:underline flex items-center`}>
              Voir tous les {category.name.toLowerCase()}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
