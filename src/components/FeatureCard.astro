---
export interface Props {
  icon: string;
  title: string;
  description: string;
  color?: string;
  url?: string;
  buttonText?: string;
}

const { icon, title, description, color = "yam-red", url, buttonText } = Astro.props;

// Map des icônes
const iconMap: Record<string, string> = {
