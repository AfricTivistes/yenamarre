---

<div class="text-center p-8 border-t-4 rounded-lg bg-white shadow-lg hover:shadow-xl transition-all hover:-translate-y-2 duration-300" class:list={[`border-${color}`]}>
  <div class="rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6" class:list={[`bg-${color}`]}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={iconMap[icon]}></svg>
  </div>
  <h3 class="text-2xl font-bold mb-4">{title}</h3>
  <p class="text-gray-600 mb-6">
    {description}
  </p>
  {url && buttonText && (
    <a href={url} class="inline-flex items-center font-medium hover:underline" class:list={[`text-${color}`]}>
      {buttonText}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  )}
</div>