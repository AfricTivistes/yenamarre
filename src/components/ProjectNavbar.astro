---
export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

// Determine which project we're in
const isLTC = currentPath.startsWith("/ltc");
const isKaribu = currentPath.startsWith("/karibu");

// Show project-specific colored banner only
let projectName = "";
let projectColor = "";
let projectBg = "";

if (isLTC) {
  projectName = "La Télé Citoyenne (LTC)";
  projectColor = "text-white";
  projectBg = "bg-black";
} else if (isKaribu) {
  projectName = "Karibu";
  projectColor = "text-white";
  projectBg = "bg-karibu-green";
}
---

{(isLTC || isKaribu) && (
  <div class={`${projectBg} border-b border-opacity-20 border-white`}>
    <div class="container-custom">
      <div class="py-3 text-center">
        <h2 class={`text-lg font-bold ${projectColor}`}>
          {projectName}
        </h2>
      </div>
    </div>
  </div>
)}

