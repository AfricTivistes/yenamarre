

---
export interface Props {
  currentPage: number;
  totalPages: number;
  startIndex: number;
  endIndex: number;
  totalArticles: number;
  basePath?: string;
}

const { 
  currentPage, 
  totalPages, 
  startIndex, 
  endIndex, 
  totalArticles, 
  basePath = "/actualites" 
} = Astro.props;

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);

// Generate URL with page parameter
function getPageUrl(page: number): string {
  return `${basePath}/${page}`;
}
---

<div class="flex flex-col md:flex-row items-center justify-between">
  <div class="text-gray-600 mb-4 md:mb-0">
    Affichage de {startIndex + 1} à {Math.min(endIndex, totalArticles)} sur {totalArticles} articles
  </div>

  <div class="flex items-center space-x-2">
    {currentPage > 1 ? (
      <a
        href={getPageUrl(currentPage - 1)}
        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors"
      >
        Précédent
      </a>
    ) : (
      <button
        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 opacity-50 cursor-not-allowed"
        disabled
      >
        Précédent
      </button>
    )}

    {pages.map((page) => (
      page === currentPage ? (
        <span class="px-4 py-2 bg-yam-red text-white rounded-lg">
          {page}
        </span>
      ) : (
        <a
          href={getPageUrl(page)}
          class="px-4 py-2 border border-gray-300 text-gray-600 hover:bg-gray-50 rounded-lg transition-colors"
        >
          {page}
        </a>
      )
    ))}

    {currentPage < totalPages ? (
      <a
        href={getPageUrl(currentPage + 1)}
        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors"
      >
        Suivant
      </a>
    ) : (
      <button
        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 opacity-50 cursor-not-allowed"
        disabled
      >
        Suivant
      </button>
    )}
  </div>
</div>

