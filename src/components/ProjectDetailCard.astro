
---
export interface Props {
  title: string;
  description: string;
  logo: string;
  features: Array<{ icon: string; text: string }>;
  bgGradient: string;
  buttonColor: string;
  buttonHoverColor: string;
  url: string;
}

const { title, description, logo, features, bgGradient, buttonColor, buttonHoverColor, url } = Astro.props;
---

<div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
  <div class={`relative h-64 ${bgGradient}`}>
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=400&width=600')] bg-cover bg-center opacity-20"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <img 
        src={logo} 
        alt={title} 
        class="w-32 h-32 object-contain"
      />
    </div>
  </div>
  <div class="p-8">
    <h3 class="text-2xl font-bold text-gray-900 mb-4">{title}</h3>
    <p class="text-gray-600 mb-6 leading-relaxed">
      {description}
    </p>

    <div class="space-y-3 mb-6">
      {features.map((feature) => (
        <div class="flex items-center text-sm text-gray-600">
          <Fragment set:html={feature.icon} />
          <span>{feature.text}</span>
        </div>
      ))}
    </div>

    <a href={url} class={`inline-flex items-center ${buttonColor} text-white ${buttonHoverColor} font-bold py-3 px-6 rounded-lg transition-all transform hover:scale-105`}>
      Découvrir {title}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>
