---
export interface Props {
  currentPath?: string
}

const { currentPath = "" } = Astro.props

// Determine project-specific styling
let primaryColor = "text-gray-900";
let buttonClass = "bg-yam-red text-white hover:bg-red-700";
let projectName = "";
let projectMenuItems = [];

if (currentPath.startsWith("/karibu")) {
  projectName = "Karibu";
  projectMenuItems = [
    { name: "Hospitalité", path: "/karibu/hospitalite" },
    { name: "Mobilités citoyenne", path: "/karibu/mobilites" },
    { name: "Production de savoir", path: "/karibu/production-savoir" },
  ];
} else if (currentPath.startsWith("/ltc")) {
  projectName = "LTC";
  projectMenuItems = [
    { name: "À propos de LTC", path: "/ltc/a-propos" },
    { name: "Programmes", path: "/ltc/programmes" },
    { name: "Jeunes Reporters Citoyens", path: "/ltc/jeunes-reporters-citoyens" },
    { name: "Reportages/Productions", path: "/ltc/productions" },
    { name: "Services", path: "/ltc/services" },
  ];
}

const isActive = (path: string) => {
  return currentPath.startsWith(path) ? "font-bold text-yam-red" : "";
}

const isProjectPage = currentPath.startsWith("/karibu") || currentPath.startsWith("/ltc");
---

<div id="mobile-menu" class="md:hidden hidden bg-white border-t shadow-lg fixed top-[72px] left-0 right-0 h-[calc(100vh-72px)] z-40 overflow-y-auto">
  <div class="p-4">
    <nav class="flex flex-col space-y-4">
      <!-- Main Navigation -->
      <div class="pb-4 border-b border-gray-200">
        <h3 class="text-sm uppercase text-gray-500 font-semibold mb-3">Navigation principale</h3>
        <div class="space-y-3">
          <a href="/" class={`block px-3 py-2 rounded-lg ${isActive("/")} hover:bg-gray-100 hover:text-yam-red`}>
            Accueil
          </a>
          
          <a href="/yenamarre" class={`block px-3 py-2 rounded-lg ${isActive("/yenamarre")} hover:bg-gray-100 hover:text-yam-red`}>
            À propos
          </a>
          
          <!-- Projets avec sous-menu -->
          <div class="space-y-2">
            <div class={`px-3 py-2 ${isActive("/projets")} font-semibold`}>Projets</div>
            <div class="ml-4 space-y-2 border-l-2 border-gray-200 pl-2">
              <a href="/ltc" class={`block px-3 py-2 rounded-lg ${isActive("/ltc")} hover:bg-gray-100 hover:text-yam-red flex items-center`}>
                <span class="w-5 h-5 mr-2">
                  <img src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-ltc-8W4L2tgdjU72mMqlBWEQghrV3Vj7Z1.png" alt="LTC" class="w-full h-full object-contain" />
                </span>
                Lead The Change (LTC)
              </a>
              <a href="/karibu" class={`block px-3 py-2 rounded-lg ${isActive("/karibu")} hover:bg-gray-100 hover:text-karibu-green flex items-center`}>
                <span class="w-5 h-5 mr-2">
                  <img src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-karibu-fkSP6Sl0AUSZtdNJdL0POuaoH1uL4F.png" alt="Karibu" class="w-full h-full object-contain" />
                </span>
                Karibu
              </a>
            </div>
          </div>
          
          <a href="/actualites" class={`block px-3 py-2 rounded-lg ${isActive("/actualites")} hover:bg-gray-100 hover:text-yam-red`}>
            Actualités
          </a>
          
          <a href="/contact" class={`block px-3 py-2 rounded-lg ${isActive("/contact")} hover:bg-gray-100 hover:text-yam-red`}>
            Contact
          </a>
        </div>
      </div>
      
      <!-- Project-specific Navigation (only shown on project pages) -->
      {isProjectPage && (
        <div class="py-4 border-b border-gray-200">
          <h3 class="text-sm uppercase text-gray-500 font-semibold mb-3">Navigation {projectName}</h3>
          <div class="space-y-3">
            {projectMenuItems.map((item) => (
              <a href={item.path} class={`block px-3 py-2 rounded-lg ${isActive(item.path)} hover:bg-gray-100 hover:text-yam-red`}>
                {item.name}
              </a>
            ))}
          </div>
        </div>
      )}
      
      <!-- Call to Action -->
      <div class="pt-4">
        <a href="/rejoindre" class={`block text-center py-3 px-4 rounded-lg ${buttonClass} font-bold`}>
          Rejoindre
        </a>
      </div>
      
      <!-- Social Links -->
      <div class="pt-4 flex justify-center space-x-4">
        <a href="#" aria-label="Facebook" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </a>
        <a href="#" aria-label="Twitter" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
          </svg>
        </a>
        <a href="#" aria-label="Instagram" class="bg-gray-100 hover:bg-gray-200 p-3 rounded-full transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
      
      <!-- Close Button -->
      <button id="close-mobile-menu" class="mt-4 w-full flex items-center justify-center py-3 text-gray-500 hover:text-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Fermer le menu
      </button>
    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const closeButton = document.getElementById('close-mobile-menu');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (closeButton && mobileMenu) {
      closeButton.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    }
  });
</script>