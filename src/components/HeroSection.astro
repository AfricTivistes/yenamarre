
---
import { getActiveHero } from '../utils/cms';
import { getPageAcf, field } from '../utils/wp';

export interface Props {
  title: string;
  highlightedText: string;
  description: string;
  backgroundImage: string;
  ctaText?: string;
  ctaUrl?: string;
  showWaveDivider?: boolean;
  page?: string;
}

const props = Astro.props;

// Page WordPress portant le groupe ACF « Hero » pour chaque page Astro.
const WP_HERO_PAGES: Record<string, string> = { index: 'home' };

// 1. Hero WordPress (si activé), 2. héros Decap CMS actif, 3. props.
const wpSlug = props.page ? WP_HERO_PAGES[props.page] : undefined;
const wp = wpSlug ? await getPageAcf(wpSlug) : {};
const wpActif = wp.hero_actif === true || wp.hero_actif === 1 || wp.hero_actif === '1';

// Vérifier s'il y a un héros personnalisé actif pour cette page
const customHero = !wpActif && props.page ? getActiveHero(props.page) : null;

// Utiliser les données du CMS si disponibles, sinon utiliser les props
const base = {
  title: customHero?.title || props.title,
  highlightedText: customHero?.highlightedText || props.highlightedText,
  description: customHero?.description || props.description,
  backgroundImage: customHero?.backgroundImage || props.backgroundImage,
  ctaText: customHero?.ctaText || props.ctaText || "En savoir plus",
  ctaUrl: customHero?.ctaUrl || props.ctaUrl || "/yenamarre",
  showWaveDivider: customHero?.showWaveDivider !== undefined ? customHero.showWaveDivider : (props.showWaveDivider ?? true),
};
const w = wpActif ? wp : {};
const title = field(w, 'hero_titre', base.title);
const highlightedText = field(w, 'hero_texte_surligne', base.highlightedText);
const description = field(w, 'hero_description', base.description);
const backgroundImage = field(w, 'hero_image', field(w, 'hero_image_url', base.backgroundImage));
const ctaText = field(w, 'hero_cta_texte', base.ctaText);
const ctaUrl = field(w, 'hero_cta_url', base.ctaUrl);
const showWaveDivider = wpActif && w.hero_vague != null ? Boolean(w.hero_vague) : base.showWaveDivider;
---

<section class="relative min-h-[90vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
  <!-- Image d'arrière-plan -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style={`background-image: url('${backgroundImage}');`}></div>

  <!-- Overlay sombre pour la lisibilité -->
  <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-black/60"></div>

  <!-- Overlay pattern -->
  <div class="absolute inset-0 opacity-5 bg-[url('/images/groupe.webp')] bg-repeat"></div>

  <!-- Content -->
  <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="text-white space-y-6">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          {title} <span class="text-yam-red">{highlightedText}</span>
        </h1>

        <p class="text-xl md:text-2xl text-gray-300 mt-6">
          {description}
        </p>

        <div class="flex flex-wrap gap-4 mt-8">
          <a 
            href={ctaUrl} 
            class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30"
          >
            {ctaText}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  {showWaveDivider && (
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  )}
</section>
