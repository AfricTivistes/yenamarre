
---
import { parseStat } from "../utils/stats";

export interface StatItem {
  number: string;
  label: string;
  description?: string;
}

export interface Props {
  stats: StatItem[];
  accentColor?: string;
  title?: string;
  subtitle?: string;
}

const { stats, accentColor = "yam-red", title, subtitle } = Astro.props;
---

<section class="py-16 bg-gray-50">
  <div class="container-custom">
    {title && (
      <div class="text-center mb-12">
        <h2 class={`text-4xl font-bold mb-4 text-${accentColor}`}>{title}</h2>
        {subtitle && (
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">{subtitle}</p>
        )}
      </div>
    )}
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
            {(() => {
              const chiffre = parseStat(stat.number);
              return (
                <div class={`text-4xl md:text-5xl font-bold text-${accentColor} mb-4 counter-animation`} data-count={chiffre.nombre ?? undefined} data-avant={chiffre.avant} data-apres={chiffre.apres}>
                  {chiffre.affichage}
                </div>
              );
            })()}
            <h3 class="text-lg font-bold text-gray-900 mb-2">{stat.label}</h3>
            {stat.description && (
              <p class="text-sm text-gray-600">{stat.description}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animation des compteurs : seule la partie numérique est animée, le texte
  // autour (« Plus de », « + »…) est conservé. Texte final rendu côté serveur.
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll<HTMLElement>('.counter-animation[data-count]');

    const animer = (el: HTMLElement) => {
      const cible = parseInt(el.dataset.count || '', 10);
      if (!Number.isFinite(cible) || cible <= 0) return;
      const avant = el.dataset.avant || '';
      const apres = el.dataset.apres || '';
      const duree = 2000;
      const debut = performance.now();
      const etape = (maintenant: number) => {
        const progression = Math.min((maintenant - debut) / duree, 1);
        const valeur = Math.round(cible * progression);
        el.textContent = `${avant}${valeur.toLocaleString('fr-FR')}${apres}`;
        if (progression < 1) requestAnimationFrame(etape);
      };
      requestAnimationFrame(etape);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animer(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    });

    counters.forEach((counter) => observer.observe(counter));
  });
</script>
