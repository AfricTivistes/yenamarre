
---
import CategoryCard from './CategoryCard.astro';

export interface CategoryData {
  name: string;
  slug: string;
  description: string;
  bgGradient: string;
  textColor: string;
  icon: string;
  news: {
    id: number;
    title: string;
    date: string;
  }[];
}

export interface Props {
  title?: string;
  subtitle?: string;
  categories: CategoryData[];
}

const { 
  title = "Nos actualités par catégorie",
  subtitle = "Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.",
  categories 
} = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">{title}</h2>
      <p class="text-xl text-gray-600">{subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {categories.map((category) => (
        <CategoryCard
          name={category.name}
          slug={category.slug}
          description={category.description}
          bgGradient={category.bgGradient}
          textColor={category.textColor}
          icon={category.icon}
          news={category.news}
        />
      ))}
    </div>

