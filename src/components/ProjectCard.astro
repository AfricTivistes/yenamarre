---
export interface Props {
  title: string;
  description: string;
  image: string;
  url: string;
  isExternal?: boolean;
}

const { title, description, image, url, isExternal = false } = Astro.props;
---

<a href={url} target={isExternal ? "_blank" : "_self"} class="block group">
  <div class="card bg-white/90 backdrop-blur-sm rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
    <div class="relative h-48 overflow-hidden bg-gray-100">
      <img 
        src={image || "/placeholder.svg"} 
        alt={title} 
        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
        <div class="p-4 w-full">
          <span class="text-white font-bold">En savoir plus</span>
        </div>
      </div>
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold mb-2 group-hover:text-yam-red transition-colors">{title}</h3>
      <p class="text-gray-600 mb-4">{description}</p>
      <div class="flex justify-end">
        <span class="text-yam-red font-medium group-hover:underline">Découvrir →</span>
      </div>
    </div>
  </div>
</a>