---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatsCounter from '../components/StatsCounter.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TribuneLibreSection from '../components/TribuneLibreSection.astro';
import CategoriesSection from '../components/CategoriesSection.astro';
import { getLiveCollection } from 'astro:content';

// Récupérer les articles WordPress
const { entries: allPosts, error } = await getLiveCollection('posts');
if (error) {
  console.error(`Error loading posts: ${error.message}`);
}

// Organiser les articles par catégorie
const newsByCategory = {
  'communique-de-presse': allPosts
    ? allPosts
      .filter(post =>
        post.data.category === 'Communiqué de presse' ||
        post.data.categories?.includes('Communiqué de presse')
      )
      .slice(0, 2)
      .map(post => ({
        id: post.data.id,
        title: post.data.title,
        date: post.data.date,
        slug: post.data.slug,
      }))
    : [],
  'yen-a-marre': allPosts
    ? allPosts
      .filter(post =>
        post.data.category === "Y'EN A MARRE" ||
        post.data.categories?.includes("Y'EN A MARRE")
      )
      .slice(0, 2)
      .map(post => ({
        id: post.data.id,
        title: post.data.title,
        date: post.data.date,
        slug: post.data.slug,
      }))
    : [],
  'dox-ak-sa-gox': allPosts
    ? allPosts
      .filter(post =>
        post.data.category === 'Dox Ak Sa Gox' ||
        post.data.categories?.includes('Dox Ak Sa Gox')
      )
      .slice(0, 2)
      .map(post => ({
        id: post.data.id,
        title: post.data.title,
        date: post.data.date,
        slug: post.data.slug,
      }))
    : [],
  'tribune-libre': allPosts
    ? allPosts
      .filter(post =>
        post.data.category === 'Tribune libre' ||
        post.data.categories?.includes('Tribune libre')
      )
      .slice(0, 2)
      .map(post => ({
        id: post.data.id,
        title: post.data.title,
        excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
        date: post.data.date,
        category: post.data.category,
        categories: post.data.categories || [],
        image: post.data.image,
        url: `/actualites/${post.data.slug}`,
      }))
    : [],
};

// Articles récents pour la section actualités
const recentNews = allPosts
  ? allPosts
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
    .slice(0, 3)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      categories: post.data.categories || [],
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    }))
  : [];
---

<MainLayout title="Y'EN A MARRE - Mouvement citoyen sénégalais" currentPath="/">
  <!-- Hero Section avec design moderne -->
  <section class="relative min-h-[90vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Image d'arrière-plan -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/rassemblement1.webp');"></div>

    <!-- Overlay sombre pour la lisibilité -->
    <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-black/60"></div>

    <!-- Overlay pattern -->
    <div class="absolute inset-0 opacity-5 bg-[url('/images/groupe.webp')] bg-repeat"></div>

    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-6">


          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Il n'y a pas de destin forclos, il n'y a que des  <span class="text-yam-red">responsabilités désertées.</span>
          </h1>

          <p class="text-xl md:text-2xl text-gray-300 mt-6">
            Un mouvement citoyen qui lutte pour la démocratie, la bonne gouvernance et l'engagement civique depuis 2011.
          </p>

          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/rejoindre" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30">
              Rejoignez le mouvement
            </a>
            <a href="/yenamarre" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
              En savoir plus
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Services Section inspiré du design Sandbox -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Notre mission</h2>
        <p class="text-xl text-gray-700">
          Nous luttons pour un Sénégal où tous les citoyens peuvent jouir pleinement de leurs droits et participer activement à la construction d'une société démocratique et juste.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard
          icon="scale-balanced"
          title="Démocratie"
          description="Nous promouvons les valeurs démocratiques et la participation citoyenne pour construire un Sénégal plus juste."
          color="yam-red"
        />

        <FeatureCard
          icon="users"
          title="Engagement civique"
          description="Nous encourageons les citoyens, en particulier les jeunes, à s'engager activement dans la vie politique et sociale."
          color="yam-red"
        />

        <FeatureCard
          icon="building-government"
          title="Bonne gouvernance"
          description="Nous luttons contre la corruption et promouvons la transparence et la responsabilité dans la gestion des affaires publiques."
          color="yam-red"
        />
      </div>
    </div>
  </section>

  <!-- Statistiques avec design moderne -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/yem1.webp')] opacity-5"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Notre impact</h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Depuis notre création, nous avons mobilisé des milliers de citoyens et mené des dizaines de campagnes pour promouvoir la démocratie et la bonne gouvernance au Sénégal.
