---
import MainLayout from '../layouts/MainLayout.astro';
import ScrollAnimation from '../components/ScrollAnimation.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatsCounter from '../components/StatsCounter.astro';
---

<MainLayout title="Y'EN A MARRE - Mouvement citoyen sénégalais" currentPath="/">
  <!-- Hero Section avec design moderne -->
  <section class="relative min-h-[90vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Image d'arrière-plan -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1573152958734-1922c188fba3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');"></div>
    
    <!-- Overlay sombre pour la lisibilité -->
    <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-black/60"></div>
    
    <!-- Overlay pattern -->
    <div class="absolute inset-0 opacity-5 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>

    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-6">
          <div class="mb-8">
            <img 
              src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp" 
              alt="Y'EN A MARRE Logo" 
              class="w-48 md:w-64 mb-6"
            />
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Nous apportons des solutions <span class="text-yam-red">pour un Sénégal meilleur</span>
          </h1>

          <p class="text-xl md:text-2xl text-gray-300 mt-6">
            Un mouvement citoyen qui lutte pour la démocratie, la bonne gouvernance et l'engagement civique depuis 2011.
          </p>

          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/rejoindre" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30">
              Rejoignez le mouvement
            </a>
            <a href="/a-propos/yenamarre" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
              En savoir plus
            </a>
          </div>
        </div>

        <div class="hidden md:block relative">
          <div class="relative rounded-lg overflow-hidden shadow-2xl">
            <img 
              src="/placeholder.svg?height=600&width=800&query=African youth protest movement with signs and flags in Senegal" 
              alt="Y'EN A MARRE en action" 
              class="w-full h-auto rounded-lg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>
          <div class="absolute -bottom-4 -right-4 bg-yam-red text-white px-6 py-3 rounded-lg font-bold shadow-lg">
            Depuis 2011
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Services Section inspiré du design Sandbox -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Notre mission</h2>
        <p class="text-xl text-gray-700">
          Nous luttons pour un Sénégal où tous les citoyens peuvent jouir pleinement de leurs droits et participer activement à la construction d'une société démocratique et juste.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard 
          icon="scale-balanced"
          title="Démocratie"
          description="Nous promouvons les valeurs démocratiques et la participation citoyenne pour construire un Sénégal plus juste."
          color="yam-red"
        />

        <FeatureCard 
          icon="users"
          title="Engagement civique"
          description="Nous encourageons les citoyens, en particulier les jeunes, à s'engager activement dans la vie politique et sociale."
          color="yam-red"
        />

        <FeatureCard 
          icon="building-government"
          title="Bonne gouvernance"
          description="Nous luttons contre la corruption et promouvons la transparence et la responsabilité dans la gestion des affaires publiques."
          color="yam-red"
        />
      </div>
    </div>
  </section>

  <!-- Statistiques avec design moderne -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] opacity-5"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Notre impact</h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Depuis notre création, nous avons mobilisé des milliers de citoyens et mené des dizaines de campagnes pour promouvoir la démocratie et la bonne gouvernance au Sénégal.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <StatsCounter number="12" label="Années d'activisme" color="yam-red" />
        <StatsCounter number="50" label="Campagnes menées" color="yam-red" />
        <StatsCounter number="100000" label="Citoyens mobilisés" color="yam-red" />
        <StatsCounter number="14" label="Régions touchées" color="yam-red" />
      </div>
    </div>
  </section>

  <!-- Nos projets avec design moderne -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-4">Nos projets</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez les différentes initiatives de Y'EN A MARRE pour promouvoir la démocratie, la bonne gouvernance et l'engagement civique.
          </p>
        </div>
        <a href="/projets" class="text-yam-red font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center">
          Voir tous les projets
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <ProjectCard 
          title="Y'EN A MARRE" 
          description="Le mouvement principal qui promeut la démocratie et la bonne gouvernance au Sénégal."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp"
          url="/yenamarre"
        />

        <ProjectCard 
          title="Lead The Change (LTC)" 
          description="La Télé Citoyenne, un média alternatif pour diffuser les messages du mouvement."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-ltc-8W4L2tgdjU72mMqlBWEQghrV3Vj7Z1.png"
          url="/ltc"
        />

        <ProjectCard 
          title="Karibu" 
          description="Résidences artistiques et mobilités citoyennes pour promouvoir l'engagement artistique et citoyen."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-karibu-fkSP6Sl0AUSZtdNJdL0POuaoH1uL4F.png"
          url="/karibu"
        />
      </div>
    </div>
  </section>

  <!-- Appel à l'action avec design moderne -->
  <section class="py-16 bg-yam-red text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] opacity-10"></div>
    <div class="container-custom text-center relative z-10">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Passez à l'action maintenant</h2>
      <p class="text-xl max-w-3xl mx-auto mb-8">
        Ensemble, nous pouvons faire la différence. Rejoignez Y'EN A MARRE pour promouvoir la démocratie, la bonne gouvernance et l'engagement civique au Sénégal.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/rejoindre" class="btn bg-white text-yam-red hover:bg-gray-100 font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg">
          Rejoignez-nous
        </a>
        <a href="/faire-un-don" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
          Faire un don
        </a>
      </div>
    </div>
  </section>

  <!-- Catégories d'actualités avec aperçus -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-50 to-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Nos actualités par catégorie</h2>
        <p class="text-xl text-gray-600">
          Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.
        </p>
      </div>

      <!-- Tribune libre - Section mise en avant -->
      <div class="mb-16">
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
          <!-- En-tête de catégorie -->
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
              <div class="w-16 h-16 bg-green-600 rounded-xl flex items-center justify-center text-2xl">
                💬
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold">Tribune libre</h3>
                <p class="text-gray-600 mt-1">Espace d'expression libre de nos membres et sympathisants</p>
              </div>
            </div>
            <a 
              href="/actualites/tribune-libre" 
              class="inline-flex items-center text-yam-red font-bold hover:underline group"
            >
              Voir tout
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          
          <!-- Articles de tribune libre -->
          <div class="grid md:grid-cols-2 gap-6">
            <article class="group">
              <a href="/actualites/tribune-jeunesse-engagee" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1529390079861-591de354faf5?w=400&h=300&fit=crop" 
                      alt="Pour une jeunesse engagée" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-06-05" class="text-sm text-gray-500">
                      5 juin 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Pour une jeunesse engagée
                    </h4>
                    <p class="text-gray-600 mb-4">Réflexion sur l'importance de l'engagement citoyen chez les jeunes sénégalais d'aujourd'hui.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>

            <article class="group">
              <a href="/actualites/democratie-digitalisation" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400&h=300&fit=crop" 
                      alt="Démocratie et digitalisation" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-05-28" class="text-sm text-gray-500">
                      28 mai 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Démocratie et digitalisation
                    </h4>
                    <p class="text-gray-600 mb-4">Comment les nouvelles technologies peuvent renforcer la participation citoyenne.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          </div>
        </div>
      </div>

      <!-- Autres catégories principales -->
      <div class="space-y-16 mb-16">
        <!-- Communiqués de presse -->
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
              <div class="w-16 h-16 bg-red-600 rounded-xl flex items-center justify-center text-2xl">
                📢
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold">Communiqués de presse</h3>
                <p class="text-gray-600 mt-1">Nos positions officielles et déclarations publiques</p>
              </div>
            </div>
            <a 
              href="/actualites/communiques-presse" 
              class="inline-flex items-center text-yam-red font-bold hover:underline group"
            >
              Voir tout
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6">
            <article class="group">
              <a href="/actualites/position-reformes-electorales" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1586339949916-3e9457bef6d3?w=400&h=300&fit=crop" 
                      alt="Position sur les réformes électorales" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-06-10" class="text-sm text-gray-500">
                      10 juin 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Position officielle sur les réformes électorales
                    </h4>
                    <p class="text-gray-600 mb-4">Y'EN A MARRE exprime sa position sur les récentes propositions de réformes du système électoral sénégalais.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>

            <article class="group">
              <a href="/actualites/appel-transparence-budgetaire" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=400&h=300&fit=crop" 
                      alt="Appel à la transparence budgétaire" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-05-28" class="text-sm text-gray-500">
                      28 mai 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Appel à la transparence budgétaire
                    </h4>
                    <p class="text-gray-600 mb-4">Le mouvement demande plus de transparence dans la gestion des finances publiques.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          </div>
        </div>

        <!-- YAM dans la presse -->
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
              <div class="w-16 h-16 bg-blue-600 rounded-xl flex items-center justify-center text-2xl">
                📰
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold">YAM dans la presse</h3>
                <p class="text-gray-600 mt-1">Notre couverture médiatique</p>
              </div>
            </div>
            <a 
              href="/actualites/yam-presse" 
              class="inline-flex items-center text-yam-red font-bold hover:underline group"
            >
              Voir tout
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6">
            <article class="group">
              <a href="/actualites/interview-quotidien" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=400&h=300&fit=crop" 
                      alt="Interview Le Quotidien" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-06-08" class="text-sm text-gray-500">
                      8 juin 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Y'EN A MARRE dans Le Quotidien
                    </h4>
                    <p class="text-gray-600 mb-4">Interview exclusive de nos dirigeants sur les enjeux démocratiques actuels.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>

            <article class="group">
              <a href="/actualites/reportage-rts" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=400&h=300&fit=crop" 
                      alt="Reportage RTS" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="p-6">
                    <time datetime="2023-05-25" class="text-sm text-gray-500">
                      25 mai 2023
                    </time>
                    <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                      Reportage RTS sur nos actions
                    </h4>
                    <p class="text-gray-600 mb-4">La télévision nationale couvre nos dernières initiatives citoyennes.</p>
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          </div>
        </div>

        <!-- Médias -->
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
              <div class="w-16 h-16 bg-purple-600 rounded-xl flex items-center justify-center text-2xl">
                🎥
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold">Médias</h3>
                <p class="text-gray-600 mt-1">Documentaires, photos et vidéos</p>
              </div>
            </div>
            <a 
              href="/actualites/medias" 
              class="inline-flex items-center text-yam-red font-bold hover:underline group"
            >
              Voir tout
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6">
            <article class="group">
              <a href="/actualites/documentaire-12-ans" class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                  <div class="relative h-48 overflow-hidden">
                    <img 
                      src="https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?w=400&h=300&fit=crop" 
                      alt="Documentaire 12 ans" 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
