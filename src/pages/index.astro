      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">


      <ProjectCard
        title="Dox ak Sa Gox"
        description="Marcher avec sa communauté pour bâtir une citoyenneté active et un contrôle citoyen fort."
