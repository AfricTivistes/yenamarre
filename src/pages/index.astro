  </section>

  <!-- Appel à l'action avec design moderne >
  <section class="py-16 bg-yam-red text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/groupe2.webp')] opacity-10"></div>
    <div class="container-custom text-center relative z-10">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Passez à l'action maintenant</h2>
      <p class="text-xl max-w-3xl mx-auto mb-8">
        Ensemble, nous pouvons faire la différence. Rejoignez Y'EN A MARRE pour promouvoir la démocratie, la bonne gouvernance et l'engagement civique au Sénégal.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/rejoindre" class="btn bg-white text-yam-red hover:bg-gray-100 font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg">
          Rejoignez-nous
        </a>
      </div>
    </div>
  </section-->



      <!-- Tribune libre - Section mise en avant -->
      <TribuneLibreSection tribuneArticles={newsByCategory['tribune-libre'] || []} />

      <!-- Utilisation du composant CategoriesSection -->
      <CategoriesSection
        title="Nos actualités par catégorie"
        subtitle="Explorez nos différents types de contenus pour rester informé de toutes nos activités."
        categories={[
          {
            name: "Communiqués de presse",
            slug: "communique-de-presse",
            description: "Positions officielles du mouvement",
            bgGradient: "bg-gradient-to-r from-yam-red to-red-600",
            textColor: "text-yam-red",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>`,
            news: newsByCategory['communique-de-presse'] || []
          },
          {
            name: "YAM dans la presse",
            slug: "yen-a-marre",
            description: "Couverture médiatique",
            bgGradient: "bg-gradient-to-r from-gray-600 to-gray-700",
            textColor: "text-gray-700",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 01-2-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>`,
            news: newsByCategory['yen-a-marre'] || []
          },
          {
            name: "Dox Ak Sa Gox",
            slug: "dox-ak-sa-gox",
            description: "Photos, vidéos et podcasts",
            bgGradient: "bg-gradient-to-r from-gray-500 to-gray-600",
            textColor: "text-gray-600",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>`,
            news: newsByCategory['dox-ak-sa-gox'] || []
          }
        ]}
      />
    </div>


  <!-- Actualités récentes avec design moderne -->
  <section class="py-16 md:py-24">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-4">Actualités récentes</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Restez informé des dernières activités et campagnes de Y'EN A MARRE.
          </p>
        </div>
        <a href="/actualites" class="text-yam-red font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center">
          Voir toutes les actualités
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {recentNews.map((article) => (
          <NewsCard
            title={article.title}
            excerpt={article.excerpt}
            date={article.date}
            category={article.category}
            categories={article.categories}
            image={article.image}
            url={article.url}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter avec design moderne -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/rassemblement2.webp')] opacity-5"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Restez informé</h2>
        <p class="text-lg mb-8">
          Inscrivez-vous à notre newsletter pour recevoir les dernières actualités et informations sur nos campagnes.
        </p>

        <form class="flex flex-col md:flex-row gap-4 bg-white/5 p-3 rounded-lg backdrop-blur-sm">
          <input
            type="email"
            placeholder="Votre adresse email"
            class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red text-black bg-white"
            required
          />
          <button
            type="submit"
            class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors transform hover:scale-105"
          >
            S'inscrire
          </button>
        </form>

        <p class="text-sm mt-4 text-gray-400">
          En vous inscrivant, vous acceptez de recevoir nos emails et confirmez avoir lu notre politique de confidentialité.
        </p>
      </div>
    </div>
  </section>
</MainLayout>

<script>
// Animation des compteurs
document.addEventListener('DOMContentLoaded', () => {
  const counters = document.querySelectorAll('.counter-item [data-count]');

  const animateCounter = (counter: HTMLElement, target: number) => {
    let currentValue = 0;
    const duration = 2000; // 2 secondes
    const stepTime = duration / target;

    const timer = setInterval(() => {
      currentValue += Math.ceil(target / 100);
      if (currentValue >= target) {
        currentValue = target;
        clearInterval(timer);
      }
      counter.textContent = currentValue.toLocaleString();
    }, stepTime);
  };

  // Observer pour déclencher l'animation
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counter = entry.target as HTMLElement;
        const countAttr = counter.getAttribute('data-count');
        if (countAttr) {
          const target = parseInt(countAttr);
          animateCounter(counter, target);
          observer.unobserve(counter);
        }
      }
    });
  });

  counters.forEach(counter => {
    observer.observe(counter);
  });
});
</script>