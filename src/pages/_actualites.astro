---
import MainLayout from '../layouts/MainLayout.astro';
import { getLiveCollection } from 'astro:content';


const { entries: allPosts, error } = await getLiveCollection('posts');
if (error) {
  console.error(`Error loading posts: ${error.message}`);
}


const featuredNews = allPosts.find(post => post.data.sticky);

// Recent news (sorted by date, limited to 6 for pagination)
const articlesPerPage = 6;
const currentPage = 1;
const recentNews = allPosts
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, articlesPerPage)
  .map(post => ({
    id: post.data.id,
    title: post.data.title,
    excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
    date: post.data.date,
    category: post.data.category,
    image: post.data.image,
    url: `/actualites/${post.data.slug}`,
  }));

// Pagination
const totalArticles = allPosts.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;
const paginatedNews = recentNews;

// News by category (adjust category names based on WordPress slugs)
const newsByCategory = {
  'communiques-presse': allPosts
    .filter(post => post.data.category === 'Communiqué de presse')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.slug}`,
    })),
  'yam-presse': allPosts
    .filter(post => post.data.category === 'YAM dans la presse')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.slug}`,
    })),
  'medias': allPosts
    .filter(post => post.data.category === 'Médias')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.slug}`,
    })),
  'tribune-libre': allPosts
    .filter(post => post.data.category === 'Tribune libre')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.slug}`,
    })),
};
---

<MainLayout title="Actualités - Y'EN A MARRE" currentPath="/actualites">
  <!-- Hero Section avec actualité à la une -->
  <section class="relative min-h-[80vh] bg-gray-900 overflow-hidden">
    <div class="absolute inset-0">
      <img 
        src={featuredNews.data.image || 'https://via.placeholder.com/800x600'} 
        alt={featuredNews.data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>
    </div>
    
    <div class="container-custom relative z-10 h-full flex items-center py-20">
      <div class="max-w-2xl text-white">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yam-red text-white mb-4">
          À la une
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          <a href={`/actualites/${featuredNews.data.slug}`}>
            {featuredNews.data.title}
          </a>
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-200 mb-8 leading-relaxed">
          {featuredNews.data.excerpt || featuredNews.data.content.slice(0, 150) + '...'}
        </p>
        
        <div class="flex flex-wrap items-center gap-6 mb-8">
          <time class="text-gray-300" datetime={featuredNews.data.date}>
            {featuredNews.data.formattedDate}
          </time>
          <span class="w-2 h-2 bg-yam-red rounded-full"></span>
          <span class="text-yam-red font-medium">{featuredNews.data.category}</span>
        </div>
        
        <a 
          href={`/actualites/${featuredNews.data.slug}`} 
          class="inline-flex items-center bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30 group"
        >
          Lire l'article complet
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Articles récents -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-6">Articles récents</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez nos dernières publications et prises de position.
          </p>
        </div>
        <a 
          href="/actualites/tous-les-articles" 
          class="text-yam-red font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center"
        >
          Voir tous les articles
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {paginatedNews.map((article) => (
          <article class="group">
            <a href={article.url} class="block">
              <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
                <div class="relative h-48 overflow-hidden">
                  <img 
                    src={article.image || 'https://via.placeholder.com/400x300'} 
                    alt={article.title} 
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yam-red text-white">
                      {article.category}
                    </span>
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                <div class="p-6">
                  <time datetime={article.date} class="text-sm text-gray-500">
                    {new Date(article.date).toLocaleDateString('fr-FR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  <h3 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors line-clamp-2">
                    {article.title}
                  </h3>
                  <p class="text-gray-600 mb-4 line-clamp-3">{article.excerpt}</p>
                  <div class="flex justify-end">
                    <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
      
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="text-gray-600 mb-4 md:mb-0">
          Affichage de {startIndex + 1} à {Math.min(endIndex, totalArticles)} sur {totalArticles} articles
        </div>
        
        <div class="flex items-center space-x-2">
          <button 
            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
            disabled={currentPage === 1}
          >
            Précédent
          </button>
          
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <button 
              class={`px-4 py-2 rounded-lg transition-colors ${
                page === currentPage 
                  ? 'bg-yam-red text-white' 
                  : 'border border-gray-300 text-gray-600 hover:bg-gray-50'
              }`}
            >
              {page}
            </button>
          ))}
          
          <button 
            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
            disabled={currentPage === totalPages}
          >
            Suivant
          </button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Tribune libre - Section mise en avant -->
  <section class="py-16 bg-gradient-to-br from-gray-50 to-white">
    <div class="container-custom">
      <div class="bg-white rounded-2xl overflow-hidden shadow-xl border border-gray-100">
        <div class="grid md:grid-cols-2 gap-0">
          <div class="bg-gradient-to-br from-gray-800 to-gray-900 text-white p-8 md:p-12 flex flex-col justify-center">
            <div class="flex items-center mb-6">
              <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                </svg>
              </div>
              <div>
                <h3 class="text-2xl md:text-3xl font-bold mb-2">Tribune libre</h3>
                <p class="text-gray-300">Espace d'expression citoyenne</p>
              </div>
            </div>
            <p class="text-lg text-gray-200 mb-6">
              Découvrez les réflexions et analyses de nos membres et sympathisants sur les enjeux démocratiques du Sénégal.
            </p>
            <a href="/actualites/tribune-libre" class="inline-flex items-center bg-white text-gray-900 hover:bg-gray-100 font-bold py-3 px-6 rounded-lg transition-all group">
              Lire toutes les tribunes
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="p-8 bg-gray-50">
            <div class="space-y-6">
              {newsByCategory['tribune-libre']?.slice(0, 2).map((news) => (
                <article class="group cursor-pointer">
                  <div class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-all">
                    <div class="flex items-start space-x-4">
                      <img src={news.image || 'https://via.placeholder.com/60'} alt="Auteur" class="w-12 h-12 rounded-full object-cover" />
                      <div class="flex-1">
                        <h4 class="font-bold text-lg mb-2 group-hover:text-gray-700">{news.title}</h4>
                        <p class="text-sm text-gray-500 mb-2">{new Date(news.date).toLocaleDateString('fr-FR')} • {news.category}</p>
                        <p class="text-gray-600 text-sm line-clamp-2">{news.excerpt}</p>
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Catégories d'actualités -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Nos actualités par catégorie</h2>
        <p class="text-xl text-gray-600">
          Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <div class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 border border-gray-100">
          <div class="h-32 bg-gradient-to-r from-yam-red to-red-600 relative overflow-hidden">
            <div class="absolute top-4 left-4">
              <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-yam-red transition-colors">Communiqués de presse</h3>
            <p class="text-gray-600 mb-4">Nos positions officielles et déclarations publiques</p>
            <div class="space-y-3 mb-6">
              {newsByCategory['communiques-presse']?.slice(0, 2).map((news) => (
                <div class="text-sm">
                  <h4 class="font-medium text-gray-800 line-clamp-1">{news.title}</h4>
                  <p class="text-gray-500 text-xs">{new Date(news.date).toLocaleDateString('fr-FR')}</p>
                </div>
              ))}
            </div>
            <a href="/actualites/communiques-presse" class="text-yam-red font-medium group-hover:underline flex items-center">
              Voir tous les communiqués
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 border border-gray-100">
          <div class="h-32 bg-gradient-to-r from-gray-600 to-gray-700 relative overflow-hidden">
            <div class="absolute top-4 left-4">
              <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 01-2-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-gray-700 transition-colors">YAM dans la presse</h3>
            <p class="text-gray-600 mb-4">Notre couverture médiatique nationale et internationale</p>
            <div class="space-y-3 mb-6">
              {newsByCategory['yam-presse']?.slice(0, 2).map((news) => (
                <div class="text-sm">
                  <h4 class="font-medium text-gray-800 line-clamp-1">{news.title}</h4>
                  <p class="text-gray-500 text-xs">{new Date(news.date).toLocaleDateString('fr-FR')}</p>
                </div>
              ))}
            </div>
            <a href="/actualites/yam-presse" class="text-gray-700 font-medium group-hover:underline flex items-center">
              Voir toute la couverture
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 border border-gray-100">
          <div class="h-32 bg-gradient-to-r from-gray-500 to-gray-600 relative overflow-hidden">
            <div class="absolute top-4 left-4">
              <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-gray-600 transition-colors">Médias</h3>
            <p class="text-gray-600 mb-4">Documentaires, photos, vidéos et podcasts</p>
            <div class="space-y-3 mb-6">
              {newsByCategory['medias']?.slice(0, 2).map((news) => (
                <div class="text-sm">
                  <h4 class="font-medium text-gray-800 line-clamp-1">{news.title}</h4>
                  <p class="text-gray-500 text-xs">{new Date(news.date).toLocaleDateString('fr-FR')}</p>
                </div>
              ))}
            </div>
            <a href="/actualites/medias" class="text-gray-600 font-medium group-hover:underline flex items-center">
              Découvrir les médias
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-xl p-8 border border-gray-100">
        <h4 class="text-xl font-bold mb-6 text-center text-gray-800">Autres contenus</h4>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/actualites/appels-offres" class="group block p-6 rounded-lg bg-white hover:bg-gray-50 transition-all border border-gray-100">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center group-hover:bg-gray-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6" />
                </svg>
              </div>
              <div>
                <h5 class="font-bold text-gray-800 mb-1">Appels d'offres</h5>
                <p class="text-gray-600 text-sm">Opportunités d'emploi et collaborations</p>
              </div>
            </div>
          </a>

          <a href="/actualites/archives" class="group block p-6 rounded-lg bg-white hover:bg-gray-50 transition-all border border-gray-100">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center group-hover:bg-gray-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </div>
              <div>
                <h5 class="font-bold text-gray-800 mb-1">Archives</h5>
                <p class="text-gray-600 text-sm">Historique de nos publications</p>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] opacity-5"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Restez informé</h2>
        <p class="text-lg mb-8">
          Inscrivez-vous à notre newsletter pour recevoir les dernières actualités et informations sur nos campagnes.
        </p>

        <form class="flex flex-col md:flex-row gap-4 bg-white/5 p-3 rounded-lg backdrop-blur-sm">
          <input 
            type="email" 
            placeholder="Votre adresse email" 
            class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red text-black bg-white"
            required
          />
          <button 
            type="submit" 
            class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors transform hover:scale-105"
          >
            S'inscrire
          </button>
        </form>

        <p class="text-sm mt-4 text-gray-400">
          En vous inscrivant, vous acceptez de recevoir nos emails et confirmez avoir lu notre politique de confidentialité.
        </p>
      </div>
    </div>
  </section>
</MainLayout>