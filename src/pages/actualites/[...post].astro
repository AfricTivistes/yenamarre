---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleSidebar from "../../components/ArticleSidebar.astro";
import SocialShare from "../../components/SocialShare.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import Gallery from "../../components/Gallery.astro";
import { getCollection, getEntry } from "astro:content";
import he from "he";
import { load } from "cheerio";



function formatDate(dateInput) {
  if (!dateInput) return "Date inconnue";
  const date = new Date(dateInput);
  if (isNaN(date.getTime())) return "Date invalide";
  return date.toLocaleDateString("fr-FR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}

function getISODate(dateInput) {
  if (!dateInput) return null;
  const date = new Date(dateInput);
  return isNaN(date.getTime()) ? null : date.toISOString().split("T")[0];
}


function getCategoryNames(categoryIds = [], categoryMap) {
  if (!Array.isArray(categoryIds) || categoryIds.length === 0)
    return ["Actualité"];
  return categoryIds
    .map((cat) => {
      const id = String(cat?.id ?? cat);
      return categoryMap.get(id) ?? null;
    })
    .filter(Boolean);
}


export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { post: post.data.slug },
    props: { post },
  }));
}


const { post } = Astro.props;
if (!post || !post.data?.date) return Astro.redirect("/actualites");


const allPosts = await getCollection("posts");
const allCategories = await getCollection("categories");

const categoryMap = new Map(
  allCategories.map((cat) => [
    String(cat.id ?? cat.data.slug),
    cat.data.name ?? cat.data.slug,
  ])
);


const currentPost = allPosts.find(
  (p) => p.data.slug === post.data.slug || String(p.id) === String(post.id)
);
if (!currentPost || !currentPost.data?.date)
  return Astro.redirect("/actualites");


const featuredImageEntry = currentPost.data.featured_media
  ? await getEntry(currentPost.data.featured_media)
  : null;


const $ = load(currentPost.data.content?.rendered || "");


const images = $("img")
  .map((i, el) => ({
    src: $(el).attr("src") || "",
    alt: $(el).attr("alt") || `Image ${i + 1}`,
    width: parseInt($(el).attr("width") || "1200", 10),
    height: parseInt($(el).attr("height") || "800", 10),
  }))
  .get()
  .filter((img) => img.src);


$("img").remove();


let htmlContent = $.html();
const youtubeRegex =
  /https?:\/\/(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/gi;
htmlContent = htmlContent.replace(youtubeRegex, (match, videoId) => {
  return `
    <div class="video-container my-8">
      <iframe 
        class="w-full aspect-video rounded-lg shadow-lg"
        src="https://www.youtube.com/embed/${videoId}"
        title="Vidéo YouTube"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen>
      </iframe>
    </div>`.trim();
});

function decodeAndStripHtml(html = "") {
  const stripped = html.replace(/<[^>]*>?/gm, "").trim();
  return he.decode(stripped);
}


const categoryNames = getCategoryNames(
  currentPost.data.categories,
  categoryMap
);
const primaryCategoryName = categoryNames[0] || "Actualité";

const formattedDate = formatDate(currentPost.data.date);
const isoDate = getISODate(currentPost.data.date);

const transformedPost = {
  id: String(currentPost.id),
  slug: currentPost.data.slug,
  title: currentPost.data.title?.rendered || "Article sans titre",
  date: isoDate,
  formattedDate,
  excerpt: currentPost.data.excerpt?.rendered
    ? decodeAndStripHtml(currentPost.data.excerpt.rendered)
    : "",
  image:
    featuredImageEntry?.data.source_url ||
    "https://placehold.co/1200x600?text=Y+EN+MARRE",
  category: primaryCategoryName,
  categories: categoryNames,
  content: htmlContent,
};


const relatedRaw = allPosts
  .filter((p) => {
    const pCategories = p.data.categories ?? [];
    const currentCategories = currentPost.data.categories ?? [];
    return (
      String(p.id) !== String(currentPost.id) &&
      p.data.slug !== currentPost.data.slug &&
      pCategories.some((cat) =>
        currentCategories.some((c) => String(c.id) === String(cat.id))
      )
    );
  })
  .slice(0, 3);

const relatedArticles = await Promise.all(
  relatedRaw.map(async (p) => {
    const imgEntry = p.data.featured_media
      ? await getEntry(p.data.featured_media)
      : null;

    const cats = getCategoryNames(p.data.categories, categoryMap);
    return {
      id: String(p.id),
      title: p.data.title?.rendered || "Sans titre",
      excerpt: p.data.excerpt?.rendered
        ? decodeAndStripHtml(p.data.excerpt.rendered)
        : "",
      image:
        imgEntry?.data.source_url ||
        "https://placehold.co/600x400?text=Article",
      category: cats[0] || "Actualité",
      categories: cats,
      date: getISODate(p.data.date),
      formattedDate: formatDate(p.data.date),
      url: `/actualites/${p.data.slug}`,
    };
  })
);

const recentRaw = allPosts
  .filter((p) => String(p.id) !== String(currentPost.id))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .slice(0, 5);

const recentArticles = await Promise.all(
  recentRaw.map(async (p) => {
    const imgEntry = p.data.featured_media
      ? await getEntry(p.data.featured_media)
      : null;

    const cats = getCategoryNames(p.data.categories, categoryMap);
    return {
      id: String(p.id),
      title: p.data.title?.rendered || "Sans titre",
      date: getISODate(p.data.date),
      formattedDate: formatDate(p.data.date),
      category: cats[0] || "Actualité",
      categories: cats,
      image:
        imgEntry?.data.source_url ||
        "https://placehold.co/300x200?text=Article",
      slug: p.data.slug,
    };
  })
);
---

<MainLayout
  title={`${transformedPost.title} - Y'EN A MARRE`}
  description={transformedPost.excerpt}
  image={transformedPost.image}
>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] bg-gray-900 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={transformedPost.image}
        alt={transformedPost.title}
        class="w-full h-full object-cover object-center"
        style="object-position: center 30%;"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/60"
      >
      </div>
    </div>

    <div class="container-custom relative z-10 h-full flex items-end py-20">
      <div class="max-w-4xl text-white">
        <!-- Breadcrumb multi-catégories -->
        <nav class="flex items-center space-x-2 text-sm mb-6">
          <a href="/" class="text-gray-300 hover:text-white">Accueil</a>
          <span class="text-gray-400">/</span>
          <a href="/actualites" class="text-gray-300 hover:text-white"
            >Actualités</a
          >
          <span class="text-gray-400">/</span>
          <span class="text-yam-red font-medium">
            {transformedPost.categories.join(" / ")}
          </span>
        </nav>

        <!-- Badges multi-catégories -->
        <div class="flex flex-wrap gap-2 mb-4">
          {
            transformedPost.categories.map((cat) => (
              <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yam-red text-white">
                {cat}
              </div>
            ))
          }
        </div>

        <h1
          class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight"
          set:html={transformedPost.title}
        >
          
        </h1>

        <div class="flex items-center gap-6 text-gray-200">
          <time datetime={transformedPost.date} class="flex items-center">
            <svg
              class="h-5 w-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {transformedPost.formattedDate}
          </time>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1440 120"
        class="w-full h-auto"
      >
        <path
          fill="#ffffff"
          fill-opacity="1"
          d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"
        ></path>
      </svg>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Contenu principal -->
          <div class="lg:col-span-2">
            <div
              class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-headings:font-montserrat prose-p:text-gray-700 prose-p:leading-relaxed prose-a:text-yam-red prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-blockquote:border-l-yam-red prose-blockquote:bg-gray-50 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:rounded-r-lg"
            >
              <div set:html={transformedPost.content} />
            </div>

            <!-- Galerie -->
            {
              images.length > 0 && (
                <div class="mt-12 -mx-4">
                  <Gallery images={images} />
                </div>
              )
            }

            <!-- Partage -->
            <div class="mt-12 pt-8 border-t border-gray-200">
              <SocialShare title={transformedPost.title} url={Astro.url} />
            </div>
          </div>

          <!-- Sidebar -->
          <ArticleSidebar
            articles={recentArticles}
            currentArticleId={transformedPost.id}
          />
        </div>
      </div>
    </div>
  </article>

  <!-- Articles similaires -->
  {relatedArticles.length > 0 && <RelatedArticles articles={relatedArticles} />}

  <!-- Style vidéo -->
  <style>
    .video-container {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      max-width: 100%;
    }
    .video-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
  </style>

  <!-- Retour -->
  <section class="py-12 bg-white">
    <div class="container-custom text-center">
      <a
        href="/actualites"
        class="inline-flex items-center bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-all hover:shadow-lg group"
      >
        <svg
          class="h-5 w-5 mr-2 transform transition-transform group-hover:-translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Retour aux actualités
      </a>
    </div>
  </section>
</MainLayout>
