
---
import MainLayout from '../../layouts/MainLayout.astro';
import { getLiveCollection } from 'astro:content';

export async function getStaticPaths() {
  const { entries: allPosts, error } = await getLiveCollection('posts');
  
  if (error) {
    console.error(`Error loading posts: ${error.message}`);
    return [];
  }

  return allPosts.map((post) => ({
    params: { 
      post: post.data.slug 
    },
    props: { 
      post 
    },
  }));
}

// Handle SSR mode - fetch the post dynamically if not in props
let post = Astro.props.post;

if (!post) {
  const slug = Astro.params.post;
  const { entries: allPosts, error } = await getLiveCollection('posts');
  
  if (error) {
    console.error(`Error loading posts: ${error.message}`);
    return Astro.redirect('/actualites');
  }
  
  post = allPosts.find(p => p.data.slug === slug);
  
  if (!post) {
    return Astro.redirect('/actualites');
  }
}

const { entries: allPosts } = await getLiveCollection('posts');
const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.data.id !== post.data.id)
  .slice(0, 3)
  .map(p => ({
    id: p.data.id,
    title: p.data.title,
    excerpt: p.data.excerpt || p.data.content.slice(0, 150) + '...',
    date: p.data.date,
    category: p.data.category,
    image: p.data.image,
    url: `/actualites/${p.data.slug}`,
  }));
---

<MainLayout title={`${post.data.title} - Y'EN A MARRE`} currentPath="/actualites">
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] bg-gray-900 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={post.data.image || 'https://via.placeholder.com/1200x600'}
        alt={post.data.title}
        class="w-full h-full object-cover object-center"
        style="object-position: center 30%;"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/60"></div>
    </div>

    <div class="container-custom relative z-10 h-full flex items-end py-20">
      <div class="max-w-4xl text-white">
        <nav class="flex items-center space-x-2 text-sm mb-6">
          <a href="/" class="text-gray-300 hover:text-white transition-colors">Accueil</a>
          <span class="text-gray-400">/</span>
          <a href="/actualites" class="text-gray-300 hover:text-white transition-colors">Actualités</a>
          <span class="text-gray-400">/</span>
          <span class="text-yam-red font-medium">{post.data.category}</span>
        </nav>

        <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yam-red text-white mb-4">
          {post.data.category}
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-6 text-gray-200">
          <time datetime={post.data.date} class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {post.data.formattedDate}
          </time>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
          
          <!-- Article principal -->
          <div class="lg:col-span-2">
            <!-- Article content -->
            <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-headings:font-montserrat prose-p:text-gray-700 prose-p:leading-relaxed prose-a:text-yam-red prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-blockquote:border-l-yam-red prose-blockquote:bg-gray-50 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:rounded-r-lg">
              <div set:html={post.data.content}></div>
            </div>

            <!-- Social sharing -->
            <div class="mt-12 pt-8 border-t border-gray-200">
              <h3 class="text-lg font-bold mb-6 text-gray-900">Partager cet article</h3>
              <div class="flex flex-wrap gap-3">
                <button class="flex items-center justify-center w-12 h-12 bg-black text-white rounded-full hover:bg-gray-800 transition-all duration-300 hover:scale-110 group">
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </button>
                
                <button class="flex items-center justify-center w-12 h-12 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition-all duration-300 hover:scale-110 group">
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </button>
                
                <button class="flex items-center justify-center w-12 h-12 bg-blue-700 text-white rounded-full hover:bg-blue-800 transition-all duration-300 hover:scale-110 group">
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </button>
                
                <button class="flex items-center justify-center w-12 h-12 bg-green-600 text-white rounded-full hover:bg-green-700 transition-all duration-300 hover:scale-110 group">
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                </button>
                
                <button class="flex items-center justify-center w-12 h-12 bg-gray-600 text-white rounded-full hover:bg-gray-700 transition-all duration-300 hover:scale-110 group">
                  <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Sidebar avec articles récents -->
          <aside class="lg:col-span-1">
            <div class="sticky top-24">
              <h3 class="text-xl font-bold mb-6 text-gray-900 border-b-2 border-yam-red pb-2">Articles récents</h3>
              <div class="space-y-6">
                {allPosts
                  .filter(p => p.data.id !== post.data.id)
                  .slice(0, 5)
                  .map((article) => (
                    <article class="group">
                      <a href={`/actualites/${article.data.slug}`} class="block">
                        <div class="flex gap-4 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                          <div class="flex-shrink-0">
                            <img
                              src={article.data.image || 'https://via.placeholder.com/80x60'}
                              alt={article.data.title}
                              class="w-20 h-15 object-cover rounded-md"
                            />
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yam-red text-white mb-2">
                              {article.data.category}
                            </div>
                            <h4 class="text-sm font-semibold text-gray-900 group-hover:text-yam-red transition-colors line-clamp-2 mb-2">
                              {article.data.title}
                            </h4>
                            <time datetime={article.data.date} class="text-xs text-gray-500">
                              {article.data.formattedDate}
                            </time>
                          </div>
                        </div>
                      </a>
                    </article>
                  ))
                }
              </div>
              
              <!-- Lien vers toutes les actualités -->
              <div class="mt-8 pt-6 border-t border-gray-200">
                <a
                  href="/actualites"
                  class="block text-center bg-yam-red text-white py-3 px-4 rounded-lg hover:bg-red-700 transition-colors font-medium text-sm"
                >
                  Voir toutes les actualités
                </a>
              </div>
            </div>
          </aside>

        </div>
      </div>
    </div>
  </article>

  <!-- Related Articles -->
  {relatedPosts.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-12 text-center">Articles similaires</h2>
          
          <div class="grid md:grid-cols-3 gap-8">
            {relatedPosts.map((article) => (
              <article class="group">
                <a href={article.url} class="block">
                  <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
                    <div class="relative h-48 overflow-hidden">
                      <img
                        src={article.image || 'https://via.placeholder.com/400x300'}
                        alt={article.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      <div class="absolute top-4 left-4">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yam-red text-white">
                          {article.category}
                        </span>
                      </div>
                    </div>
                    <div class="p-6">
                      <time datetime={article.date} class="text-sm text-gray-500">
                        {new Date(article.date).toLocaleDateString('fr-FR', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      <h3 class="text-lg font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors line-clamp-2">
                        {article.title}
                      </h3>
                      <p class="text-gray-600 text-sm line-clamp-3">{article.excerpt}</p>
                      <div class="flex justify-end mt-4">
                        <span class="text-yam-red font-medium group-hover:underline text-sm">Lire la suite →</span>
                      </div>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Back to articles -->
  <section class="py-12 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <a
          href="/actualites"
          class="inline-flex items-center bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Retour aux actualités
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Copy link functionality
  document.addEventListener('DOMContentLoaded', function() {
    const shareButtons = document.querySelectorAll('button');
    const copyButton = Array.from(shareButtons).find(btn => btn.querySelector('svg[stroke]'));
    
    if (copyButton) {
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalHTML = copyButton.innerHTML;
          copyButton.innerHTML = `
            <svg class="w-5 h-5 group-hover:scale-110 transition-transform text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          `;
          setTimeout(() => {
            copyButton.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          console.error('Erreur lors de la copie:', err);
        }
      });
    }
  });
</script>
