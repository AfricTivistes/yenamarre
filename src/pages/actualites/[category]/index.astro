---
import MainLayout from '../../../layouts/MainLayout.astro';
import ArticleGrid from '../../../components/ArticleGrid.astro';
import ArticlePagination from '../../../components/ArticlePagination.astro';
import { getLiveCollection } from 'astro/content';

export async function getStaticPaths() {
  const { entries: categories, error } = await getLiveCollection('categories');
  if (error) {
    console.error(`Error loading categories: ${error.message}`);
    return [];
  }

  const colorMap = {
    'communiques-presse': { color: 'yam-red', bgGradient: 'from-yam-red to-red-800', name: 'Communiqué de presse' },
    'appels-offres': { color: 'orange', bgGradient: 'from-orange-900 to-orange-700', name: 'Appel d\'offres' },
    'medias': { color: 'purple', bgGradient: 'from-purple-900 to-purple-700', name: 'Médias' },
    'tribune-libre': { color: 'green', bgGradient: 'from-green-900 to-green-700', name: 'Tribune libre' },
    'dox-ak-sa-gox': { color: 'blue', bgGradient: 'from-blue-900 to-blue-700', name: 'Dox Ak Sa Gox' },
    'citizen-mic': { color: 'teal', bgGradient: 'from-teal-900 to-teal-700', name: 'Citizen Mic' },
  };

  return categories
    .filter(category => colorMap[category.data.slug]) // Only include known categories
    .map(category => ({
      params: { category: category.data.slug },
      props: {
        categoryData: {
          id: category.data.id,
          name: category.data.name,
          slug: category.data.slug,
          description: category.data.description || `Découvrez nos articles dans la catégorie ${category.data.name}.`,
          count: category.data.count,
          ...colorMap[category.data.slug],
        },
      },
    }));
}

const { category } = Astro.params;
const { categoryData } = Astro.props;

// Redirect if category doesn't exist
if (!categoryData) {
  return Astro.redirect('/actualites');
}

// Fetch posts filtered by category
const { entries: categoryPosts, error } = await getLiveCollection('posts', { category: categoryData.name });
if (error) {
  console.error(`Error loading posts for category ${categoryData.name}: ${error.message}`);
}

// Map posts for rendering
const posts = categoryPosts.map(post => ({
  id: post.data.id,
  title: post.data.title,
  excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
  date: post.data.date,
  category: post.data.category,
  image: post.data.image,
  url: `/actualites/${post.data.slug}`,
}));

// Pagination
const POSTS_PER_PAGE = 9;
const currentPage = Number(Astro.url.searchParams.get('page') || 1);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const paginatedPosts = posts.slice(startIndex, endIndex);

// Validate currentPage
if (currentPage < 1 || currentPage > totalPages) {
  return Astro.redirect(`/actualites/${category}`);
}

// Color classes
const getColorClass = (color: string, type: 'bg' | 'text' | 'border' | 'hover') => {
  const colorMap = {
    'orange': { bg: 'bg-orange-600', text: 'text-orange-600', border: 'border-orange-600', hover: 'hover:bg-orange-700' },
    'yam-red': { bg: 'bg-yam-red', text: 'text-yam-red', border: 'border-yam-red', hover: 'hover:bg-red-700' },
    'blue': { bg: 'bg-blue-600', text: 'text-blue-600', border: 'border-blue-600', hover: 'hover:bg-blue-700' },
    'green': { bg: 'bg-green-600', text: 'text-green-600', border: 'border-green-600', hover: 'hover:bg-green-700' },
    'purple': { bg: 'bg-purple-600', text: 'text-purple-600', border: 'border-purple-600', hover: 'hover:bg-purple-700' },
    'teal': { bg: 'bg-teal-600', text: 'text-teal-600', border: 'border-teal-600', hover: 'hover:bg-teal-700' },
  };
  return colorMap[color]?.[type] || colorMap['yam-red'][type];
};
---

<MainLayout title={`${categoryData.name} - Y'EN A MARRE`} currentPath={`/actualites/${category}`}>
  <!-- Hero Section -->
  <section class={`relative py-20 bg-gradient-to-br ${categoryData.bgGradient} overflow-hidden`}>
    <div class="absolute inset-0 opacity-10 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">{categoryData.name}</h1>
        <p class="text-xl text-gray-100">{categoryData.description}</p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Navigation rapide -->
  <section class="py-8 bg-white">
    <div class="container-custom">
      <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/actualites" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Toutes les actualités
          </a>
          <a href="/actualites/communiques-presse" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'communiques-presse' ? getColorClass('yam-red', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Communiqués de presse
          </a>
          <a href="/actualites/appels-offres" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'appels-offres' ? getColorClass('orange', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Appels d'offres
          </a>
          <a href="/actualites/medias" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'medias' ? getColorClass('purple', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Médias
          </a>
          <a href="/actualites/tribune-libre" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'tribune-libre' ? getColorClass('green', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Tribune libre
          </a>
          <a href="/actualites/dox-ak-sa-gox" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'dox-ak-sa-gox' ? getColorClass('blue', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Dox Ak Sa Gox
          </a>
          <a href="/actualites/citizen-mic" class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${category === 'citizen-mic' ? getColorClass('teal', 'bg') + ' text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            Citizen Mic
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtres spécifiques selon la catégorie -->
  {category === 'appels-offres' && (
    <section class="py-8">
      <div class="container-custom">
        <div class="flex flex-wrap gap-4 justify-center">
          <button class={`px-6 py-3 ${getColorClass('orange', 'bg')} text-white rounded-lg font-medium`}>
            Tous les appels
          </button>
          <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
            Ouverts
          </button>
          <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
            Clôturés
          </button>
        </div>
      </div>
    </section>
  )}

  {category === 'medias' && (
    <section class="py-8">
      <div class="container-custom">
        <div class="flex flex-wrap gap-4 justify-center">
          <button class={`px-6 py-3 ${getColorClass('purple', 'bg')} text-white rounded-lg font-medium`}>
            Tous les médias
          </button>
          <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
            Vidéos
          </button>
          <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
            Podcasts
          </button>
          <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
            Galeries photo
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- Liste des articles -->
  <section class="py-12 md:py-16 bg-white">
    <div class="container-custom">
      {paginatedPosts.length > 0 ? (
        <ArticleGrid articles={paginatedPosts} />
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-600 text-lg">Aucun article disponible dans cette catégorie pour le moment.</p>
        </div>
      )}
      <ArticlePagination
        currentPage={currentPage}
        totalPages={totalPages}
        startIndex={startIndex}
        endIndex={Math.min(endIndex, posts.length)}
        totalArticles={posts.length}
        baseUrl={`/actualites/${category}`}
      />
    </div>
  </section>

  <!-- Sections spécifiques selon la catégorie -->
  {category === 'appels-offres' && (
    <section class="py-16 bg-orange-50">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-6">Recevez les nouveaux appels d'offres</h2>
          <p class="text-lg text-gray-600 mb-8">
            Inscrivez-vous pour être alerté des nouvelles opportunités dès leur publication.
          </p>
          <form class="flex flex-col md:flex-row gap-4">
            <input
              type="email"
              placeholder="Votre adresse email"
              class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-600 border border-gray-300"
              required
            />
            <button
              type="submit"
              class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-6 rounded-lg transition-colors"
            >
              S'abonner aux alertes
            </button>
          </form>
        </div>
      </div>
    </section>
  )}

  {category === 'tribune-libre' && (
    <section class="py-16 bg-green-50">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-6">Contribuez à notre tribune libre</h2>
          <p class="text-lg text-gray-600 mb-8">
            Vous souhaitez partager vos réflexions sur les enjeux de société ? Proposez votre tribune.
          </p>
          <a href="/contact" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">
            Proposer une tribune
          </a>
        </div>
      </div>
    </section>
  )}

  {category === 'communiques-presse' && (
    <section class="py-16 bg-gray-100">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto bg-white/80 backdrop-blur-md p-8 rounded-xl shadow-lg border border-gray-100">
          <div class="text-center">
            <h2 class="text-3xl font-bold mb-6">Restez informé de nos prises de position</h2>
            <p class="text-lg text-gray-600 mb-8">
              Recevez nos communiqués officiels directement dans votre boîte email.
            </p>
            <form class="flex flex-col md:flex-row gap-4">
              <input
                type="email"
                placeholder="Votre adresse email"
                class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red border border-gray-300"
                required
              />
              <button
                type="submit"
                class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors"
              >
                S'abonner
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  )}
</MainLayout>