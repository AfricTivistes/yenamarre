---
import MainLayout from '../../layouts/MainLayout.astro';

// Tous les articles (simulation d'une base de données)
const allArticles = [
  {
    id: 1,
    title: "Manifestation pour la démocratie à Dakar",
    excerpt: "Plus de 1000 personnes se sont réunies à Dakar pour manifester en faveur de la démocratie et contre la corruption.",
    date: "2023-06-15",
    category: "Y'EN A MARRE",
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop",
    url: "/actualites/manifestation-democratie-dakar"
  },
  {
    id: 2,
    title: "Position officielle sur les réformes électorales",
    excerpt: "Y'EN A MARRE exprime sa position sur les récentes propositions de réformes du système électoral sénégalais.",
    date: "2023-06-10",
    category: "Communiqué de presse",
    image: "https://images.unsplash.com/photo-1586339949916-3e9457bef6d3?w=400&h=300&fit=crop",
    url: "/actualites/position-reformes-electorales"
  },
  {
    id: 3,
    title: "Y'EN A MARRE dans Le Quotidien",
    excerpt: "Interview exclusive de nos dirigeants sur les enjeux démocratiques actuels.",
    date: "2023-06-08",
    category: "YAM dans la presse",
    image: "https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=400&h=300&fit=crop",
    url: "/actualites/interview-quotidien"
  },
  {
    id: 4,
    title: "Documentaire : 12 ans d'activisme",
    excerpt: "Découvrez notre parcours à travers un documentaire retraçant 12 années d'engagement.",
    date: "2023-06-05",
    category: "Médias",
    image: "https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?w=400&h=300&fit=crop",
    url: "/actualites/documentaire-12-ans"
  },
  {
    id: 5,
    title: "Tribune : Pour une jeunesse engagée",
    excerpt: "Réflexion sur l'importance de l'engagement citoyen chez les jeunes sénégalais d'aujourd'hui.",
    date: "2023-06-03",
    category: "Tribune libre",
    image: "https://images.unsplash.com/photo-1529390079861-591de354faf5?w=400&h=300&fit=crop",
    url: "/actualites/tribune-jeunesse-engagee"
  },
  {
    id: 6,
    title: "Appel à la transparence budgétaire",
    excerpt: "Le mouvement demande plus de transparence dans la gestion des finances publiques.",
    date: "2023-05-28",
    category: "Communiqué de presse",
    image: "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=400&h=300&fit=crop",
    url: "/actualites/appel-transparence-budgetaire"
  },
  {
    id: 7,
    title: "Reportage RTS sur nos actions",
    excerpt: "La télévision nationale couvre nos dernières initiatives citoyennes.",
    date: "2023-05-25",
    category: "YAM dans la presse",
    image: "https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=400&h=300&fit=crop",
    url: "/actualites/reportage-rts"
  },
  {
    id: 8,
    title: "Galerie photos : Marche citoyenne",
    excerpt: "Revivez en images la dernière marche citoyenne organisée à Dakar.",
    date: "2023-05-20",
    category: "Médias",
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop",
    url: "/actualites/galerie-marche-citoyenne"
  },
  {
    id: 9,
    title: "Nouveau partenariat avec l'Union Européenne",
    excerpt: "Y'EN A MARRE signe un accord de partenariat stratégique avec l'UE pour renforcer la démocratie.",
    date: "2023-05-15",
    category: "Communiqué de presse",
    image: "https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop",
    url: "/actualites/partenariat-union-europeenne"
  },
  {
    id: 10,
    title: "Atelier de formation des jeunes leaders",
    excerpt: "Formation de 50 jeunes leaders dans les régions de Thiès et Kaolack sur le leadership démocratique.",
    date: "2023-05-12",
    category: "Y'EN A MARRE",
    image: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=400&h=300&fit=crop",
    url: "/actualites/formation-jeunes-leaders"
  },
  {
    id: 11,
    title: "Recrutement : Coordinateur de projets",
    excerpt: "Y'EN A MARRE recrute un coordinateur de projets pour renforcer son équipe opérationnelle.",
    date: "2023-05-10",
    category: "Appels d'offres",
    image: "https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=400&h=300&fit=crop",
    url: "/actualites/recrutement-coordinateur"
  },
  {
    id: 12,
    title: "Podcast : Dialogue sur la gouvernance",
    excerpt: "Nouvelle série de podcasts sur les enjeux de gouvernance avec des experts nationaux et internationaux.",
    date: "2023-05-08",
    category: "Médias",
    image: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&h=300&fit=crop",
    url: "/actualites/podcast-gouvernance"
  }
];

// Paramètres de pagination
const articlesPerPage = 9;
const urlParams = new URLSearchParams(Astro.url.search);
const currentPage = parseInt(urlParams.get('page') || '1');
const totalArticles = allArticles.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;
const paginatedArticles = allArticles.slice(startIndex, endIndex);

// Fonction pour générer les URLs de pagination
const getPageUrl = (page: number) => {
  const url = new URL(Astro.url);
  url.searchParams.set('page', page.toString());
  return url.pathname + url.search;
};

// Déterminer la couleur de la catégorie
const getCategoryColor = (category: string) => {
  switch (category) {
    case 'Communiqué de presse': return 'bg-red-600';
    case 'YAM dans la presse': return 'bg-blue-600';
    case 'Tribune libre': return 'bg-green-600';
    case 'Médias': return 'bg-purple-600';
    case 'Appels d\'offres': return 'bg-orange-600';
    default: return 'bg-yam-red';
  }
};
---

<MainLayout title="Tous les articles - Y'EN A MARRE" currentPath="/actualites/tous-les-articles">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-900 to-black text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Tous nos articles</h1>
        <p class="text-xl text-gray-300">
          Explorez l'ensemble de nos publications, communiqués et prises de position.
        </p>
      </div>
    </div>
  </section>

  <!-- Articles avec pagination -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <!-- Filtres (pour future implémentation) -->
      <div class="mb-12">
        <div class="flex flex-wrap gap-4 justify-center">
          <button class="px-6 py-2 bg-yam-red text-white rounded-full font-medium">
            Tous
          </button>
          <button class="px-6 py-2 bg-white text-gray-700 rounded-full font-medium hover:bg-gray-100 transition-colors">
            Communiqués
          </button>
          <button class="px-6 py-2 bg-white text-gray-700 rounded-full font-medium hover:bg-gray-100 transition-colors">
            Presse
          </button>
          <button class="px-6 py-2 bg-white text-gray-700 rounded-full font-medium hover:bg-gray-100 transition-colors">
            Tribune
          </button>
          <button class="px-6 py-2 bg-white text-gray-700 rounded-full font-medium hover:bg-gray-100 transition-colors">
            Médias
          </button>
        </div>
      </div>

      <!-- Grille des articles -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {paginatedArticles.map((article) => (
          <article class="group">
            <a href={article.url} class="block">
              <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                <div class="relative h-48 overflow-hidden">
                  <img 
                    src={article.image} 
                    alt={article.title} 
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute top-4 left-4">
                    <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium text-white ${getCategoryColor(article.category)}`}>
                      {article.category}
                    </span>
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                <div class="p-6">
                  <time datetime={article.date} class="text-sm text-gray-500">
                    {new Date(article.date).toLocaleDateString('fr-FR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <h3 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                    {article.title}
                  </h3>
                  <p class="text-gray-600 mb-4">{article.excerpt}</p>
                  <div class="flex justify-end">
                    <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- Pagination avancée -->
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="text-gray-600 mb-6 md:mb-0">
          Affichage de {startIndex + 1} à {Math.min(endIndex, totalArticles)} sur {totalArticles} articles
        </div>

        <nav class="flex items-center space-x-2">
          <!-- Bouton précédent -->
          {currentPage > 1 ? (
            <a 
              href={getPageUrl(currentPage - 1)} 
              class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors"
            >
              Précédent
            </a>
          ) : (
            <span class="px-4 py-2 border border-gray-300 rounded-lg text-gray-400 cursor-not-allowed">
              Précédent
            </span>
          )}

          <!-- Numéros de page -->
          {(() => {
            const pageNumbers = [];
            const maxVisiblePages = Math.min(5, totalPages);
            
            for (let i = 0; i < maxVisiblePages; i++) {
              let pageNum;
              if (totalPages < 5) {
                pageNum = i + 1;
              } else if (currentPage <= 3) {
                pageNum = i + 1;
              } else if (currentPage >= totalPages - 2) {
                pageNum = totalPages - 4 + i;
              } else {
                pageNum = currentPage - 2 + i;
              }
              
              pageNumbers.push(
                <a 
                  href={getPageUrl(pageNum)} 
                  class={`px-4 py-2 rounded-lg transition-colors ${
                    pageNum === currentPage 
                      ? 'bg-yam-red text-white' 
                      : 'border border-gray-300 text-gray-600 hover:bg-gray-50'
                  }`}
                >
                  {pageNum}
                </a>
              );
            }
            
            return pageNumbers;
          })()}

          {totalPages > 5 && currentPage < totalPages - 2 && (
            <>
              <span class="px-2 text-gray-400">...</span>
              <a 
                href={getPageUrl(totalPages)} 
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors"
              >
                {totalPages}
              </a>
            </>
          )}

          <!-- Bouton suivant -->
          {currentPage < totalPages ? (
            <a 
              href={getPageUrl(currentPage + 1)} 
              class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors"
            >
              Suivant
            </a>
          ) : (
            <span class="px-4 py-2 border border-gray-300 rounded-lg text-gray-400 cursor-not-allowed">
              Suivant
            </span>
          )}
        </nav>
      </div>
    </div>
  </section>

  <!-- Retour aux actualités -->
  <section class="py-16 bg-white">
    <div class="container-custom text-center">
      <a 
        href="/actualites" 
        class="inline-flex items-center bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 rounded-lg transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Retour aux actualités
      </a>
    </div>
  </section>
</MainLayout>