---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import ArticleGrid from "../../components/ArticleGrid.astro";
import ArticlePagination from "../../components/ArticlePagination.astro";
import CategorySection from "../../components/CategorySection.astro";
import TribuneLibreSection from "../../components/TribuneLibreSection.astro";
import CategoriesSection from "../../components/CategoriesSection.astro";
import { getCollection, getEntry } from "astro:content";

const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get("page") || "1", 10);

const allPosts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allCategories = await getCollection("categories");

// Create category map
const categoryMap = new Map(
  allCategories.map((cat) => [
    String(cat.data.id),
    cat.data.name ?? cat.data.slug ?? "Actualité",
  ])
);

// Transform posts to news articles
const newsArticles = await Promise.all(
  allPosts.map(async (post) => {
    const imageEntry = post.data.featured_media
      ? await getEntry(post.data.featured_media)
      : null;

    const categoryNames = post.data.categories?.map(
      (cat) => categoryMap.get(String(cat.id)) ?? "Actualité"
    ) ?? ["Actualité"];

    return {
      id: String(post.id),
      url: `/actualites/${post.data.slug}`,
      title: post.data.title?.rendered,
      date: new Date(post.data.date),
      excerpt: post.data.excerpt?.rendered ?? "",
      image:
        imageEntry?.data?.source_url ??
        "https://placehold.co/800x600?text=Y+EN+MARRE",
      category: categoryNames,
      featured: post.data.sticky ?? false,
      content: post.data.content?.rendered ?? "",
    };
  })
);

const featuredNews = newsArticles.find((post) => post.featured);

const articlesPerPage = 9;
const totalArticles = newsArticles.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = Math.min(startIndex + articlesPerPage, totalArticles);

const paginatedNews = newsArticles.slice(startIndex, endIndex);

const newsByCategory = {
  "communique-de-presse": newsArticles
    .filter((post) => post.category.includes("Communiqué de presse"))
    .slice(0, 2)
    .map((post) => ({
      id: post.id,
      title: post.title,
      excerpt: post.excerpt || post.content.slice(0, 150) + "...",
      date: post.date,
      category: post.category[0] || "Actualité",
      categories: post.category,
      image: post.image,
      url: post.url,
    })),
  "yem-dans-la-presse": newsArticles
    .filter((post) => post.category.includes("YAM dans la presse"))
    .slice(0, 2)
    .map((post) => ({
      id: post.id,
      title: post.title,
      excerpt: post.excerpt || post.content.slice(0, 150) + "...",
      date: post.date,
      category: post.category[0] || "Actualité",
      categories: post.category,
      image: post.image,
      url: post.url,
    })),
  "dox-ak-sa-gox": newsArticles
    .filter((post) => post.category.includes("Dox Ak Sa Gox"))
    .slice(0, 2)
    .map((post) => ({
      id: post.id,
      title: post.title,
      excerpt: post.excerpt || post.content.slice(0, 150) + "...",
      date: post.date,
      category: post.category[0] || "Actualité",
      categories: post.category,
      image: post.image,
      url: post.url,
    })),
  "tribune-libre": newsArticles
    .filter((post) => post.category.includes("Tribune libre"))
    .slice(0, 2)
    .map((post) => ({
      id: post.id,
      title: post.title,
      excerpt: post.excerpt || post.content.slice(0, 150) + "...",
      date: post.date,
      category: post.category[0] || "Actualité",
      categories: post.category,
      image: post.image,
      url: post.url,
    })),
};

// Categories configuration for component
const categoriesData = [
  {
    name: "Communiqués de presse",
    slug: "communique-de-presse",
    description: "Nos positions officielles et déclarations publiques",
    bgGradient: "bg-gradient-to-r from-yam-red to-red-600",
    textColor: "text-yam-red",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
    </svg>`,
    news: newsByCategory["communique-de-presse"].map((news) => ({
      id: news.id,
      title: news.title,
      date: news.date,
      slug: news.url.split("/").pop(),
    })),
  },
  {
    name: "YAM dans la presse",
    slug: "yem-dans-la-presse",
    description: "Notre couverture médiatique nationale et internationale",
    bgGradient: "bg-gradient-to-r from-gray-600 to-gray-700",
    textColor: "text-gray-700",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 01-2-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    </svg>`,
    news: newsByCategory["yem-dans-la-presse"]?.map((news) => ({
      id: news.id,
      title: news.title,
      date: news.date,
      slug: news.url.split("/").pop(),
    })),
  },
  {
    name: "Dox Ak Sa Gox",
    slug: "dox-ak-sa-gox",
    description: "Documentaires, photos, vidéos et podcasts",
    bgGradient: "bg-gradient-to-r from-gray-500 to-gray-600",
    textColor: "text-gray-600",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>`,
    news: newsByCategory["dox-ak-sa-gox"].map((news) => ({
      id: news.id,
      title: news.title,
      date: news.date,
      slug: news.url.split("/").pop(),
    })),
  },
];
---

<MainLayout title="Actualités - Y'EN A MARRE" currentPath="/actualites">
  {
    featuredNews && (
      <ArticleHero
        title={featuredNews.title}
        excerpt={
          featuredNews.excerpt || featuredNews.content.slice(0, 150) + "..."
        }
        date={featuredNews.date.toISOString()}
        formattedDate={featuredNews.date.toLocaleDateString("fr-FR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
        category={featuredNews.category[0] || "Actualité"}
        image={featuredNews.image}
        slug={featuredNews.url.split("/").pop()}
        isSticky={true}
      />
    )
  }

  <!-- Articles récents -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-6">Articles récents</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez nos dernières publications et prises de position.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {
          paginatedNews.map((article) => (
            <article class="group">
              <a href={article.url} class="block">
                <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
                  <div class="relative h-48 overflow-hidden">
                    <img
                      src={
                        article.image ||
                        "https://placehold.co/400x300?text=Y+EN+MARRE"
                      }
                      alt={article.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute top-4 left-4">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yam-red text-white">
                        {article.category[0] || "Actualité"}
                      </span>
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                  </div>
                  <div class="p-6">
                    <time
                      datetime={article.date.toISOString()}
                      class="text-sm text-gray-500"
                    >
                      {article.date.toLocaleDateString("fr-FR", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <h3
                      class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors line-clamp-2"
                      set:html={article.title}
                    />
                    <p
                      class="text-gray-600 mb-4 line-clamp-3"
                      set:html={
                        article.excerpt.slice(0, 150) +
                        (article.excerpt.length > 150 ? "..." : "")
                      }
                    />
                    <div class="flex justify-end">
                      <span class="text-yam-red font-medium group-hover:underline">
                        Lire la suite →
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <ArticlePagination
        currentPage={currentPage}
        totalPages={totalPages}
        startIndex={startIndex}
        endIndex={endIndex}
        totalArticles={totalArticles}
        basePath="/actualites"
      />
    </div>
  </section>

  <!-- Section Catégories -->
  <section class="py-12 bg-gray-50">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">Parcourir par catégorie</h2>
      <div class="flex flex-wrap gap-4 justify-center">
        {allCategories.map((cat) => {
          const count = allPosts.filter((p) =>
            p.data.categories?.some((c) => String(c.id) === String(cat.data.id))
          ).length;
          return (
            <a
              href={`/actualites/categories/${cat.data.slug}`}
              class="px-6 py-3 rounded-full font-medium bg-white border border-gray-200 text-gray-700 hover:bg-yam-red hover:text-white hover:border-yam-red transition-colors shadow-sm"
            >
              {cat.data.name ?? cat.data.slug}
              <span class="ml-2 text-sm opacity-70">({count})</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <TribuneLibreSection
    tribuneArticles={newsByCategory["tribune-libre"] || []}
  />

  <CategoriesSection categories={categoriesData} />

  <!-- Newsletter -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div
      class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract+pattern+dots')] opacity-5"
    >
    </div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Restez informé</h2>
        <p class="text-lg mb-8">
          Inscrivez-vous à notre newsletter pour recevoir les dernières
          actualités et informations sur nos campagnes.
        </p>

        <form
          class="flex flex-col md:flex-row gap-4 bg-white/5 p-3 rounded-lg backdrop-blur-sm"
        >
          <input
            type="email"
            placeholder="Votre adresse email"
            class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red text-black bg-white"
            required
          />
          <button
            type="submit"
            class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors transform hover:scale-105"
          >
            S'inscrire
          </button>
        </form>

        <p class="text-sm mt-4 text-gray-400">
          En vous inscrivant, vous acceptez de recevoir nos emails et confirmez
          avoir lu notre politique de confidentialité.
        </p>
      </div>
    </div>
  </section>
</MainLayout>
