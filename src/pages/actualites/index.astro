---
import MainLayout from '../../layouts/MainLayout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import ArticlePagination from '../../components/ArticlePagination.astro';
import CategorySection from '../../components/CategorySection.astro';
import { getLiveCollection } from 'astro:content';

const { entries: allPosts, error } = await getLiveCollection('posts');
if (error) {
  console.error(`Error loading posts: ${error.message}`);
}

const featuredNews = allPosts.find(post => post.data.sticky) || allPosts[0] || {
  id: '0',
  data: {
    id: 0,
    slug: 'placeholder',
    title: 'No featured news available',
    excerpt: 'Check back later for updates.',
    date: new Date(),
    category: 'Y\'EN A MARRE',
    image: 'https://via.placeholder.com/800x600',
    sticky: false,
    formattedDate: new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }),
  },
};

const articlesPerPage = 6;
const currentPage = Number(Astro.url.searchParams.get('page') || 1);
const recentNews = allPosts
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .map(post => ({
    id: post.data.id,
    title: post.data.title,
    excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
    date: post.data.date,
    category: post.data.category,
    image: post.data.image,
    url: `/actualites/${post.data.slug}`,
  }));

const totalArticles = allPosts.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;
const paginatedNews = recentNews.slice(startIndex, endIndex);

const newsByCategory = {
  'communiques-presse': allPosts
    .filter(post => post.data.category === 'Communiqué de presse')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
  'appels-offres': allPosts
    .filter(post => post.data.category === 'Appel d\'offres')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
  'medias': allPosts
    .filter(post => post.data.category === 'Médias')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
  'tribune-libre': allPosts
    .filter(post => post.data.category === 'Tribune libre')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
  'dox-ak-sa-gox': allPosts
    .filter(post => post.data.category === 'Dox Ak Sa Gox')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
  'citizen-mic': allPosts
    .filter(post => post.data.category === 'Citizen Mic')
    .slice(0, 2)
    .map(post => ({
      id: post.data.id,
      title: post.data.title,
      excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      url: `/actualites/${post.data.slug}`,
    })),
};

const colorMap = {
  'communiques-presse': { color: 'yam-red', bgGradient: 'from-yam-red to-red-800', icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' },
  'appels-offres': { color: 'orange', bgGradient: 'from-orange-900 to-orange-700', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6' },
  'medias': { color: 'purple', bgGradient: 'from-purple-900 to-purple-700', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
  'tribune-libre': { color: 'green', bgGradient: 'from-green-900 to-green-700', icon: 'M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z' },
  'dox-ak-sa-gox': { color: 'blue', bgGradient: 'from-blue-900 to-blue-700', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  'citizen-mic': { color: 'teal', bgGradient: 'from-teal-900 to-teal-700', icon: 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z' },
};
---

<MainLayout title="Actualités - Y'EN A MARRE" currentPath="/actualites">
  {featuredNews && (
    <ArticleHero
      title={featuredNews.data.title}
      excerpt={featuredNews.data.excerpt || featuredNews.data.content.slice(0, 150) + '...'}
      date={featuredNews.data.date}
      formattedDate={featuredNews.data.formattedDate}
      category={featuredNews.data.category}
      image={featuredNews.data.image}
      slug={featuredNews.data.slug}
      isSticky={featuredNews.data.sticky}
    />
  )}

  <!-- Articles récents -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-6">Articles récents</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez nos dernières publications et prises de position.
          </p>
        </div>
        <a
          href="/actualites/tous-les-articles"
          class="text-yam-red font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center"
        >
          Voir tous les articles
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <ArticleGrid articles={paginatedNews} />

      <ArticlePagination
        currentPage={currentPage}
        totalPages={totalPages}
        startIndex={startIndex}
        endIndex={Math.min(endIndex, totalArticles)}
        totalArticles={totalArticles}
        baseUrl="/actualites"
      />
    </div>
  </section>

  <!-- Tribune libre - Section mise en avant -->
  <CategorySection
    title="Tribune libre"
    description="Découvrez les réflexions et analyses de nos membres et sympathisants sur les enjeux démocratiques du Sénégal."
    articles={newsByCategory['tribune-libre']}
    link="/actualites/tribune-libre"
    icon={colorMap['tribune-libre'].icon}
    gradient={colorMap['tribune-libre'].bgGradient}
  />

  <!-- Catégories d'actualités -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Nos actualités par catégorie</h2>
        <p class="text-xl text-gray-600">
          Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <CategorySection
          title="Communiqués de presse"
          description="Nos positions officielles et déclarations publiques"
          articles={newsByCategory['communiques-presse']}
          link="/actualites/communiques-presse"
          icon={colorMap['communiques-presse'].icon}
          gradient={colorMap['communiques-presse'].bgGradient}
        />
        <CategorySection
          title="Appels d'offres"
          description="Opportunités d'emploi et collaborations"
          articles={newsByCategory['appels-offres']}
          link="/actualites/appels-offres"
          icon={colorMap['appels-offres'].icon}
          gradient={colorMap['appels-offres'].bgGradient}
        />
        <CategorySection
          title="Médias"
          description="Documentaires, photos, vidéos et podcasts"
          articles={newsByCategory['medias']}
          link="/actualites/medias"
          icon={colorMap['medias'].icon}
          gradient={colorMap['medias'].bgGradient}
        />
        <CategorySection
          title="Dox Ak Sa Gox"
          description="Initiatives pour la démocratie et la bonne gouvernance"
          articles={newsByCategory['dox-ak-sa-gox']}
          link="/actualites/dox-ak-sa-gox"
          icon={colorMap['dox-ak-sa-gox'].icon}
          gradient={colorMap['dox-ak-sa-gox'].bgGradient}
        />
        <CategorySection
          title="Citizen Mic"
          description="Compétition de rap engagé pour la citoyenneté"
          articles={newsByCategory['citizen-mic']}
          link="/actualites/citizen-mic"
          icon={colorMap['citizen-mic'].icon}
          gradient={colorMap['citizen-mic'].bgGradient}
        />
      </div>

      <div class="bg-gray-50 rounded-xl p-8 border border-gray-100">
        <h4 class="text-xl font-bold mb-6 text-center text-gray-800">Autres contenus</h4>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/actualites/archives" class="group block p-6 rounded-lg bg-white hover:bg-gray-50 transition-all border border-gray-100">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center group-hover:bg-gray-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </div>
              <div>
                <h5 class="font-bold text-gray-800 mb-1">Archives</h5>
                <p class="text-gray-600 text-sm">Historique de nos publications</p>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] opacity-5"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Restez informé</h2>
        <p class="text-lg mb-8">
          Inscrivez-vous à notre newsletter pour recevoir les dernières actualités et informations sur nos campagnes.
        </p>
        <form class="flex flex-col md:flex-row gap-4 bg-white/5 p-3 rounded-lg backdrop-blur-sm">
          <input
            type="email"
            placeholder="Votre adresse email"
            class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red text-black bg-white"
            required
          />
          <button
            type="submit"
            class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors transform hover:scale-105"
          >
            S'inscrire
          </button>
        </form>
        <p class="text-sm mt-4 text-gray-400">
          En vous inscrivant, vous acceptez de recevoir nos emails et confirmez avoir lu notre politique de confidentialité.
        </p>
      </div>
    </div>
  </section>
</MainLayout>