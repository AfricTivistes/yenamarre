
---
import MainLayout from '../../layouts/MainLayout.astro';

// Données pour les médias
const medias = [
  {
    id: 1,
    title: "Documentaire : 12 ans de Y'EN A MARRE",
    excerpt: "Retour sur 12 années d'activisme et d'engagement citoyen à travers ce documentaire exclusif.",
    date: "2023-06-01",
    category: "Documentaire",
    type: "video",
    image: "/placeholder.svg?height=400&width=600&query=Documentary film about activism",
    url: "/actualites/documentaire-12-ans-yenamarre",
    duration: "45 min"
  },
  {
    id: 2,
    title: "Podcast : L'engagement de la jeunesse africaine",
    excerpt: "Discussion avec les leaders de Y'EN A MARRE sur l'engagement de la jeunesse en Afrique.",
    date: "2023-05-28",
    category: "Podcast",
    type: "audio",
    image: "/placeholder.svg?height=400&width=600&query=Podcast recording studio",
    url: "/actualites/podcast-engagement-jeunesse-africaine",
    duration: "35 min"
  },
  {
    id: 3,
    title: "Galerie photo : Manifestation pour la démocratie",
    excerpt: "Images exclusives de la grande manifestation organisée par Y'EN A MARRE à Dakar.",
    date: "2023-05-20",
    category: "Galerie photo",
    type: "gallery",
    image: "/placeholder.svg?height=400&width=600&query=Democracy protest photos",
    url: "/actualites/galerie-manifestation-democratie",
    count: "24 photos"
  }
];
---

<MainLayout title="Médias - Y'EN A MARRE" currentPath="/actualites/medias">
  <!-- Hero Section -->
  <section class="relative py-20 bg-gradient-to-br from-purple-900 to-purple-700 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Médias</h1>
        <p class="text-xl text-gray-100">
          Découvrez nos contenus multimédias : documentaires, podcasts, galeries photos et vidéos de nos actions.
        </p>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Navigation rapide -->
  <section class="py-8 bg-white">
    <div class="container-custom">
      <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/actualites" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Toutes les actualités
          </a>
          <a href="/actualites/communiques-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Communiqués de presse
          </a>
          <a href="/actualites/yam-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            YAM dans la presse
          </a>
          <a href="/actualites/tribune-libre" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Tribune libre
          </a>
          <a href="/actualites/medias" class="px-4 py-2 rounded-full text-sm font-medium bg-purple-600 text-white">
            Médias
          </a>
          <a href="/actualites/appels-offres" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Appels d'offres
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Filtres par type de média -->
  <section class="py-8">
    <div class="container-custom">
      <div class="flex flex-wrap gap-4 justify-center">
        <button class="px-6 py-3 bg-purple-600 text-white rounded-lg font-medium">
          Tous les médias
        </button>
        <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
          Vidéos
        </button>
        <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
          Podcasts
        </button>
        <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
          Galeries photo
        </button>
      </div>
    </div>
  </section>
  
  <!-- Liste des médias -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {medias.map((media) => (
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="relative">
              <img src={media.image} alt={media.title} class="w-full h-48 object-cover" />
              <div class="absolute top-4 left-4">
                {media.type === 'video' && (
                  <div class="bg-red-600 text-white px-3 py-1 rounded-full text-sm font-medium flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    Vidéo
                  </div>
                )}
                {media.type === 'audio' && (
                  <div class="bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                      <line x1="12" y1="19" x2="12" y2="23"/>
                      <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                    Audio
                  </div>
                )}
                {media.type === 'gallery' && (
                  <div class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-medium flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="9" cy="9" r="2"/>
                      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                    Galerie
                  </div>
                )}
              </div>
              <div class="absolute bottom-4 right-4">
                <span class="bg-black/70 text-white px-2 py-1 rounded text-sm">
                  {media.duration || media.count}
                </span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="bg-purple-100 text-purple-800 text-xs font-semibold px-2.5 py-0.5 rounded">
                  {media.category}
                </span>
                <span class="text-gray-500 text-sm">{media.date}</span>
              </div>
              <h3 class="text-xl font-bold mb-3 line-clamp-2">{media.title}</h3>
              <p class="text-gray-600 mb-4 line-clamp-3">{media.excerpt}</p>
              <a href={media.url} class="text-purple-600 font-medium hover:text-purple-800 transition-colors">
                Voir le contenu →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
