---
// src/pages/actualites/categories/[category].astro
import MainLayout from "../../../layouts/MainLayout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import ArticlePagination from "../../../components/ArticlePagination.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

// Props
const { category } = Astro.props;

return Astro.redirect(`/actualites/categories/${category.data.slug}/page/1`);
---