
---
import MainLayout from "../../../layouts/MainLayout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import ArticlePagination from "../../../components/ArticlePagination.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const currentPage = 1; // Page 1 par défaut pour l'index de la catégorie

const allPosts = await getCollection("posts");
const allCategories = await getCollection("categories");

const categoryMap = new Map(
  allCategories.map((cat) => [
    cat.id,
    cat.data.name ?? cat.data.slug,
  ])
);

const categoryPosts = allPosts
  .filter((post) => {
    const postCategories = post.data.categories ?? [];
    return postCategories.some((cat) => cat.id === category.id);
  })
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const newsArticles = await Promise.all(
  categoryPosts.map(async (post) => {
    const imageEntry = post.data.featured_media
      ? await getEntry(post.data.featured_media)
      : null;

    const categoryNames = (post.data.categories ?? [])
      .map((cat) => categoryMap.get(cat.id) ?? "Actualité")
      .filter(Boolean);

    return {
      id: post.id,
      slug: post.data.slug,
      title: post.data.title.rendered,
      date: post.data.date,
      excerpt: post.data.excerpt.rendered,
      image:
        imageEntry?.data?.source_url ??
        "https://placehold.co/800x600?text=Y+EN+MARRE",
      category: categoryNames,
      featured: post.data.sticky ?? false,
      url: `/actualites/${post.data.slug}`,
    };
  })
);

const articlesPerPage = 9;
const totalArticles = newsArticles.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;
const paginatedArticles = newsArticles.slice(startIndex, endIndex);

function slugToTitle(slug) {
  return slug
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<MainLayout
  title={`${category.data.name ?? slugToTitle(category.data.slug)} - Y'EN A MARRE`}
  currentPath={Astro.url.pathname}
>
  <section class="relative py-20 overflow-hidden">
    <div
      class="absolute inset-0 bg-[url('/images/yem.jpg')] bg-cover bg-center"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-br from-yam-red/70 to-red-800/70"
    >
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <div class="flex justify-center mb-6">
          <div class="bg-white/20 backdrop-blur-sm p-4 rounded-full">
            <Fragment
              set:html={category.data.icon ??
                `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V9m2 11V9a2 2 0 00-2-2H9" />
              </svg>
            `}
            />
          </div>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          {category.data.name ?? slugToTitle(category.data.slug)}
        </h1>
        <p class="text-xl text-gray-100">
          {
            category.data.description ??
              "Retrouvez toutes les actualités de cette catégorie."
          }
        </p>
        <div class="mt-8">
          <span
            class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium"
          >
            {totalArticles} article{totalArticles > 1 ? "s" : ""}
          </span>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1440 120"
        class="w-full h-auto"
      >
        <path
          fill="#ffffff"
          fill-opacity="1"
          d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"
        ></path>
      </svg>
    </div>
  </section>

  <section class="py-8 bg-white">
    <div class="container-custom">
      <div
        class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100"
      >
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="/actualites"
            class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
          >
            Toutes les actualités ({allPosts.length})
          </a>
          {
            allCategories.map((cat) => {
              const count = allPosts.filter((p) =>
                p.data.categories?.some((c) => c.id === cat.id)
              ).length;
              const isActive = cat.data.slug === category.data.slug;
              const bgColor = isActive
                ? cat.data.slug === "communique-de-presse"
                  ? "bg-yam-red"
                  : cat.data.slug === "yam-dans-la-presse"
                    ? "bg-gray-600"
                    : cat.data.slug === "tribune-libre"
                      ? "bg-blue-600"
                      : cat.data.slug === "medias"
                        ? "bg-purple-600"
                        : "bg-green-600"
                : "bg-gray-100 hover:bg-gray-200";
              const textColor = isActive ? "text-white" : "text-gray-700";

              return (
                <a
                  href={`/actualites/categories/${cat.data.slug}`}
                  class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${bgColor} ${textColor}`}
                >
                  {cat.data.name ?? slugToTitle(cat.data.slug)} ({count})
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-custom">
      {
        paginatedArticles.length > 0 ? (
          <>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {paginatedArticles.map((article) => (
                <NewsCard
                  title={article.title}
                  excerpt={article.excerpt}
                  date={article.date}
                  category={article.category}
                  image={article.image}
                  url={article.url}
                  featured={article.featured}
                />
              ))}
            </div>

            {totalPages > 1 && (
              <ArticlePagination
                currentPage={currentPage}
                totalPages={totalPages}
                startIndex={startIndex}
                endIndex={endIndex}
                totalArticles={totalArticles}
                basePath={`/actualites/categories/${category.data.slug}/page`}
              />
            )}
          </>
        ) : (
          <div class="text-center py-16">
            <div class="bg-gray-100 rounded-full w-24 h-24 flex items-center justify-center mx-auto mb-6">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-12 w-12 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
              Aucun article trouvé
            </h3>
            <p class="text-gray-600 mb-8">
              Il n'y a actuellement aucun article dans cette catégorie. Revenez
              bientôt pour découvrir nos nouvelles publications.
            </p>
            <a
              href="/actualites"
              class="inline-flex items-center px-6 py-3 bg-yam-red text-white font-medium rounded-lg hover:bg-red-700 transition-colors"
            >
              Voir toutes les actualités
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="py-16 bg-gray-100">
    <div class="container-custom">
      <div
        class="max-w-3xl mx-auto bg-white/80 backdrop-blur-md p-8 rounded-xl shadow-lg border border-gray-100"
      >
        <div class="text-center">
          <h2 class="text-3xl font-bold mb-6">
            Restez informé de nos articles sous la catégorie&nbsp;{
              (
                category.data.name ?? slugToTitle(category.data.slug)
              ).toLowerCase()
            }
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            Recevez nos dernières publications directement dans votre boîte
            email.
          </p>
          <form class="flex flex-col md:flex-row gap-4 max-w-md mx-auto">
            <input
              type="email"
              placeholder="Votre adresse email"
              class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red border border-gray-300"
              required
            />
            <button
              type="submit"
              class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors"
            >
              S'abonner
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
