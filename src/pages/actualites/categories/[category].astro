
---
import MainLayout from '../../../layouts/MainLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import ArticlePagination from '../../../components/ArticlePagination.astro';
import { getLiveCollection } from 'astro:content';

const { category } = Astro.params;

// Get current page from URL parameters
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);

const { entries: allPosts, error } = await getLiveCollection('posts');
if (error) {
  console.error(`Error loading posts: ${error.message}`);
}

// Fonction pour convertir le nom de catégorie en slug
function categoryToSlug(categoryName: string): string {
  return categoryName
    .toLowerCase()
    .replace(/[àáâãäå]/g, 'a')
    .replace(/[èéêë]/g, 'e')
    .replace(/[ìíîï]/g, 'i')
    .replace(/[òóôõö]/g, 'o')
    .replace(/[ùúûü]/g, 'u')
    .replace(/[ç]/g, 'c')
    .replace(/[ñ]/g, 'n')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim('-');
}

const allCategories = allPosts 
  ? [...new Set(allPosts.flatMap(post => {
      const categories = [];
      if (post.data.category) categories.push(post.data.category);
      if (post.data.categories) categories.push(...post.data.categories);
      return categories;
    }).filter(Boolean))]
  : [];

// Configuration des catégories avec couleurs par défaut
const categoryConfig = allCategories.reduce((config, categoryName) => {
  const slug = categoryToSlug(categoryName);
  
  // Couleurs et icônes par défaut selon le type de catégorie
  let bgGradient = 'from-gray-600 to-gray-800';
  let icon = 'document';
  
  if (categoryName.toLowerCase().includes('communiqué') || categoryName.toLowerCase().includes('presse')) {
    bgGradient = 'from-yam-red to-red-800';
    icon = 'edit';
  } else if (categoryName.toLowerCase().includes('yam') || categoryName.toLowerCase().includes('presse')) {
    bgGradient = 'from-gray-600 to-gray-800';
    icon = 'newspaper';
  } else if (categoryName.toLowerCase().includes('tribune')) {
    bgGradient = 'from-blue-600 to-blue-800';
    icon = 'microphone';
  } else if (categoryName.toLowerCase().includes('média') || categoryName.toLowerCase().includes('video')) {
    bgGradient = 'from-purple-600 to-purple-800';
    icon = 'video';
  } else if (categoryName.toLowerCase().includes('appel') || categoryName.toLowerCase().includes('offre')) {
    bgGradient = 'from-green-600 to-green-800';
    icon = 'document';
  }
  
  config[slug] = {
    title: categoryName,
    description: `Découvrez tous les articles de la catégorie ${categoryName.toLowerCase()}.`,
    filterValue: categoryName,
    bgGradient,
    icon
  };
  
  return config;
}, {} as Record<string, any>);

// Vérifier si la catégorie existe
const currentCategory = categoryConfig[category];
if (!currentCategory) {
  return Astro.redirect('/actualites');
}

// Filtrer les articles par catégorie
const allFilteredArticles = allPosts 
  ? allPosts
    .filter(post => 
      post.data.category === currentCategory.filterValue || 
      post.data.categories?.includes(currentCategory.filterValue)
    )
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  : [];

// Pagination setup
const articlesPerPage = 9;
const totalArticles = allFilteredArticles.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;

// Apply pagination to filtered articles
const filteredArticles = allFilteredArticles
  .slice(startIndex, endIndex)
  .map(post => ({
    id: post.data.id,
    title: post.data.title,
    excerpt: post.data.excerpt || post.data.content.slice(0, 150) + '...',
    date: post.data.date,
    category: post.data.category,
    categories: post.data.categories || [],
    image: post.data.image,
    url: `/actualites/${post.data.slug}`,
  }));

// Calculer le nombre d'articles pour chaque catégorie
const categoryCounts = allPosts ? Object.entries(categoryConfig).reduce((counts, [slug, config]) => {
  const count = allPosts.filter(post => 
    post.data.category === config.filterValue || 
    post.data.categories?.includes(config.filterValue)
  ).length;
  counts[slug] = count;
  return counts;
}, {} as Record<string, number>) : {};

// Fonction pour obtenir l'icône SVG
function getIcon(iconName: string) {
  const icons = {
    edit: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />`,
    newspaper: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 01-2-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />`,
    microphone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />`,
    video: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`,
    document: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`
  };
  return icons[iconName] || icons.document;
}
---

<MainLayout title={`${currentCategory.title} - Y'EN A MARRE`} currentPath={`/actualites/categories/${category}`}>
  <!-- Hero Section -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/yem.jpg')] bg-cover bg-center"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-yam-red/70 to-red-800/70"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <div class="flex justify-center mb-6">
          <div class="bg-white/20 backdrop-blur-sm p-4 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <Fragment set:html={getIcon(currentCategory.icon)} />
            </svg>
          </div>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">{currentCategory.title}</h1>
        <p class="text-xl text-gray-100">
          {currentCategory.description}
        </p>
        <div class="mt-8">
          <span class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium">
            {totalArticles} article{totalArticles > 1 ? 's' : ''} trouvé{totalArticles > 1 ? 's' : ''}
          </span>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Navigation rapide -->
  <section class="py-8 bg-white">
    <div class="container-custom">
      <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/actualites" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Toutes les actualités ({allPosts?.length || 0})
          </a>
          {Object.entries(categoryConfig).map(([slug, config]) => (
            <a 
              href={`/actualites/categories/${slug}`} 
              class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                category === slug 
                  ? slug === 'communique-de-presse' ? 'bg-yam-red text-white' :
                    slug === 'yen-a-marre' ? 'bg-gray-600 text-white' :
                    slug === 'tribune-libre' ? 'bg-blue-600 text-white' :
                    slug === 'medias' ? 'bg-purple-600 text-white' :
                    'bg-green-600 text-white'
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
            >
              {config.title} ({categoryCounts[slug] || 0})
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Liste des articles -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      {filteredArticles.length > 0 ? (
        <>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {filteredArticles.map((article) => (
              <NewsCard 
                title={article.title}
                excerpt={article.excerpt}
                date={article.date}
                category={article.category}
                categories={article.categories}
                image={article.image}
                url={article.url}
              />
            ))}
          </div>
          
          {totalPages > 1 && (
            <ArticlePagination
              currentPage={currentPage}
              totalPages={totalPages}
              startIndex={startIndex}
              endIndex={endIndex}
              totalArticles={totalArticles}
              basePath={`/actualites/categories/${category}`}
            />
          )}
        </>
      ) : (
        <div class="text-center py-16">
          <div class="bg-gray-100 rounded-full w-24 h-24 flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Aucun article trouvé</h3>
          <p class="text-gray-600 mb-8">
            Il n'y a actuellement aucun article dans cette catégorie. Revenez bientôt pour découvrir nos nouvelles publications.
          </p>
          <a href="/actualites" class="inline-flex items-center px-6 py-3 bg-yam-red text-white font-medium rounded-lg hover:bg-red-700 transition-colors">
            Voir toutes les actualités
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-16 bg-gray-100">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto bg-white/80 backdrop-blur-md p-8 rounded-xl shadow-lg border border-gray-100">
        <div class="text-center">
          <h2 class="text-3xl font-bold mb-6">Restez informé de nos {currentCategory.title.toLowerCase()}</h2>
          <p class="text-lg text-gray-600 mb-8">
            Recevez nos dernières publications directement dans votre boîte email.
          </p>
          
          <form class="flex flex-col md:flex-row gap-4">
            <input 
              type="email" 
              placeholder="Votre adresse email" 
              class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red border border-gray-300"
              required
            />
            <button 
              type="submit" 
              class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors"
            >
              S'abonner
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
