
---
import MainLayout from '../../layouts/MainLayout.astro';

// Données pour les appels d'offres
const appelsDoffres = [
  {
    id: 1,
    title: "Appel d'offres : Consultant en communication digitale",
    excerpt: "Y'EN A MARRE recherche un consultant spécialisé en communication digitale pour renforcer sa présence en ligne.",
    date: "2023-06-25",
    deadline: "2023-07-15",
    category: "Consulting",
    status: "Ouvert",
    image: "/placeholder.svg?height=400&width=600&query=Digital communication consultant",
    url: "/actualites/appel-offres-consultant-communication-digitale",
    budget: "2 000 000 FCFA"
  },
  {
    id: 2,
    title: "Recrutement : Coordinateur de projets",
    excerpt: "Poste de coordinateur de projets pour superviser les programmes de développement communautaire de Y'EN A MARRE.",
    date: "2023-06-10",
    deadline: "2023-07-01",
    category: "Emploi",
    status: "Ouvert",
    image: "/placeholder.svg?height=400&width=600&query=Project coordinator job",
    url: "/actualites/recrutement-coordinateur-projets",
    budget: "Salaire selon profil"
  },
  {
    id: 3,
    title: "Appel à candidatures : Résidence artistique Karibu",
    excerpt: "Karibu lance un appel à candidatures pour sa résidence artistique destinée aux artistes engagés.",
    date: "2023-05-15",
    deadline: "2023-06-30",
    category: "Résidence",
    status: "Clôturé",
    image: "/placeholder.svg?height=400&width=600&query=Artist residency application",
    url: "/actualites/appel-candidatures-residence-artistique",
    budget: "Bourse de 1 500 000 FCFA"
  }
];
---

<MainLayout title="Appels d'offres - Y'EN A MARRE" currentPath="/actualites/appels-offres">
  <!-- Hero Section -->
  <section class="relative py-20 bg-gradient-to-br from-orange-900 to-orange-700 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Appels d'offres</h1>
        <p class="text-xl text-gray-100">
          Découvrez nos opportunités d'emploi, de consultation et de collaboration avec Y'EN A MARRE et ses projets.
        </p>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Navigation rapide -->
  <section class="py-8 bg-white">
    <div class="container-custom">
      <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/actualites" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Toutes les actualités
          </a>
          <a href="/actualites/communiques-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Communiqués de presse
          </a>
          <a href="/actualites/yam-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            YAM dans la presse
          </a>
          <a href="/actualites/tribune-libre" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Tribune libre
          </a>
          <a href="/actualites/medias" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Médias
          </a>
          <a href="/actualites/appels-offres" class="px-4 py-2 rounded-full text-sm font-medium bg-orange-600 text-white">
            Appels d'offres
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Filtres par statut -->
  <section class="py-8">
    <div class="container-custom">
      <div class="flex flex-wrap gap-4 justify-center">
        <button class="px-6 py-3 bg-orange-600 text-white rounded-lg font-medium">
          Tous les appels
        </button>
        <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
          Ouverts
        </button>
        <button class="px-6 py-3 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition-colors">
          Clôturés
        </button>
      </div>
    </div>
  </section>
  
  <!-- Liste des appels d'offres -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {appelsDoffres.map((appel) => (
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <img src={appel.image} alt={appel.title} class="w-full h-48 object-cover" />
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class={`text-xs font-semibold px-2.5 py-0.5 rounded ${
                  appel.status === 'Ouvert' 
                    ? 'bg-green-100 text-green-800' 
                    : 'bg-red-100 text-red-800'
                }`}>
                  {appel.status}
                </span>
                <span class="text-gray-500 text-sm">{appel.date}</span>
              </div>
              <h3 class="text-xl font-bold mb-3 line-clamp-2">{appel.title}</h3>
              <p class="text-gray-600 mb-4 line-clamp-3">{appel.excerpt}</p>
              
              <div class="space-y-2 mb-4 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-500">Catégorie:</span>
                  <span class="font-medium">{appel.category}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Date limite:</span>
                  <span class="font-medium">{appel.deadline}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Budget:</span>
                  <span class="font-medium">{appel.budget}</span>
                </div>
              </div>
              
              <a href={appel.url} class="w-full bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-4 rounded-lg transition-colors text-center block">
                Voir les détails
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Alerte email -->
  <section class="py-16 bg-orange-50">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-6">Recevez les nouveaux appels d'offres</h2>
        <p class="text-lg text-gray-600 mb-8">
          Inscrivez-vous pour être alerté des nouvelles opportunités dès leur publication.
        </p>
        
        <form class="flex flex-col md:flex-row gap-4">
          <input 
            type="email" 
            placeholder="Votre adresse email" 
            class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-600 border border-gray-300"
            required
          />
          <button 
            type="submit" 
            class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-6 rounded-lg transition-colors"
          >
            S'abonner aux alertes
          </button>
        </form>
      </div>
    </div>
  </section>
</MainLayout>
