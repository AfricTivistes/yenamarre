
---
import MainLayout from '../../layouts/MainLayout.astro';

// Données pour YAM dans la presse
const yamPresse = [
  {
    id: 1,
    title: "Y'EN A MARRE dans Le Soleil : Un mouvement qui marque l'histoire",
    excerpt: "Le quotidien national Le Soleil revient sur l'impact de Y'EN A MARRE dans le paysage politique sénégalais.",
    date: "2023-06-18",
    category: "YAM dans la presse",
    image: "/placeholder.svg?height=400&width=600&query=Newspaper article about activism",
    url: "/actualites/yam-le-soleil-mouvement-histoire",
    source: "Le Soleil"
  },
  {
    id: 2,
    title: "Interview exclusive sur RFM : L'avenir de l'engagement citoyen",
    excerpt: "Les leaders de Y'EN A MARRE s'expriment sur RFM à propos de l'avenir de l'engagement citoyen au Sénégal.",
    date: "2023-05-25",
    category: "YAM dans la presse",
    image: "/placeholder.svg?height=400&width=600&query=Radio interview microphone",
    url: "/actualites/interview-rfm-engagement-citoyen",
    source: "RFM"
  },
  {
    id: 3,
    title: "Sud Quotidien : Y'EN A MARRE, 12 ans de lutte pour la démocratie",
    excerpt: "Sud Quotidien dresse le bilan des 12 années d'activisme de Y'EN A MARRE pour la promotion de la démocratie.",
    date: "2023-05-10",
    category: "YAM dans la presse",
    image: "/placeholder.svg?height=400&width=600&query=Democracy activism newspaper",
    url: "/actualites/sud-quotidien-12-ans-lutte-democratie",
    source: "Sud Quotidien"
  }
];
---

<MainLayout title="Y'EN A MARRE dans la presse - Y'EN A MARRE" currentPath="/actualites/yam-presse">
  <!-- Hero Section -->
  <section class="relative py-20 bg-gradient-to-br from-blue-900 to-blue-700 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Y'EN A MARRE dans la presse</h1>
        <p class="text-xl text-gray-100">
          Découvrez comment les médias couvrent nos actions et notre engagement pour la démocratie et la bonne gouvernance.
        </p>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Navigation rapide -->
  <section class="py-8 bg-white">
    <div class="container-custom">
      <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-xl p-6 -mt-16 relative z-20 border border-gray-100">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/actualites" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Toutes les actualités
          </a>
          <a href="/actualites/communiques-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Communiqués de presse
          </a>
          <a href="/actualites/yam-presse" class="px-4 py-2 rounded-full text-sm font-medium bg-blue-600 text-white">
            YAM dans la presse
          </a>
          <a href="/actualites/tribune-libre" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Tribune libre
          </a>
          <a href="/actualites/medias" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Médias
          </a>
          <a href="/actualites/appels-offres" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
            Appels d'offres
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Liste des articles de presse -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {yamPresse.map((article) => (
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <img src={article.image} alt={article.title} class="w-full h-48 object-cover" />
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">
                  {article.source}
                </span>
                <span class="text-gray-500 text-sm">{article.date}</span>
              </div>
              <h3 class="text-xl font-bold mb-3 line-clamp-2">{article.title}</h3>
              <p class="text-gray-600 mb-4 line-clamp-3">{article.excerpt}</p>
              <a href={article.url} class="text-blue-600 font-medium hover:text-blue-800 transition-colors">
                Lire l'article →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
