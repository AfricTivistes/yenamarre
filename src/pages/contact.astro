
---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact - Y'EN A MARRE" currentPath="/contact">
  <!-- Hero Section avec image de fond -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1577563908411-5077b6dc7624?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-yam-red/90 to-red-800/80"></div>
    
    <div class="container-custom relative z-10">
      <div class="text-center text-white">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-fade-in">
          Contactez-nous
        </h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed opacity-90">
          Votre voix compte ! Rejoignez le mouvement ou partagez vos idées pour un Sénégal meilleur.
        </p>
        <div class="mt-8 flex justify-center space-x-4">
          <div class="bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full">
            <span class="text-sm font-medium">📞 Ligne directe ouverte</span>
          </div>
          <div class="bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full">
            <span class="text-sm font-medium">💬 Réponse sous 24h</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section principale de contact -->
  <section class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Informations de contact -->
        <div class="lg:col-span-1">
          <div class="sticky top-8">
            <h2 class="text-3xl font-bold mb-8 text-yam-red">Restons en contact</h2>
            
            <div class="space-y-6">
              <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all group">
                <div class="flex items-start space-x-4">
                  <div class="bg-yam-red rounded-full p-3 text-white group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-bold text-gray-800">Adresse</h3>
                    <p class="text-gray-600">123 Rue de la Démocratie<br>Dakar, Sénégal</p>
                    <a href="#" class="text-yam-red text-sm hover:underline mt-1 inline-block">📍 Voir sur la carte</a>
                  </div>
                </div>
              </div>
              
              <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all group">
                <div class="flex items-start space-x-4">
                  <div class="bg-blue-600 rounded-full p-3 text-white group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-bold text-gray-800">Email</h3>
                    <p class="text-gray-600">contact@yenamarre.sn</p>
                    <a href="mailto:contact@yenamarre.sn" class="text-blue-600 text-sm hover:underline mt-1 inline-block">✉️ Envoyer un email</a>
                  </div>
                </div>
              </div>
              
              <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all group">
                <div class="flex items-start space-x-4">
                  <div class="bg-green-600 rounded-full p-3 text-white group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-bold text-gray-800">Téléphone</h3>
                    <p class="text-gray-600">+221 12 345 6789</p>
                    <a href="tel:+22112345678" class="text-green-600 text-sm hover:underline mt-1 inline-block">📞 Appeler maintenant</a>
                  </div>
                </div>
              </div>
              
              <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all group">
                <div class="flex items-start space-x-4">
                  <div class="bg-purple-600 rounded-full p-3 text-white group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-bold text-gray-800">Heures d'ouverture</h3>
                    <p class="text-gray-600">Lundi - Vendredi: 9h - 17h<br>Samedi: 9h - 13h</p>
                    <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full mt-1">🟢 Ouvert maintenant</span>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Réseaux sociaux -->
            <div class="mt-8 bg-white p-6 rounded-xl shadow-lg">
              <h3 class="text-lg font-bold mb-4 text-gray-800">Suivez-nous</h3>
              <div class="grid grid-cols-2 gap-3">
                <a href="#" class="flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg transition-colors group">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
                  </svg>
                  <span class="text-sm font-medium">Facebook</span>
                </a>
                <a href="#" class="flex items-center space-x-2 bg-sky-500 hover:bg-sky-600 text-white p-3 rounded-lg transition-colors group">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                  </svg>
                  <span class="text-sm font-medium">Twitter</span>
                </a>
                <a href="#" class="flex items-center space-x-2 bg-pink-600 hover:bg-pink-700 text-white p-3 rounded-lg transition-colors group">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                  <span class="text-sm font-medium">Instagram</span>
                </a>
                <a href="#" class="flex items-center space-x-2 bg-red-600 hover:bg-red-700 text-white p-3 rounded-lg transition-colors group">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                  </svg>
                  <span class="text-sm font-medium">YouTube</span>
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Formulaire et carte -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Formulaire de contact -->
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <div class="flex items-center space-x-3 mb-6">
              <div class="bg-yam-red rounded-full p-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-800">Envoyez-nous un message</h2>
            </div>
            
            <form class="space-y-6">
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Nom complet *</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red focus:border-transparent transition-all"
                    placeholder="Votre nom et prénom"
                    required
                  />
                </div>
                
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red focus:border-transparent transition-all"
                    placeholder="votre@email.com"
                    required
                  />
                </div>
              </div>
              
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Téléphone</label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red focus:border-transparent transition-all"
                    placeholder="+221 XX XXX XX XX"
                  />
                </div>
                
                <div>
                  <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">Sujet *</label>
                  <select 
                    id="subject" 
                    name="subject" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red focus:border-transparent transition-all"
                    required
                  >
                    <option value="">Choisir un sujet</option>
                    <option value="adhesion">Adhésion au mouvement</option>
                    <option value="collaboration">Collaboration/Partenariat</option>
                    <option value="media">Demande média</option>
                    <option value="suggestion">Suggestion</option>
                    <option value="autre">Autre</option>
                  </select>
                </div>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message *</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="6" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red focus:border-transparent transition-all resize-none"
                  placeholder="Votre message..."
                  required
                ></textarea>
              </div>
              
              <div class="flex items-start space-x-3">
                <input 
                  type="checkbox" 
                  id="consent" 
                  name="consent" 
                  class="mt-1 h-4 w-4 text-yam-red focus:ring-yam-red border-gray-300 rounded"
                  required
                />
                <label for="consent" class="text-sm text-gray-600">
                  J'accepte que mes données personnelles soient utilisées pour traiter ma demande. <a href="#" class="text-yam-red hover:underline">Politique de confidentialité</a>
                </label>
              </div>
              
              <button 
                type="submit" 
                class="w-full bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-6 rounded-lg transition-all hover:scale-105 hover:shadow-lg flex items-center justify-center space-x-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                <span>Envoyer le message</span>
              </button>
            </form>
          </div>
          
          <!-- Carte interactive -->
          <div class="bg-white p-6 rounded-xl shadow-lg">
            <h3 class="text-xl font-bold mb-4 flex items-center space-x-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span>Notre localisation</span>
            </h3>
            <div class="bg-gray-200 h-64 rounded-lg flex items-center justify-center relative overflow-hidden">
              <!-- Carte simulée avec iframe Google Maps -->
              <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3858.6896994834284!2d-17.46777068577773!3d14.716677989726899!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xec10c6b1d4e6e1d%3A0x6f5c1a0b0a3b0c1b!2sDakar%2C%20S%C3%A9n%C3%A9gal!5e0!3m2!1sfr!2sfr!4v1640000000000!5m2!1sfr!2sfr" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                class="rounded-lg">
              </iframe>
              <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-2 rounded-lg shadow-lg">
                <p class="text-sm font-medium text-gray-800">📍 Dakar, Sénégal</p>
              </div>
            </div>
            <div class="mt-4 flex justify-between items-center">
              <p class="text-sm text-gray-600">123 Rue de la Démocratie, Dakar</p>
              <a href="https://maps.google.com" target="_blank" class="text-yam-red hover:underline text-sm font-medium flex items-center space-x-1">
                <span>Ouvrir dans Maps</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section FAQ rapide -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800 mb-4">Questions fréquentes</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Retrouvez ici les réponses aux questions les plus posées par nos visiteurs.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-gray-50 p-6 rounded-xl hover:shadow-lg transition-all">
          <h3 class="font-bold text-lg mb-3 text-yam-red">Comment rejoindre Y'EN A MARRE ?</h3>
          <p class="text-gray-600 text-sm">Vous pouvez nous contacter via ce formulaire ou participer à nos événements publics.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl hover:shadow-lg transition-all">
          <h3 class="font-bold text-lg mb-3 text-yam-red">Organisez-vous des formations ?</h3>
          <p class="text-gray-600 text-sm">Oui, nous proposons des formations civiques et des ateliers de sensibilisation.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl hover:shadow-lg transition-all">
          <h3 class="font-bold text-lg mb-3 text-yam-red">Comment soutenir vos actions ?</h3>
          <p class="text-gray-600 text-sm">Plusieurs moyens existent : bénévolat, dons, partage de nos contenus, participation aux événements.</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
