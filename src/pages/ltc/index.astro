---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="La Télé Citoyenne (LTC) - La Télé Citoyenne" currentPath="/ltc">
  <!-- Hero Section avec design moderne -->
  <section class="relative min-h-[80vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Overlay pattern -->
    <div class="absolute inset-0 opacity-10 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] bg-repeat"></div>
    
    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-6">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            <span class="text-white">La Télé Citoyenne</span>
            <span class="block mt-2">La Télé Citoyenne</span>
          </h1>
          
          <p class="text-xl md:text-2xl text-gray-300 mt-6">
            Un média alternatif créé par Y'EN A MARRE pour diffuser ses messages et promouvoir l'engagement citoyen.
          </p>
          
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/ltc/programmes" class="btn bg-black border-2 border-white hover:bg-white hover:text-black transition-colors py-4 px-8 text-lg rounded-lg">
              Nos Programmes
            </a>
            <a href="/a-propos/ltc" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
              En savoir plus
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="bg-white rounded-lg p-6 shadow-2xl transform hover:rotate-1 transition-transform">
            <img 
              src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-ltc-8W4L2tgdjU72mMqlBWEQghrV3Vj7Z1.png" 
              alt="La Télé Citoyenne (LTC)" 
              class="w-full h-auto"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-black text-white px-6 py-3 rounded-lg font-bold shadow-lg">
            Média Citoyen
          </div>
        </div>
      </div>
    </div>
    
    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- About Section avec design moderne -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="overflow-hidden rounded-lg shadow-xl">
          <img 
            src="/placeholder.svg?height=600&width=800&query=African TV studio with young reporters" 
            alt="LTC Studio" 
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="space-y-6">
          <h2 class="text-3xl md:text-4xl font-bold">Notre Mission</h2>
          <p class="text-lg text-gray-600">
            La Télé Citoyenne (LTC) est un média alternatif créé par Y'EN A MARRE pour diffuser ses messages et promouvoir l'engagement citoyen à travers des programmes télévisés et des contenus numériques.
          </p>
          <p class="text-lg text-gray-600">
            Notre mission est d'informer, d'éduquer et de mobiliser les citoyens, en particulier les jeunes, sur les questions de démocratie, de bonne gouvernance et d'engagement civique.
          </p>
          <div class="pt-4">
            <a href="/a-propos/ltc" class="btn-secondary border-2 border-black hover:bg-black hover:text-white transition-colors inline-flex items-center py-3 px-6 rounded-lg">
              En savoir plus
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Programs Section avec design moderne -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Nos Programmes Phares</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Découvrez les programmes emblématiques de La Télé Citoyenne (LTC) pour promouvoir l'engagement citoyen et la bonne gouvernance.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow border-t-4 border-black">
          <div class="text-center mb-6">
            <div class="bg-black text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Dox Mbokk</h3>
          </div>
          <p class="text-gray-600 mb-6 text-center">
            Programme de discussion sur les questions de gouvernance et de démocratie au Sénégal. Des experts et des citoyens débattent des enjeux actuels.
          </p>
        </div>
        
        <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow border-t-4 border-black">
          <div class="text-center mb-6">
            <div class="bg-black text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Sama Kaddu</h3>
          </div>
          <p class="text-gray-600 mb-6 text-center">
            Programme donnant la parole aux jeunes sur les questions qui les concernent. Une plateforme d'expression pour la jeunesse sénégalaise.
          </p>
        </div>
        
        <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow border-t-4 border-black">
          <div class="text-center mb-6">
            <div class="bg-black text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Le Carré</h3>
          </div>
          <p class="text-gray-600 mb-6 text-center">
            Débats entre experts sur les questions politiques, économiques et sociales. Un espace de réflexion et d'analyse approfondie.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Latest Productions Section avec design moderne -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Dernières Productions</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez nos dernières productions vidéo et contenus multimédias.
          </p>
        </div>
        <a href="/ltc/productions" class="text-black font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center">
          Voir toutes les productions
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card overflow-hidden group bg-white shadow-lg rounded-lg">
          <div class="relative h-48">
            <img 
              src="/placeholder.svg?height=400&width=600&query=African community meeting" 
              alt="Dox Mbokk : La gouvernance locale" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="bg-black rounded-full p-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="absolute top-0 left-0 bg-black text-white px-3 py-1 text-sm font-medium">
              Dox Mbokk
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">La gouvernance locale</h3>
            <p class="text-gray-600 mb-4">
              Discussion sur la gouvernance locale et le rôle des citoyens dans la gestion des affaires publiques.
            </p>
            <a href="/ltc/productions/dox-mbokk-gouvernance-locale" class="text-black font-medium hover:underline flex items-center">
              Regarder
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="card overflow-hidden group bg-white shadow-lg rounded-lg">
          <div class="relative h-48">
            <img 
              src="/placeholder.svg?height=400&width=600&query=African youth employment discussion" 
              alt="Sama Kaddu : Les jeunes et l'emploi" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="bg-black rounded-full p-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="absolute top-0 left-0 bg-black text-white px-3 py-1 text-sm font-medium">
              Sama Kaddu
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Les jeunes et l'emploi</h3>
            <p class="text-gray-600 mb-4">
              Les jeunes s'expriment sur les défis de l'emploi au Sénégal et proposent des solutions.
            </p>
            <a href="/ltc/productions/sama-kaddu-jeunes-emploi" class="text-black font-medium hover:underline flex items-center">
              Regarder
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="card overflow-hidden group bg-white shadow-lg rounded-lg">
          <div class="relative h-48">
            <img 
              src="/placeholder.svg?height=400&width=600&query=African election debate panel" 
              alt="Le Carré : Démocratie et élections" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="bg-black rounded-full p-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="absolute top-0 left-0 bg-black text-white px-3 py-1 text-sm font-medium">
              Le Carré
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Démocratie et élections</h3>
            <p class="text-gray-600 mb-4">
              Débat entre experts sur la démocratie et les élections au Sénégal et en Afrique.
            </p>
            <a href="/ltc/productions/le-carre-democratie-elections" class="text-black font-medium hover:underline flex items-center">
              Regarder
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- YouTube Channel avec design moderne -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2 class="text-3xl md:text-4xl font-bold">Notre chaîne YouTube</h2>
          <p class="text-lg text-gray-600">
            Suivez-nous sur YouTube pour ne manquer aucune de nos productions. Abonnez-vous à notre chaîne pour être informé de nos dernières vidéos.
          </p>
          <div class="flex items-center space-x-4">
            <a href="#" class="inline-flex items-center bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
              </svg>
              S'abonner
            </a>
            <span class="text-gray-600">5.2K abonnés</span>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-lg shadow-xl aspect-video">
          <iframe 
            width="100%" 
            height="100%" 
            src="/placeholder.svg?height=400&width=600&query=YouTube video player with African content" 
            title="YouTube video player" 
            style="border: 0;" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            class="absolute inset-0"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Call to Action avec design moderne -->
  <section class="py-16 bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] opacity-10"></div>
    <div class="container-custom text-center relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Devenez Reporter Citoyen</h2>
      <p class="text-lg max-w-3xl mx-auto mb-8">
        Rejoignez notre équipe de Jeunes Reporters Citoyens (JRC) pour contribuer à la promotion de la démocratie et de la bonne gouvernance à travers le journalisme citoyen.
      </p>
      <a href="/ltc/jeunes-reporters-citoyens" class="btn bg-white text-black hover:bg-gray-100 transform transition-transform hover:scale-105 py-3 px-6 rounded-lg">En savoir plus</a>
    </div>
  </section>
</MainLayout>