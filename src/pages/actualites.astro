
---
import MainLayout from '../layouts/MainLayout.astro';
import NewsCard from '../components/NewsCard.astro';

// Actualité principale (à la une)
const featuredNews = {
  id: 1,
  title: "Manifestation pour la démocratie à Dakar",
  excerpt: "Plus de 1000 personnes se sont réunies à Dakar pour manifester en faveur de la démocratie et contre la corruption. Cette mobilisation historique marque un tournant dans l'engagement citoyen au Sénégal.",
  date: "2023-06-15",
  category: "Y'EN A MARRE",
  image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=600&fit=crop",
  url: "/actualites/manifestation-democratie-dakar"
};

// Articles récents (tous types confondus)
const recentNews = [
  {
    id: 1,
    title: "Manifestation pour la démocratie à Dakar",
    excerpt: "Plus de 1000 personnes se sont réunies à Dakar pour manifester en faveur de la démocratie et contre la corruption.",
    date: "2023-06-15",
    category: "Y'EN A MARRE",
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop",
    url: "/actualites/manifestation-democratie-dakar"
  },
  {
    id: 8,
    title: "Nouveau partenariat avec l'Union Européenne",
    excerpt: "Y'EN A MARRE signe un accord de partenariat stratégique avec l'UE pour renforcer la démocratie.",
    date: "2023-06-12",
    category: "Communiqué de presse",
    image: "https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop",
    url: "/actualites/partenariat-union-europeenne"
  },
  {
    id: 9,
    title: "Atelier de formation des jeunes leaders",
    excerpt: "Formation de 50 jeunes leaders dans les régions de Thiès et Kaolack sur le leadership démocratique.",
    date: "2023-06-10",
    category: "Y'EN A MARRE",
    image: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=400&h=300&fit=crop",
    url: "/actualites/formation-jeunes-leaders"
  },
  {
    id: 10,
    title: "Podcast : Dialogue sur la gouvernance",
    excerpt: "Nouvelle série de podcasts sur les enjeux de gouvernance avec des experts nationaux et internationaux.",
    date: "2023-06-08",
    category: "Médias",
    image: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&h=300&fit=crop",
    url: "/actualites/podcast-gouvernance"
  },
  {
    id: 11,
    title: "Tribune : Pour une jeunesse engagée",
    excerpt: "Réflexion sur l'importance de l'engagement citoyen chez les jeunes sénégalais d'aujourd'hui.",
    date: "2023-06-05",
    category: "Tribune libre",
    image: "https://images.unsplash.com/photo-1529390079861-591de354faf5?w=400&h=300&fit=crop",
    url: "/actualites/tribune-jeunesse-engagee"
  },
  {
    id: 12,
    title: "Campagne de sensibilisation électorale",
    excerpt: "Lancement d'une vaste campagne de sensibilisation des citoyens sur l'importance du vote.",
    date: "2023-06-03",
    category: "Y'EN A MARRE",
    image: "https://images.unsplash.com/photo-1540910419892-4a36d2c3266c?w=400&h=300&fit=crop",
    url: "/actualites/campagne-sensibilisation-electorale"
  }
];

// Paramètres de pagination
const articlesPerPage = 6;
const currentPage = 1;
const totalArticles = recentNews.length;
const totalPages = Math.ceil(totalArticles / articlesPerPage);
const startIndex = (currentPage - 1) * articlesPerPage;
const endIndex = startIndex + articlesPerPage;
const paginatedNews = recentNews.slice(startIndex, endIndex);

// Actualités par catégorie
const newsByCategory = {
  "communiques-presse": [
    {
      id: 2,
      title: "Position officielle sur les réformes électorales",
      excerpt: "Y'EN A MARRE exprime sa position sur les récentes propositions de réformes du système électoral sénégalais.",
      date: "2023-06-10",
      category: "Communiqué de presse",
      image: "https://images.unsplash.com/photo-1586339949916-3e9457bef6d3?w=400&h=300&fit=crop",
      url: "/actualites/position-reformes-electorales"
    },
    {
      id: 3,
      title: "Appel à la transparence budgétaire",
      excerpt: "Le mouvement demande plus de transparence dans la gestion des finances publiques.",
      date: "2023-05-28",
      category: "Communiqué de presse",
      image: "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=400&h=300&fit=crop",
      url: "/actualites/appel-transparence-budgetaire"
    }
  ],
  "yam-presse": [
    {
      id: 4,
      title: "Y'EN A MARRE dans Le Quotidien",
      excerpt: "Interview exclusive de nos dirigeants sur les enjeux démocratiques actuels.",
      date: "2023-06-08",
      category: "YAM dans la presse",
      image: "https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=400&h=300&fit=crop",
      url: "/actualites/interview-quotidien"
    },
    {
      id: 5,
      title: "Reportage RTS sur nos actions",
      excerpt: "La télévision nationale couvre nos dernières initiatives citoyennes.",
      date: "2023-05-25",
      category: "YAM dans la presse",
      image: "https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=400&h=300&fit=crop",
      url: "/actualites/reportage-rts"
    }
  ],
  "medias": [
    {
      id: 6,
      title: "Documentaire : 12 ans d'activisme",
      excerpt: "Découvrez notre parcours à travers un documentaire retraçant 12 années d'engagement.",
      date: "2023-06-05",
      category: "Médias",
      image: "https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?w=400&h=300&fit=crop",
      url: "/actualites/documentaire-12-ans"
    },
    {
      id: 7,
      title: "Galerie photos : Marche citoyenne",
      excerpt: "Revivez en images la dernière marche citoyenne organisée à Dakar.",
      date: "2023-05-20",
      category: "Médias",
      image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop",
      url: "/actualites/galerie-marche-citoyenne"
    }
  ]
};

// Catégories avec leurs couleurs et icônes
const categories = [
  {
    id: "communiques-presse",
    title: "Communiqués de presse",
    description: "Nos positions officielles et déclarations publiques",
    color: "bg-red-600",
    icon: "📢",
    url: "/actualites/communiques-presse"
  },
  {
    id: "yam-presse",
    title: "YAM dans la presse",
    description: "Notre couverture médiatique",
    color: "bg-blue-600",
    icon: "📰",
    url: "/actualites/yam-presse"
  },
  {
    id: "medias",
    title: "Médias",
    description: "Documentaires, photos et vidéos",
    color: "bg-purple-600",
    icon: "🎥",
    url: "/actualites/medias"
  }
];
---

<MainLayout title="Actualités - Y'EN A MARRE" currentPath="/actualites">
  <!-- Hero Section avec actualité à la une -->
  <section class="relative min-h-[80vh] bg-gray-900 overflow-hidden">
    <!-- Image de fond -->
    <div class="absolute inset-0">
      <img 
        src={featuredNews.image} 
        alt={featuredNews.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>
    </div>
    
    <!-- Content -->
    <div class="container-custom relative z-10 h-full flex items-center py-20">
      <div class="max-w-2xl text-white">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yam-red text-white mb-4">
          À la une
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          {featuredNews.title}
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-200 mb-8 leading-relaxed">
          {featuredNews.excerpt}
        </p>
        
        <div class="flex flex-wrap items-center gap-6 mb-8">
          <time class="text-gray-300" datetime={featuredNews.date}>
            {new Date(featuredNews.date).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span class="w-2 h-2 bg-yam-red rounded-full"></span>
          <span class="text-yam-red font-medium">{featuredNews.category}</span>
        </div>
        
        <a 
          href={featuredNews.url} 
          class="inline-flex items-center bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30 group"
        >
          Lire l'article complet
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
    
    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>
  
  <!-- Articles récents -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Articles récents</h2>
          <p class="text-xl text-gray-600 max-w-2xl">
            Découvrez nos dernières publications et prises de position.
          </p>
        </div>
        <a 
          href="/actualites/tous-les-articles" 
          class="text-yam-red font-bold text-lg hover:underline mt-4 md:mt-0 group flex items-center"
        >
          Voir tous les articles
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
      
      <!-- Grille des articles -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {paginatedNews.map((article) => (
          <article class="group">
            <a href={article.url} class="block">
              <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                <div class="relative h-48 overflow-hidden">
                  <img 
                    src={article.image} 
                    alt={article.title} 
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yam-red text-white">
                      {article.category}
                    </span>
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                <div class="p-6">
                  <time datetime={article.date} class="text-sm text-gray-500">
                    {new Date(article.date).toLocaleDateString('fr-FR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <h3 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors line-clamp-2">
                    {article.title}
                  </h3>
                  <p class="text-gray-600 mb-4 line-clamp-3">{article.excerpt}</p>
                  <div class="flex justify-end">
                    <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
      
      <!-- Pagination -->
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="text-gray-600 mb-4 md:mb-0">
          Affichage de {startIndex + 1} à {Math.min(endIndex, totalArticles)} sur {totalArticles} articles
        </div>
        
        <div class="flex items-center space-x-2">
          <!-- Bouton précédent -->
          <button 
            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
            disabled={currentPage === 1}
          >
            Précédent
          </button>
          
          <!-- Numéros de page -->
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <button 
              class={`px-4 py-2 rounded-lg transition-colors ${
                page === currentPage 
                  ? 'bg-yam-red text-white' 
                  : 'border border-gray-300 text-gray-600 hover:bg-gray-50'
              }`}
            >
              {page}
            </button>
          ))}
          
          <!-- Bouton suivant -->
          <button 
            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
            disabled={currentPage === totalPages}
          >
            Suivant
          </button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Catégories d'actualités en blocs -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Nos actualités par catégorie</h2>
        <p class="text-xl text-gray-600">
          Explorez nos différents types de contenus pour rester informé de toutes nos activités et prises de position.
        </p>
      </div>
      
      <!-- Grille des catégories -->
      <div class="space-y-16">
        {categories.map((category) => (
          <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
            <!-- En-tête de catégorie -->
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
              <div class="flex items-center space-x-4 mb-4 md:mb-0">
                <div class={`w-16 h-16 ${category.color} rounded-xl flex items-center justify-center text-2xl`}>
                  {category.icon}
                </div>
                <div>
                  <h3 class="text-2xl md:text-3xl font-bold">{category.title}</h3>
                  <p class="text-gray-600 mt-1">{category.description}</p>
                </div>
              </div>
              <a 
                href={category.url} 
                class="inline-flex items-center text-yam-red font-bold hover:underline group"
              >
                Voir tout
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            
            <!-- Articles de la catégorie -->
            <div class="grid md:grid-cols-2 gap-6">
              {newsByCategory[category.id]?.map((news) => (
                <article class="group">
                  <a href={news.url} class="block">
                    <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
                      <div class="relative h-48 overflow-hidden">
                        <img 
                          src={news.image} 
                          alt={news.title} 
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                      </div>
                      <div class="p-6">
                        <time datetime={news.date} class="text-sm text-gray-500">
                          {new Date(news.date).toLocaleDateString('fr-FR', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                          })}
                        </time>
                        <h4 class="text-xl font-bold mt-2 mb-3 group-hover:text-yam-red transition-colors">
                          {news.title}
                        </h4>
                        <p class="text-gray-600 mb-4">{news.excerpt}</p>
                        <div class="flex justify-end">
                          <span class="text-yam-red font-medium group-hover:underline">Lire la suite →</span>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Autres catégories en liens rapides -->
  <section class="py-16 bg-gray-900 text-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Plus d'actualités</h2>
        <p class="text-xl text-gray-300">Découvrez tous nos contenus</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/actualites/tribune-libre" class="group bg-white/10 backdrop-blur-sm rounded-xl p-6 hover:bg-white/20 transition-all">
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="text-xl">💬</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Tribune libre</h3>
          <p class="text-gray-300">Espace d'expression libre de nos membres et sympathisants.</p>
        </a>
        
        <a href="/actualites/appels-offres" class="group bg-white/10 backdrop-blur-sm rounded-xl p-6 hover:bg-white/20 transition-all">
          <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="text-xl">💼</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Appels d'offres</h3>
          <p class="text-gray-300">Opportunités d'emploi et de collaboration avec nos projets.</p>
        </a>
        
        <a href="/actualites" class="group bg-yam-red rounded-xl p-6 hover:bg-red-700 transition-all md:col-span-2 lg:col-span-1">
          <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="text-xl">📰</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Toutes les actualités</h3>
          <p class="text-white/90">Accédez à l'ensemble de nos contenus et actualités.</p>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-16 bg-gray-100 relative overflow-hidden">
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto bg-white rounded-2xl p-8 shadow-lg">
        <div class="text-center">
          <h2 class="text-3xl font-bold mb-6">Restez informé</h2>
          <p class="text-lg text-gray-600 mb-8">
            Inscrivez-vous à notre newsletter pour recevoir les dernières actualités et informations sur nos campagnes.
          </p>
          
          <form class="flex flex-col md:flex-row gap-4">
            <input 
              type="email" 
              placeholder="Votre adresse email" 
              class="flex-grow px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-yam-red border border-gray-300"
              required
            />
            <button 
              type="submit" 
              class="bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-colors transform hover:scale-105"
            >
              S'inscrire
            </button>
          </form>
          
          <p class="text-sm mt-4 text-gray-500">
            En vous inscrivant, vous acceptez de recevoir nos emails et confirmez avoir lu notre politique de confidentialité.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
