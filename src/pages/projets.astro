---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectDetailCard from '../components/ProjectDetailCard.astro';

const projets = [
  {
    title: "Dox ak Sa Gox",
    description: "Marcher avec sa communauté : un projet pour mobiliser et renforcer la participation citoyenne, en soutenant le contrôle citoyen de l’action publique et la reddition des comptes à travers des formations, des jurys citoyens et des mobilisations populaires.",
    logo: "/images/doxaksagox.jpg",
    bgGradient: "bg-gradient-to-br from-green-600 to-green-800",
    buttonColor: "bg-green-600",
    buttonHoverColor: "hover:bg-green-700",
    url: "/dox-ak-sa-gox",
    features: [
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>',
        text: "Mobilisations populaires"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>',
        text: "Formations citoyennes"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
        text: "Jurys citoyens"
      }
    ]
  },
  {
    title: "La Télé Citoyenne (LTC)",
    description: "La télé citoyenne qui informe, éduque et mobilise les citoyens à travers des programmes télévisés innovants et des contenus numériques engagés.",
    logo: "/images/logo-ltc.jpeg",
    bgGradient: "bg-gradient-to-br from-gray-900 to-black",
    buttonColor: "bg-black",
    buttonHoverColor: "hover:bg-gray-800",
    url: "#",
    features: [
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>',
        text: "Programmes TV et contenus digitaux"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>',
        text: "Formation de Jeunes Reporters Citoyens"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2M7 4h10M7 4L5.05 5.95A1 1 0 005 6.364V19a1 1 0 001 1h12a1 1 0 001-1V6.364a1 1 0 00-.05-.414L17 4M9 12h6" /></svg>',
        text: "Débats et analyses politiques"
      }
    ]
  },
  {
    title: "Citizen Mic",
    description: "Un lieu où s'expriment librement opinions, visions et solutions, pour faire naître un mouvement collectif de changement positif.",
    logo: "/images/citizenMic.jpeg",
    bgGradient: "bg-gradient-to-br from-gray-700 to-gray-900",
    buttonColor: "bg-gray-800",
    buttonHoverColor: "hover:bg-gray-700",
    url: "#",
    features: [
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>',
        text: "Expression citoyenne"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>',
        text: "Partage de solutions"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
        text: "Mobilisation collective"
      }
    ]
  },
  {
    title: "Karibu",
    description: "Résidences artistiques et mobilités citoyennes qui promeuvent l'engagement artistique et citoyen à travers des échanges culturels et éducatifs.",
