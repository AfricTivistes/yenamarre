    bgGradient: "bg-gradient-to-br from-karibu-green to-green-700",
    buttonColor: "bg-karibu-green",
    buttonHoverColor: "hover:bg-green-700",
    url: "https://www.karibu.yenamarre.sn/",
    features: [
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-karibu-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0 9c0 5 0 5 0 5s0 0 0-5m0 9c-5 0-9-4-9-9s4-9 9-9m0 9c0-5 0-5 0-5s0 0 0 5" /></svg>',
        text: "Mobilités citoyennes régionales"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-karibu-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z" /></svg>',
        text: "Résidences artistiques"
      },
      {
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-karibu-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>',
        text: "Production de savoir et connaissances"
      }
    ]
  }
];
---

<MainLayout title="Nos Projets - Y'EN A MARRE" currentPath="/projets">
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10 bg-[url('/images/hero-bg.jpg')] bg-cover bg-center"></div>

    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="text-white text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Nos <span class="text-yam-red">Projets</span>
        </h1>

        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto">
          Découvrez les différentes initiatives de Y'EN A MARRE pour promouvoir la démocratie, la bonne gouvernance et l'engagement civique.
        </p>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
        {projets.map((projet) => (
          <ProjectDetailCard {...projet} />
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Impact de nos projets</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Ensemble, nos projets créent un écosystème complet pour le développement démocratique et citoyen.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div class="bg-yam-red text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Sensibilisation</h3>
          <p class="text-gray-600">Formation et sensibilisation de milliers de jeunes citoyens engagés</p>
        </div>

        <div class="text-center p-6">
          <div class="bg-karibu-green text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0 9c0 5 0 5 0 5s0 0 0-5m0 9c-5 0-9-4-9-9s4-9 9-9m0 9c0-5 0-5 0-5s0 0 0 5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Mobilisation</h3>
          <p class="text-gray-600">Mobilisation citoyenne à travers l'art, la culture et les médias</p>
        </div>

        <div class="text-center p-6">
          <div class="bg-black text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 000 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Transformation</h3>
          <p class="text-gray-600">Changement positif dans la gouvernance et la participation citoyenne</p>
        </div>
      </div>
    </div>
  </section>

</MainLayout>