
---
import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ProjectNavbar from '../../components/ProjectNavbar.astro';

const navItems = [
  { name: 'Accueil', href: '/yenamarre', current: true },
  { name: 'Histoire', href: '/yenamarre/histoire' },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination' },
  { name: 'Réseaux', href: '/yenamarre/reseaux' },
];
---

<MainLayout title="Y'EN A MARRE - Mouvement citoyen sénégalais" currentPath="/yenamarre">
  <!-- Navigation du projet -->
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section modernisé -->
  <section class="relative min-h-[80vh] bg-gradient-to-br from-black via-gray-900 to-yam-red overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=800&width=1600&query=African protest movement with signs and flags')] bg-cover bg-center opacity-20"></div>
    
    <div class="container-custom relative z-10 h-full flex items-center py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center w-full">
        <div class="text-white space-y-8">
          <div class="space-y-4">
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
              Y'EN A <span class="text-yam-red">MARRE</span>
            </h1>
            <div class="w-24 h-1 bg-yam-red"></div>
          </div>
          
          <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
            Un mouvement citoyen qui transforme la société sénégalaise depuis 2011, 
            en mobilisant la jeunesse pour la démocratie et la bonne gouvernance.
          </p>
          
          <div class="flex flex-wrap gap-6">
            <a href="/rejoindre" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-4 px-8 text-lg rounded-lg transition-all hover:shadow-lg hover:shadow-red-500/30 transform hover:scale-105">
              Rejoignez-nous
            </a>
            <a href="/yenamarre/histoire" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
              Notre histoire
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20">
            <img 
              src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp" 
              alt="Y'EN A MARRE Logo" 
              class="w-full max-w-sm mx-auto"
            />
            <div class="absolute -top-4 -right-4 bg-yam-red text-white px-6 py-3 rounded-lg font-bold shadow-lg animate-pulse">
              Depuis 2011
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Vision & Mission Section -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Notre Vision & Mission</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Construire une société sénégalaise démocratique, transparente et participative où chaque citoyen peut exercer pleinement ses droits.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="bg-gradient-to-r from-yam-red to-red-600 p-8 rounded-2xl text-white">
            <h3 class="text-2xl font-bold mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              Notre Vision
            </h3>
            <p class="text-lg leading-relaxed">
              Un Sénégal où la jeunesse est actrice du changement social et politique, 
              où la démocratie est effective et où la bonne gouvernance est la norme.
            </p>
          </div>
          
          <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-yam-red">
            <h3 class="text-2xl font-bold mb-4 flex items-center text-gray-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Notre Mission
            </h3>
            <p class="text-lg text-gray-700 leading-relaxed">
              Mobiliser, éduquer et organiser la société civile, particulièrement les jeunes, 
              pour promouvoir la démocratie participative, la bonne gouvernance et l'engagement citoyen.
            </p>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src="/placeholder.svg?height=600&width=800&query=Young African activists discussing democracy" 
            alt="Vision Y'EN A MARRE" 
            class="w-full h-auto rounded-2xl shadow-2xl"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-2xl"></div>
        </div>
      </div>
      
      <div class="mt-12 text-center">
        <a href="/yenamarre/vision-mission" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg transition-all inline-flex items-center">
          En savoir plus sur notre vision
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Nos Combats Section -->
  <section class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] opacity-10"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Nos Combats</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-300 max-w-4xl mx-auto">
          Depuis 2011, nous menons des combats concrets pour transformer la société sénégalaise.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Démocratie Participative</h3>
          <p class="text-gray-300 leading-relaxed">
            Promouvoir une démocratie où chaque citoyen peut participer activement aux décisions qui l'concernent.
          </p>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Lutte contre la Corruption</h3>
          <p class="text-gray-300 leading-relaxed">
            Combattre la corruption sous toutes ses formes et promouvoir la transparence dans la gestion publique.
          </p>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Engagement Jeunesse</h3>
          <p class="text-gray-300 leading-relaxed">
            Mobiliser et former les jeunes pour qu'ils deviennent des acteurs du changement social et politique.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Initiatives Section améliorée -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">Nos Initiatives Phares</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Découvrez nos programmes concrets qui transforment les communautés à travers tout le Sénégal.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2 group">
          <div class="h-48 bg-cover bg-center relative overflow-hidden" style="background-image: url('https://images.unsplash.com/photo-1559027615-cd4628902d4a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');">
            <div class="absolute inset-0 bg-gradient-to-t from-yam-red/80 to-yam-red/40"></div>
            <div class="absolute bottom-4 left-4 text-white">
              <div class="bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-medium">
                Gouvernance Locale
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-yam-red transition-colors">Dox Ak Sa Gox</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              Programme de promotion de la gouvernance locale et de l'engagement citoyen au niveau des quartiers et communes.
            </p>
            <a href="/projets/dox-ak-sa-gox" class="text-yam-red font-medium hover:underline flex items-center">
              Découvrir le programme
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2 group">
          <div class="h-48 bg-cover bg-center relative overflow-hidden" style="background-image: url('https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');">
            <div class="absolute inset-0 bg-gradient-to-t from-blue-600/80 to-blue-600/40"></div>
            <div class="absolute bottom-4 left-4 text-white">
              <div class="bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-medium">
                Culture Hip-Hop
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-yam-red transition-colors">Citizen Mic</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              Formation de rappeurs et artistes sur la citoyenneté et l'engagement civique à travers la culture hip-hop.
            </p>
            <a href="/projets/citizen-mic" class="text-yam-red font-medium hover:underline flex items-center">
              Découvrir le programme
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2 group">
          <div class="h-48 bg-cover bg-center relative overflow-hidden" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');">
            <div class="absolute inset-0 bg-gradient-to-t from-green-600/80 to-green-600/40"></div>
            <div class="absolute bottom-4 left-4 text-white">
              <div class="bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-medium">
                Formation Civique
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-3 group-hover:text-yam-red transition-colors">Éducation Civique</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              Programmes de formation et sensibilisation pour renforcer la culture démocratique et civique des citoyens.
            </p>
            <a href="/projets/education-civique" class="text-yam-red font-medium hover:underline flex items-center">
              Découvrir le programme
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coordination Section -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">Coordination Nationale</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Une organisation structurée et décentralisée qui assure la coordination des actions sur l'ensemble du territoire national.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordination Centrale</h3>
              <p class="text-gray-600">Basée à Dakar, elle assure la direction stratégique et la coordination générale du mouvement.</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordinations Régionales</h3>
              <p class="text-gray-600">Présentes dans les 14 régions du Sénégal pour adapter les actions aux réalités locales.</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordinations Locales</h3>
              <p class="text-gray-600">Au niveau des communes et quartiers pour un ancrage territorial fort et une action de proximité.</p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold mb-6 text-center">Structure Organisationnelle</h3>
          <div class="space-y-4">
            <div class="bg-white p-4 rounded-lg border-l-4 border-yam-red">
              <h4 class="font-bold">Assemblée Générale</h4>
              <p class="text-sm text-gray-600">Organe suprême de décision</p>
            </div>
            <div class="bg-white p-4 rounded-lg border-l-4 border-yam-red">
              <h4 class="font-bold">Coordination Nationale</h4>
              <p class="text-sm text-gray-600">Direction exécutive du mouvement</p>
            </div>
            <div class="bg-white p-4 rounded-lg border-l-4 border-yam-red">
              <h4 class="font-bold">Commissions Thématiques</h4>
              <p class="text-sm text-gray-600">Groupes de travail spécialisés</p>
            </div>
          </div>
          
          <div class="mt-6 text-center">
            <a href="/yenamarre/coordination" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-all">
              Découvrir l'organisation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Actualités Section -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="flex justify-between items-center mb-12">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold mb-4 text-yam-red">Actualités Y'EN A MARRE</h2>
          <p class="text-xl text-gray-600">Suivez nos dernières actions et campagnes</p>
        </div>
        <a href="/actualites?category=yenamarre" class="text-yam-red font-bold hover:underline group flex items-center">
          Toutes les actualités
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <NewsCard 
          title="Manifestation pour la démocratie à Dakar" 
          excerpt="Plus de 1000 personnes se sont réunies à Dakar pour manifester en faveur de la démocratie et contre la corruption."
          date="2023-06-15"
          category="Y'EN A MARRE"
          image="/placeholder.svg?height=400&width=600&query=African protest in Dakar"
          url="/actualites/manifestation-democratie-dakar"
        />
        
        <NewsCard 
          title="Lancement du programme Dox Ak Sa Gox" 
          excerpt="Y'EN A MARRE lance un nouveau programme pour promouvoir la gouvernance locale et l'engagement citoyen."
          date="2023-05-22"
          category="Projets"
          image="/placeholder.svg?height=400&width=600&query=Community meeting in Senegal"
          url="/actualites/lancement-dox-ak-sa-gox"
        />
        
        <NewsCard 
          title="Conférence sur la démocratie en Afrique" 
          excerpt="Y'EN A MARRE organise une conférence sur la démocratie en Afrique avec des intervenants de plusieurs pays."
          date="2023-04-05"
          category="Événements"
          image="/placeholder.svg?height=400&width=600&query=Conference on democracy in Africa"
          url="/actualites/conference-democratie-afrique"
        />
      </div>
    </div>
  </section>

  <!-- Call to Action final -->
  <section class="py-20 bg-gradient-to-r from-yam-red to-red-700 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern dots')] opacity-10"></div>
    <div class="container-custom text-center relative z-10">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Rejoignez le Changement</h2>
      <p class="text-xl max-w-3xl mx-auto mb-8 text-red-100">
        Ensemble, nous pouvons construire un Sénégal plus démocratique, plus juste et plus prospère. 
        Votre engagement compte, votre voix compte.
      </p>
