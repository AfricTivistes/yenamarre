---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectNavbar from '../../components/ProjectNavbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjets } from '../../utils/wp-contenus';
import { getPageAcf, field } from '../../utils/wp';

// Textes éditables dans WordPress (page « Qui sommes-nous », slug `qui-sommes-nous`).
// Champ vide ou WordPress injoignable → texte par défaut ci-dessous.
const TEXTES: Record<string, string> = {
  hero_titre: "Y'EN A MARRE",
  hero_sous_titre: "Le mouvement citoyen du Sénégal",
  hero_texte: "Depuis 2011, Y'EN A MARRE lutte pour la démocratie, la bonne gouvernance et l'engagement civique au Sénégal.",
  hero_bouton1: "Notre Vision",
  hero_bouton2: "Notre Histoire",
  hero_badge: "Depuis 2011",
  vision_titre: "Notre Vision & Mission",
  vision_intro: "Construire une société sénégalaise démocratique, transparente et participative où chaque citoyen peut exercer pleinement ses droits.",
  vision_sous_titre: "Notre Vision",
  vision_texte: "Un Sénégal où la jeunesse est actrice du changement social et politique, où la démocratie est effective et où la bonne gouvernance est la norme.",
  mission_sous_titre: "Notre Mission",
  mission_texte: "Mobiliser, éduquer et organiser la société civile, particulièrement les jeunes, pour promouvoir la démocratie participative, la bonne gouvernance et l'engagement citoyen.",
  vision_image: "/images/yem_sign.webp",
  valeurs_titre: "Nos Valeurs Fondamentales",
  valeurs_intro: "Les principes qui guident notre action et notre engagement quotidien.",
  valeur1_titre: "Intégrité",
  valeur1_texte: "Agir avec honnêteté, transparence et cohérence dans toutes nos actions.",
  valeur2_titre: "Solidarité",
  valeur2_texte: "Construire des liens forts entre citoyens pour un engagement collectif.",
  valeur3_titre: "Justice",
  valeur3_texte: "Lutter pour l'égalité, l'équité et le respect des droits de tous.",
  valeur4_titre: "Innovation",
  valeur4_texte: "Adopter des approches créatives pour relever les défis de notre époque.",
  combats_titre: "Nos Combats",
  combats_intro: "Depuis 2011, nous menons des combats concrets pour transformer la société sénégalaise.",
  combat1_titre: "Nouveau Type de Sénégalais",
  combat1_texte: "Promouvoir une nouvelle citoyenneté axée sur la justice, l'équité et le progrès social.",
  combat2_titre: "Plan Daas Fanaanal",
  combat2_texte: "Inciter les jeunes à s'inscrire sur les listes électorales pour l'élection présidentielle de 2011",
  combat3_titre: "Faux pas Forcé",
  combat3_texte: "s'oppose à la troisième candidature d'Abdoulaye Wade avec le programme 'Doggali'.",
  projets_titre: "Nos Projets Phares",
  projets_intro: "Découvrez nos programmes concrets qui transforment les communautés à travers tout le Sénégal.",
  organisation_titre: "Structure Organisationnelle",
  organisation_intro: "Y'EN A MARRE s'organise selon un modèle démocratique et participatif qui garantit la représentativité et l'efficacité de l'action.",
  organigramme_image: "/images/organigramme_yem.png",
  organigramme_legende: "Structure organisationnelle de Y'EN A MARRE",
};
const textesWp = await getPageAcf('qui-sommes-nous');
const t = (key: string): string => field(textesWp, key, TEXTES[key]);

const navItems = [
  { name: 'Accueil', href: '/yenamarre', current: true },
  { name: 'Histoire', href: '/yenamarre/histoire' },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination' },
  { name: 'Réseaux', href: '/yenamarre/reseaux' },
];

const cmsProjects = await getProjets();
---

<MainLayout title="Y'EN A MARRE - Mouvement citoyen sénégalais" currentPath="/yenamarre">
  <!-- Navigation du projet -->
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section avec design moderne -->
  <section class="relative min-h-[80vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Image d'arrière-plan -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/fpf.webp');"></div>

    <!-- Overlay sombre pour la lisibilité -->
    <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-black/60"></div>

    <!-- Overlay pattern -->
    <div class="absolute inset-0 opacity-5 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] bg-repeat"></div>

    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-6">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-yam-red">
            {t('hero_titre')}
            <span class="block text-white text-3xl md:text-4xl mt-2">{t('hero_sous_titre')}</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-300">
            {t('hero_texte')}
          </p>

          <div class="flex flex-wrap gap-4 mt-8">
            <a href="#vision" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 transform transition-all hover:scale-105 py-3 px-6 rounded-lg" >
              {t('hero_bouton1')}
            </a>
            <a href="/yenamarre/historique" class="btn bg-yam-red text-white hover:bg-red-700 transform transition-all hover:scale-105 hover:shadow-lg py-3 px-6 rounded-lg" >
              {t('hero_bouton2')}
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="bg-white rounded-full p-8 shadow-2xl mx-auto max-w-xs md:max-w-sm transform transition-transform hover:rotate-3">
            <img 
              src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp" 
              alt="Y'EN A MARRE" 
              class="w-full h-auto"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-yam-red text-white px-6 py-3 rounded-lg font-bold shadow-lg">
            {t('hero_badge')}
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Vision & Mission Section -->
  <section id="vision" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">{t('vision_titre')}</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          {t('vision_intro')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">        

          <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-yam-red">
            <h3 class="text-2xl font-bold mb-4 flex items-center text-gray-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              {t('vision_sous_titre')}
            </h3>
            <p class="text-lg text-gray-700 leading-relaxed">
              {t('vision_texte')}
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-yam-red">
            <h3 class="text-2xl font-bold mb-4 flex items-center text-gray-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              {t('mission_sous_titre')}
            </h3>
            <p class="text-lg text-gray-700 leading-relaxed">
              {t('mission_texte')}
            </p>
          </div>
        </div>

        <div class="relative">
          <img 
            src={t('vision_image')} 
            alt="Vision Y'EN A MARRE" 
            class="w-full h-auto rounded-2xl shadow-2xl"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-2xl"></div>
        </div>
      </div>
    </div>

    <div class="mt-10 container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">{t('valeurs_titre')}</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('valeurs_intro')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t('valeur1_titre')}</h3>
          <p class="text-gray-600">
            {t('valeur1_texte')}
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t('valeur2_titre')}</h3>
          <p class="text-gray-600">
            {t('valeur2_texte')}
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t('valeur3_titre')}</h3>
          <p class="text-gray-600">
            {t('valeur3_texte')}
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t('valeur4_titre')}</h3>
          <p class="text-gray-600">
            {t('valeur4_texte')}
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Nos Combats Section -->
  <section class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] opacity-10"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">{t('combats_titre')}</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-300 max-w-4xl mx-auto">
          {t('combats_intro')}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">{t('combat1_titre')}</h3>
          <p class="text-gray-300 leading-relaxed">
            {t('combat1_texte')}
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">{t('combat2_titre')}</h3>
          <p class="text-gray-300 leading-relaxed">
            {t('combat2_texte')}
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">{t('combat3_titre')}</h3>
          <p class="text-gray-300 leading-relaxed">
            {t('combat3_texte')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Initiatives Section améliorée -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">{t('projets_titre')}</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          {t('projets_intro')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {cmsProjects.map((projet) => (
          <ProjectCard
            title={projet.title}
            description={projet.description}
            image={projet.logo}
            url={projet.url || '#'}
            isExternal={projet.url ? projet.url.startsWith('http') : false}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Structure Organisationnelle -->
  <section id="organisation" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">{t('organisation_titre')}</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('organisation_intro')}
        </p>
      </div>

      <!-- Organigramme -->
      <div class="max-w-6xl mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8 overflow-hidden">
          <img 
            src={t('organigramme_image')} 
            alt="Organigramme Y'EN A MARRE - Structure organisationnelle du mouvement" 
            class="w-full h-auto object-contain rounded-xl transition-transform hover:scale-105"
          />
          <div class="mt-6 text-center">
            <p class="text-sm text-gray-600 italic">
              {t('organigramme_legende')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coordination Section -->
  <!--section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">Coordination Nationale</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Une organisation structurée et décentralisée qui assure la coordination des actions sur l'ensemble du territoire national.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
