---
import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ProjectNavbar from '../../components/ProjectNavbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const navItems = [
  { name: 'Accueil', href: '/yenamarre', current: true },
  { name: 'Histoire', href: '/yenamarre/histoire' },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination' },
  { name: 'Réseaux', href: '/yenamarre/reseaux' },
];
---

<MainLayout title="Y'EN A MARRE - Mouvement citoyen sénégalais" currentPath="/yenamarre">
  <!-- Navigation du projet -->
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section avec design moderne -->
  <section class="relative min-h-[80vh] bg-gradient-to-br from-gray-900 to-black overflow-hidden">
    <!-- Image d'arrière-plan -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/fpf.webp');"></div>

    <!-- Overlay sombre pour la lisibilité -->
    <div class="absolute inset-0 bg-gradient-to-br from-black/80 via-black/70 to-black/60"></div>

    <!-- Overlay pattern -->
    <div class="absolute inset-0 opacity-5 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] bg-repeat"></div>

    <!-- Content -->
    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-6">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-yam-red">
            Y'EN A MARRE
            <span class="block text-white text-3xl md:text-4xl mt-2">Le mouvement citoyen du Sénégal</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-300">
            Depuis 2011, Y'EN A MARRE lutte pour la démocratie, la bonne gouvernance et l'engagement civique au Sénégal.
          </p>

          <div class="flex flex-wrap gap-4 mt-8">
            <a href="#vision" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 transform transition-all hover:scale-105 py-3 px-6 rounded-lg" >
              Notre Vision
            </a>
            <a href="/yenamarre/historique" class="btn bg-yam-red text-white hover:bg-red-700 transform transition-all hover:scale-105 hover:shadow-lg py-3 px-6 rounded-lg" >
              Notre Histoire
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="bg-white rounded-full p-8 shadow-2xl mx-auto max-w-xs md:max-w-sm transform transition-transform hover:rotate-3">
            <img 
              src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp" 
              alt="Y'EN A MARRE" 
              class="w-full h-auto"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-yam-red text-white px-6 py-3 rounded-lg font-bold shadow-lg">
            Depuis 2011
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Vision & Mission Section -->
  <section id="vision" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Notre Vision & Mission</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Construire une société sénégalaise démocratique, transparente et participative où chaque citoyen peut exercer pleinement ses droits.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">        

          <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-yam-red">
            <h3 class="text-2xl font-bold mb-4 flex items-center text-gray-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              Notre Vision
            </h3>
            <p class="text-lg text-gray-700 leading-relaxed">
              Un Sénégal où la jeunesse est actrice du changement social et politique, où la démocratie est effective et où la bonne gouvernance est la norme.
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-yam-red">
            <h3 class="text-2xl font-bold mb-4 flex items-center text-gray-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-yam-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Notre Mission
            </h3>
            <p class="text-lg text-gray-700 leading-relaxed">
              Mobiliser, éduquer et organiser la société civile, particulièrement les jeunes, 
              pour promouvoir la démocratie participative, la bonne gouvernance et l'engagement citoyen.
            </p>
          </div>
        </div>

        <div class="relative">
          <img 
            src="/images/yem_sign.webp" 
            alt="Vision Y'EN A MARRE" 
            class="w-full h-auto rounded-2xl shadow-2xl"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-2xl"></div>
        </div>
      </div>
    </div>

    <div class="mt-10 container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Nos Valeurs Fondamentales</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Les principes qui guident notre action et notre engagement quotidien.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Intégrité</h3>
          <p class="text-gray-600">
            Agir avec honnêteté, transparence et cohérence dans toutes nos actions.
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Solidarité</h3>
          <p class="text-gray-600">
            Construire des liens forts entre citoyens pour un engagement collectif.
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Justice</h3>
          <p class="text-gray-600">
            Lutter pour l'égalité, l'équité et le respect des droits de tous.
          </p>
        </div>

        <div class="text-center group">
          <div class="bg-yam-red rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Innovation</h3>
          <p class="text-gray-600">
            Adopter des approches créatives pour relever les défis de notre époque.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Nos Combats Section -->
  <section class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/placeholder.svg?height=600&width=1200&query=Abstract pattern red and black')] opacity-10"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Nos Combats</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-300 max-w-4xl mx-auto">
          Depuis 2011, nous menons des combats concrets pour transformer la société sénégalaise.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Nouveau Type de Sénégalais</h3>
          <p class="text-gray-300 leading-relaxed">
            Promouvoir une nouvelle citoyenneté axée sur la justice, l'équité et le progrès social.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Plan Daas Fanaanal</h3>
          <p class="text-gray-300 leading-relaxed">
            Inciter les jeunes à s'inscrire sur les listes électorales pour l'élection présidentielle de 2011
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-2xl border border-white/20 hover:bg-white/20 transition-all hover:-translate-y-2">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Faux pas Forcé</h3>
          <p class="text-gray-300 leading-relaxed">
            s'oppose à la troisième candidature d'Abdoulaye Wade avec le programme 'Doggali'.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Initiatives Section améliorée -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">Nos Initiatives Phares</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Découvrez nos programmes concrets qui transforment les communautés à travers tout le Sénégal.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <ProjectCard 
          title="Citizen Mic" 
          description="Un lieu où s’expriment librement opinions, visions et solutions, pour faire naître un mouvement collectif de changement positif."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-yen-a-marre-99viuAdBsKGYkpE7Ox6BCY4aqAHYO1.webp"
          url=""
        />

        <ProjectCard 
          title="La Télé Citoyenne (LTC)" 
          description="La Télé Citoyenne, un média alternatif pour diffuser les messages du mouvement."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-ltc-8W4L2tgdjU72mMqlBWEQghrV3Vj7Z1.png"
          url="/ltc"
        />

        <ProjectCard 
          title="Karibu" 
          description="Résidences artistiques et mobilités citoyennes pour promouvoir l'engagement artistique et citoyen."
          image="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-karibu-fkSP6Sl0AUSZtdNJdL0POuaoH1uL4F.png"
          url="https://www.karibu.yenamarre.sn/"
        />
      </div>
    </div>
  </section>

  <!-- Structure Organisationnelle -->
  <section id="organisation" class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Structure Organisationnelle</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Y'EN A MARRE s'organise selon un modèle démocratique et participatif 
          qui garantit la représentativité et l'efficacité de l'action.
        </p>
      </div>

      <!-- Organigramme -->
      <div class="max-w-4xl mx-auto">
        <div class="space-y-8">
          <!-- Niveau 1: Assemblée Générale -->
          <div class="text-center">
            <div class="bg-yam-red text-white p-6 rounded-2xl shadow-lg max-w-md mx-auto">
              <div class="text-3xl mb-2">🏛️</div>
              <h3 class="text-xl font-bold mb-2">Assemblée Générale</h3>
              <p class="text-sm">Organe suprême de décision - Tous les 2 ans</p>
            </div>
          </div>

          <!-- Flèche vers le bas -->
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-yam-red mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>

          <!-- Niveau 2: Coordination Nationale -->
          <div class="text-center">
            <div class="bg-red-600 text-white p-6 rounded-2xl shadow-lg max-w-md mx-auto">
              <div class="text-3xl mb-2">🎯</div>
              <h3 class="text-xl font-bold mb-2">Coordination Nationale</h3>
              <p class="text-sm">Direction exécutive - 9 membres élus</p>
            </div>
          </div>

          <!-- Flèche vers le bas -->
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-yam-red mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>

          <!-- Niveau 3: Coordinations Régionales -->
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🗺️</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Régionales</h4>
              <p class="text-xs">14 régions du Sénégal</p>
            </div>
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🏘️</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Départementales</h4>
              <p class="text-xs">45 départements</p>
            </div>
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🏠</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Locales</h4>
              <p class="text-xs">Communes et quartiers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coordination Section -->
  <!--section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-yam-red">Coordination Nationale</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Une organisation structurée et décentralisée qui assure la coordination des actions sur l'ensemble du territoire national.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordination Centrale</h3>
              <p class="text-gray-600">Basée à Dakar, elle assure la direction stratégique et la coordination générale du mouvement.</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordinations Régionales</h3>
              <p class="text-gray-600">Présentes dans les 14 régions du Sénégal pour adapter les actions aux réalités locales.</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Coordinations Locales</h3>
              <p class="text-gray-600">Au niveau des communes et quartiers pour un ancrage territorial fort et une action de proximité.</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold mb-6 text-center">Structure Organisationnelle</h3>
          <div class="space-y-4">
            <div class="bg-white p-4 rounded-lg border-l-4 border-yam-red">
              <h4 class="font-bold">Assemblée Générale</h4>
              <p class="text-sm text-gray-600">Organe suprême de décision</p>
            </div>
            <div class="bg-white p-4 rounded-lg border-l-4 border-yam-red">
              <h4 class="font-bold">Coordination Nationale</h4>
              <p class="text-sm text-gray-600">Direction exécutive du mouvement</p>
            </div>
