---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectNavbar from "../../components/ProjectNavbar.astro";
import Timeline from "../../components/Timeline.astro";
import ImpactStats from "../../components/ImpactStats.astro";
import { getTimelineEvents } from "../../loaders/utils.ts";
import { getMembres } from "../../utils/wp-contenus";
import { getPageAcf, field } from '../../utils/wp';
import { getChiffresImpact } from '../../utils/stats';

// Textes éditables dans WordPress (page « Historique », slug `historique`).
// Champ vide ou WordPress injoignable → texte par défaut ci-dessous.
const TEXTES: Record<string, string> = {
  hero_titre: "Notre Histoire",
  hero_texte: "Depuis 2011, Y'EN A MARRE écrit l'histoire de l'engagement citoyen au Sénégal. Les moments clés qui ont marqué l'histoire de Y'EN A MARRE et son impact sur la société sénégalaise.",
  frise_titre: "Chronologie du Mouvement",
  impact_titre: "Notre Impact en Chiffres",
  impact_sous_titre: "Plus d'une décennie d'engagement au service de la démocratie et de la bonne gouvernance",
  heritage_titre: "Notre Héritage",
  heritage_texte: "Plus qu'un mouvement politique, Y'EN A MARRE a créé une nouvelle culture citoyenne au Sénégal. Nous avons démontré que la jeunesse peut être un acteur de changement positif et que l'engagement citoyen est la clé du développement.",
  heritage1_titre: "Éveil des consciences",
  heritage1_texte: "Nous avons éveillé la conscience politique de milliers de jeunes Sénégalais",
  heritage2_titre: "Nouveau modèle citoyen",
  heritage2_texte: "Le concept NTS (Nouveau Type de Sénégalais) inspire une nouvelle génération",
  heritage3_titre: "Rayonnement continental",
  heritage3_texte: "Notre modèle inspire des mouvements citoyens à travers l'Afrique",
  heritage_image: "/images/rassemblement2.webp",
  heritage_annee: "2011",
  heritage_annee_label: "Année de création",
};
const textesWp = await getPageAcf('historique');
const t = (key: string): string => field(textesWp, key, TEXTES[key]);

const navItems = [
  { name: 'Accueil', href: '/yenamarre' },
  { name: 'Histoire', href: '/yenamarre/historique', current: true },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination' },
  { name: 'Réseaux', href: '/yenamarre/reseaux' },
];

const timelineItems = await getTimelineEvents();

// Chiffres d'impact : page WordPress « Historique », repris aussi par l'accueil.
const impactStats = await getChiffresImpact();

const defaultFounders = [
  {
    name: "Thiat",
    role: "Rappeur et activiste",
    description: "Co-fondateur, figure emblématique du mouvement",
    image: "/images/groupe.webp"
  },
  {
    name: "Kilifeu", 
    role: "Rappeur et activiste",
    description: "Co-fondateur, voix de la jeunesse sénégalaise",
    image: "/images/groupe2.webp"
  },
  {
    name: "Fadel Barro",
    role: "Journaliste et coordinateur",
    description: "Co-fondateur, stratège du mouvement",
    image: "/images/yem1.webp"
  },
  {
    name: "Denise Sow",
    role: "Militante et activiste",
    description: "Figure féminine emblématique du mouvement",
    image: "/images/rassemblement1.webp"
  }
];

// Fondateurs gérés dans WordPress (menu Membres), repli sur la liste ci-dessus.
const founders = await getMembres("fondateur", defaultFounders);
---

<MainLayout title="Histoire de Y'EN A MARRE" currentPath="/yenamarre/historique">
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-br from-gray-900 to-yam-red text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/rassemblement1.webp')] opacity-10"></div>
    <div class="container-custom relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">{t('hero_titre')}</h1>
        <div class="w-24 h-1 bg-white mx-auto mb-8"></div>
        <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
          {t('hero_texte')}
        </p>
      </div>
    </div>
  </section>

  <!-- Section philosophie du mouvement >
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Une philosophie, un engagement</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          "Y'EN A MARRE" n'est pas seulement un nom, c'est un cri du cœur, une philosophie de vie. 
          Nous refusons la fatalité, nous rejetons la résignation et nous croyons fermement que 
          chaque citoyen a le pouvoir de changer les choses.
        </p>
        <blockquote class="text-2xl font-bold text-yam-red italic border-l-4 border-yam-red pl-6">
          "Il n'y a pas de destin forclos, il n'y a que des responsabilités désertées."
        </blockquote>
      </div>
    </div>
  </section-->
  
  <!-- Timeline Section -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">{t('frise_titre')}</h2>

      
      <Timeline items={timelineItems} accentColor="bg-yam-red" />
    </div>
  </section>
  
  <!-- Impact Stats -->
  <ImpactStats 
    stats={impactStats}
    title={t('impact_titre')}
    subtitle={t('impact_sous_titre')}
    accentColor="yam-red"
  />
  
  <!-- Fondateurs Section>
  <FoundersGallery 
    founders={founders}
    title="Nos Fondateurs"
    subtitle="Des personnalités engagées qui ont uni leurs forces pour créer un mouvement citoyen unique au Sénégal"
    accentColor="yam-red"
  / -->

  <!-- Section héritages et valeurs -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-4xl font-bold mb-6 text-yam-red">{t('heritage_titre')}</h2>
            <div class="w-16 h-1 bg-yam-red mb-6"></div>
          </div>
          
          <p class="text-lg text-gray-700 leading-relaxed">
            {t('heritage_texte')}
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-3 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">{t('heritage1_titre')}</h3>
                <p class="text-gray-700">
                  {t('heritage1_texte')}
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-3 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">{t('heritage2_titre')}</h3>
                <p class="text-gray-700">
                  {t('heritage2_texte')}
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-3 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">{t('heritage3_titre')}</h3>
                <p class="text-gray-700">
                  {t('heritage3_texte')}
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src={t('heritage_image')} 
            alt="Héritage Y'EN A MARRE" 
            class="w-full h-auto rounded-2xl shadow-2xl"
          />
          <div class="absolute -bottom-6 -right-6 bg-yam-red text-white p-6 rounded-lg shadow-lg">
            <div class="text-center">
              <div class="text-3xl font-bold">{t('heritage_annee')}</div>
              <div class="text-sm">{t('heritage_annee_label')}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
