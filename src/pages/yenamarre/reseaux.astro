
---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectNavbar from "../../components/ProjectNavbar.astro";

const navItems = [
  { name: 'Accueil', href: '/yenamarre' },
  { name: 'Histoire', href: '/yenamarre/histoire' },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination' },
  { name: 'Réseaux', href: '/yenamarre/reseaux', current: true },
];
---

<MainLayout title="Réseaux et Partenariats - Y'EN A MARRE" currentPath="/yenamarre/reseaux">
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-br from-yam-red via-red-600 to-red-800 text-white">
    <div class="container-custom">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Nos Réseaux & Partenariats</h1>
        <div class="w-24 h-1 bg-white mx-auto mb-8"></div>
        <p class="text-xl md:text-2xl text-red-100 leading-relaxed">
          Y'EN A MARRE s'inscrit dans une dynamique de collaboration et d'échanges 
          avec des organisations nationales, africaines et internationales 
          partageant nos valeurs démocratiques.
        </p>
      </div>
    </div>
  </section>

  <!-- Réseaux Africains -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Réseaux Panafricains</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Nous sommes membres actifs de plusieurs réseaux continentaux 
          qui œuvrent pour la démocratie et la bonne gouvernance en Afrique.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-green-50 to-green-100 p-8 rounded-2xl border-l-4 border-green-600 hover:shadow-lg transition-all">
          <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mb-6">
            <span class="text-white text-2xl font-bold">🌍</span>
          </div>
          <h3 class="text-xl font-bold mb-4 text-green-800">AFRICTIVISTES</h3>
          <p class="text-gray-700 mb-4">
            Réseau des mouvements citoyens africains pour la démocratie, 
            la paix et la bonne gouvernance.
          </p>
          <div class="text-sm text-green-700">
            <p><strong>Pays membres:</strong> 35+ pays africains</p>
            <p><strong>Fondé:</strong> 2017</p>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-8 rounded-2xl border-l-4 border-blue-600 hover:shadow-lg transition-all">
          <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mb-6">
            <span class="text-white text-2xl font-bold">⚖️</span>
          </div>
          <h3 class="text-xl font-bold mb-4 text-blue-800">WANEP</h3>
          <p class="text-gray-700 mb-4">
            West Africa Network for Peacebuilding - Réseau ouest-africain 
            pour la consolidation de la paix.
          </p>
          <div class="text-sm text-blue-700">
            <p><strong>Pays membres:</strong> 15 pays CEDEAO</p>
            <p><strong>Fondé:</strong> 1998</p>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-8 rounded-2xl border-l-4 border-orange-600 hover:shadow-lg transition-all">
          <div class="w-16 h-16 bg-orange-600 rounded-full flex items-center justify-center mb-6">
            <span class="text-white text-2xl font-bold">🗳️</span>
          </div>
          <h3 class="text-xl font-bold mb-4 text-orange-800">WAEON</h3>
          <p class="text-gray-700 mb-4">
            West Africa Election Observers Network - Réseau d'observateurs 
            électoraux de l'Afrique de l'Ouest.
          </p>
          <div class="text-sm text-orange-700">
            <p><strong>Missions:</strong> Observation électorale</p>
            <p><strong>Couverture:</strong> Afrique de l'Ouest</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partenaires Nationaux -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Partenaires Nationaux</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Au Sénégal, nous collaborons étroitement avec diverses organisations 
          de la société civile, institutions et médias.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div class="space-y-8">
          <div>
            <h3 class="text-2xl font-bold mb-6 text-yam-red">Organisations de la Société Civile</h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-yam-red rounded-full"></div>
                <span class="font-medium">CONGAD (Conseil des ONG d'Appui au Développement)</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-yam-red rounded-full"></div>
                <span class="font-medium">WILDAF/FeDDAF (Femmes en Droit et Développement en Afrique)</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-yam-red rounded-full"></div>
                <span class="font-medium">RADDHO (Rencontre Africaine pour la Défense des Droits de l'Homme)</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-yam-red rounded-full"></div>
                <span class="font-medium">Forum Civil</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="space-y-8">
          <div>
            <h3 class="text-2xl font-bold mb-6 text-yam-red">Médias Partenaires</h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
                <span class="font-medium">Dakaractu</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
                <span class="font-medium">Seneweb</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
                <span class="font-medium">Radio Futurs Médias (RFM)</span>
              </div>
              <div class="flex items-center space-x-4 p-4 bg-white rounded-lg shadow-sm">
                <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
                <span class="font-medium">Sud FM</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partenaires Internationaux -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Partenaires Internationaux</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Nos collaborations internationales renforcent notre capacité d'action 
          et nous permettent de partager nos expériences.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="bg-gradient-to-br from-purple-100 to-purple-200 p-6 rounded-2xl shadow-lg group-hover:shadow-xl transition-all mb-4">
            <div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-white text-2xl font-bold">🇪🇺</span>
            </div>
            <h3 class="text-lg font-bold text-purple-800 mb-2">Union Européenne</h3>
            <p class="text-purple-700 text-sm">Soutien aux programmes de gouvernance démocratique</p>
          </div>
        </div>
        
        <div class="text-center group">
          <div class="bg-gradient-to-br from-green-100 to-green-200 p-6 rounded-2xl shadow-lg group-hover:shadow-xl transition-all mb-4">
            <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-white text-2xl font-bold">🌍</span>
            </div>
            <h3 class="text-lg font-bold text-green-800 mb-2">Open Society Foundations</h3>
            <p class="text-green-700 text-sm">Promotion des sociétés ouvertes et démocratiques</p>
          </div>
        </div>
        
        <div class="text-center group">
          <div class="bg-gradient-to-br from-blue-100 to-blue-200 p-6 rounded-2xl shadow-lg group-hover:shadow-xl transition-all mb-4">
            <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-white text-2xl font-bold">🇺🇸</span>
            </div>
            <h3 class="text-lg font-bold text-blue-800 mb-2">USAID</h3>
            <p class="text-blue-700 text-sm">Programmes de développement démocratique</p>
          </div>
        </div>
        
        <div class="text-center group">
          <div class="bg-gradient-to-br from-red-100 to-red-200 p-6 rounded-2xl shadow-lg group-hover:shadow-xl transition-all mb-4">
            <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-white text-2xl font-bold">🇩🇪</span>
            </div>
            <h3 class="text-lg font-bold text-red-800 mb-2">Fondation Konrad Adenauer</h3>
            <p class="text-red-700 text-sm">Formation politique et éducation civique</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Initiatives Collaboratives -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6">Initiatives Collaboratives</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Découvrez quelques-unes de nos principales collaborations et initiatives conjointes.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-sm p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all">
          <div class="text-4xl mb-4">🎓</div>
          <h3 class="text-xl font-bold mb-4">École de Démocratie</h3>
          <p class="text-gray-300 mb-4">
            Programme de formation en partenariat avec AFRICTIVISTES pour renforcer 
            les capacités des jeunes leaders africains.
          </p>
          <div class="text-sm text-yam-red font-medium">
            Participants: 500+ jeunes de 15 pays
          </div>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-bold mb-4">Observatoire de la Gouvernance</h3>
          <p class="text-gray-300 mb-4">
            Initiative conjointe avec le Forum Civil pour le suivi de la gouvernance 
            et la publication de rapports citoyens.
          </p>
          <div class="text-sm text-yam-red font-medium">
            Publications: 12 rapports annuels
          </div>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all">
          <div class="text-4xl mb-4">🗳️</div>
          <h3 class="text-xl font-bold mb-4">Mission d'Observation Électorale</h3>
          <p class="text-gray-300 mb-4">
            Collaboration avec WAEON pour l'observation des élections dans plusieurs 
            pays de la sous-région ouest-africaine.
          </p>
          <div class="text-sm text-yam-red font-medium">
            Missions: 25+ élections observées
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Plateforme Numérique -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-4xl font-bold mb-6 text-yam-red">Réseaux Numériques</h2>
            <div class="w-16 h-1 bg-yam-red mb-6"></div>
          </div>
          
          <p class="text-lg text-gray-700 leading-relaxed">
            À l'ère du numérique, nous développons des partenariats stratégiques 
            avec des plateformes et organisations numériques pour amplifier 
            notre impact et toucher de nouvelles audiences.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-blue-600 rounded-full p-3 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m0 0V1a1 1 0 011-1h2a1 1 0 011 1v16a1 1 0 01-1 1h-2a1 1 0 01-1-1v-1M7 4H5a1 1 0 00-1 1v16a1 1 0 001 1h2a1 1 0 001-1V5a1 1 0 00-1-1z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Réseaux Sociaux</h3>
                <p class="text-gray-700">
                  Facebook, Twitter, Instagram, TikTok - 200K+ abonnés au total
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-red-600 rounded-full p-3 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Plateformes Vidéo</h3>
                <p class="text-gray-700">
                  YouTube, Lead The Change TV - Contenus éducatifs et informatifs
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-green-600 rounded-full p-3 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Applications Mobiles</h3>
                <p class="text-gray-700">
                  WhatsApp, Telegram - Groupes de mobilisation et d'information
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold mb-6 text-center text-yam-red">Notre Impact Digital</h3>
          
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center p-4 bg-white rounded-lg shadow-sm">
              <div class="text-3xl font-bold text-yam-red mb-2">200K+</div>
              <div class="text-sm text-gray-600">Abonnés réseaux sociaux</div>
            </div>
            
            <div class="text-center p-4 bg-white rounded-lg shadow-sm">
              <div class="text-3xl font-bold text-blue-600 mb-2">50M+</div>
              <div class="text-sm text-gray-600">Vues contenus vidéo</div>
            </div>
            
            <div class="text-center p-4 bg-white rounded-lg shadow-sm">
              <div class="text-3xl font-bold text-green-600 mb-2">100K+</div>
              <div class="text-sm text-gray-600">Membres groupes WhatsApp</div>
            </div>
            
            <div class="text-center p-4 bg-white rounded-lg shadow-sm">
              <div class="text-3xl font-bold text-purple-600 mb-2">15</div>
              <div class="text-sm text-gray-600">Pays connectés</div>
            </div>
          </div>
          
          <div class="mt-6 text-center">
            <a href="/contact" class="btn bg-yam-red hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-all">
              Nous rejoindre en ligne
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-16 bg-yam-red text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Construisons Ensemble</h2>
      <p class="text-xl max-w-3xl mx-auto mb-8">
        Rejoignez notre réseau de partenaires et d'organisations engagées 
        pour la démocratie et la bonne gouvernance en Afrique.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn bg-white text-yam-red hover:bg-gray-100 font-bold py-4 px-8 text-lg rounded-lg transition-all">
          Devenir partenaire
        </a>
        <a href="/rejoindre" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
          Rejoindre le réseau
        </a>
      </div>
    </div>
  </section>
</MainLayout>
