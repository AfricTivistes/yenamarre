
---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectNavbar from "../../components/ProjectNavbar.astro";

const navItems = [
  { name: 'Accueil', href: '/yenamarre' },
  { name: 'Histoire', href: '/yenamarre/histoire' },
  { name: 'Vision & Mission', href: '/yenamarre/vision-mission' },
  { name: 'Coordination', href: '/yenamarre/coordination', current: true },
  { name: 'Réseaux', href: '/yenamarre/reseaux' },
];
---

<MainLayout title="Coordination Nationale - Y'EN A MARRE" currentPath="/yenamarre/coordination">
  <ProjectNavbar items={navItems} accentColor="yam-red" />

  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-br from-gray-900 to-yam-red text-white">
    <div class="container-custom">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Coordination Nationale</h1>
        <div class="w-24 h-1 bg-white mx-auto mb-8"></div>
        <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
          Une organisation structurée et décentralisée qui assure la coordination 
          des actions sur l'ensemble du territoire national sénégalais.
        </p>
      </div>
    </div>
  </section>

  <!-- Structure Organisationnelle -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Structure Organisationnelle</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Y'EN A MARRE s'organise selon un modèle démocratique et participatif 
          qui garantit la représentativité et l'efficacité de l'action.
        </p>
      </div>
      
      <!-- Organigramme -->
      <div class="max-w-4xl mx-auto">
        <div class="space-y-8">
          <!-- Niveau 1: Assemblée Générale -->
          <div class="text-center">
            <div class="bg-yam-red text-white p-6 rounded-2xl shadow-lg max-w-md mx-auto">
              <div class="text-3xl mb-2">🏛️</div>
              <h3 class="text-xl font-bold mb-2">Assemblée Générale</h3>
              <p class="text-sm">Organe suprême de décision - Tous les 2 ans</p>
            </div>
          </div>
          
          <!-- Flèche vers le bas -->
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-yam-red mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
          
          <!-- Niveau 2: Coordination Nationale -->
          <div class="text-center">
            <div class="bg-red-600 text-white p-6 rounded-2xl shadow-lg max-w-md mx-auto">
              <div class="text-3xl mb-2">🎯</div>
              <h3 class="text-xl font-bold mb-2">Coordination Nationale</h3>
              <p class="text-sm">Direction exécutive - 9 membres élus</p>
            </div>
          </div>
          
          <!-- Flèche vers le bas -->
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-yam-red mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
          
          <!-- Niveau 3: Coordinations Régionales -->
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🗺️</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Régionales</h4>
              <p class="text-xs">14 régions du Sénégal</p>
            </div>
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🏘️</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Départementales</h4>
              <p class="text-xs">45 départements</p>
            </div>
            <div class="bg-red-500 text-white p-4 rounded-xl shadow-lg text-center">
              <div class="text-2xl mb-2">🏠</div>
              <h4 class="text-lg font-bold mb-1">Coordinations Locales</h4>
              <p class="text-xs">Communes et quartiers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coordination Nationale -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-4xl font-bold mb-6 text-yam-red">Coordination Nationale</h2>
            <div class="w-16 h-1 bg-yam-red mb-6"></div>
          </div>
          
          <p class="text-lg text-gray-700 leading-relaxed">
            La Coordination Nationale est l'organe exécutif de Y'EN A MARRE. 
            Composée de 9 membres élus par l'Assemblée Générale pour un mandat 
            de 2 ans renouvelable, elle assure la direction stratégique du mouvement.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Missions Principales</h3>
                <ul class="text-gray-700 space-y-2">
                  <li>• Définition de la stratégie et des orientations</li>
                  <li>• Coordination des actions nationales</li>
                  <li>• Représentation externe du mouvement</li>
                  <li>• Gestion des ressources et partenariats</li>
                </ul>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-3 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Composition</h3>
                <ul class="text-gray-700 space-y-2">
                  <li>• Coordinateur National</li>
                  <li>• Coordinateur Adjoint</li>
                  <li>• Secrétaire Général</li>
                  <li>• Trésorier</li>
                  <li>• 5 Conseillers thématiques</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <h3 class="text-2xl font-bold mb-6 text-center text-yam-red">Réunions et Décisions</h3>
          
          <div class="space-y-6">
            <div class="border-l-4 border-yam-red pl-4">
              <h4 class="font-bold mb-2">Réunions Ordinaires</h4>
              <p class="text-gray-600 text-sm">Tous les mois pour le suivi des activités</p>
            </div>
            
            <div class="border-l-4 border-yam-red pl-4">
              <h4 class="font-bold mb-2">Réunions Extraordinaires</h4>
              <p class="text-gray-600 text-sm">En cas de situations urgentes</p>
            </div>
            
            <div class="border-l-4 border-yam-red pl-4">
              <h4 class="font-bold mb-2">Prise de Décision</h4>
              <p class="text-gray-600 text-sm">Consensus ou majorité qualifiée (2/3)</p>
            </div>
            
            <div class="border-l-4 border-yam-red pl-4">
              <h4 class="font-bold mb-2">Redevabilité</h4>
              <p class="text-gray-600 text-sm">Rapport trimestriel aux coordinations régionales</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coordinations Régionales -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Coordinations Régionales</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Y'EN A MARRE est présent dans les 14 régions du Sénégal à travers 
          des coordinations régionales autonomes et dynamiques.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Région de Dakar</h3>
          <p class="text-gray-600 mb-4">Coordination la plus ancienne, centre névralgique du mouvement.</p>
          <div class="text-sm text-gray-500">
            <p>• Départements: Dakar, Guédiawaye, Pikine, Rufisque</p>
            <p>• Membres actifs: 2000+</p>
          </div>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Région de Thiès</h3>
          <p class="text-gray-600 mb-4">Forte mobilisation dans les zones urbaines et rurales.</p>
          <div class="text-sm text-gray-500">
            <p>• Départements: Thiès, Tivaouane, Mbour</p>
            <p>• Membres actifs: 800+</p>
          </div>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Région de Saint-Louis</h3>
          <p class="text-gray-600 mb-4">Engagement particulier sur les questions de gouvernance locale.</p>
          <div class="text-sm text-gray-500">
            <p>• Départements: Saint-Louis, Dagana, Podor</p>
            <p>• Membres actifs: 600+</p>
          </div>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Région de Diourbel</h3>
          <p class="text-gray-600 mb-4">Focus sur l'éducation civique et la participation électorale.</p>
          <div class="text-sm text-gray-500">
            <p>• Départements: Diourbel, Mbacké, Bambey</p>
            <p>• Membres actifs: 500+</p>
          </div>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Région de Kaolack</h3>
          <p class="text-gray-600 mb-4">Actions de sensibilisation dans le bassin arachidier.</p>
          <div class="text-sm text-gray-500">
            <p>• Départements: Kaolack, Nioro, Guinguinéo</p>
            <p>• Membres actifs: 450+</p>
          </div>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl border-l-4 border-yam-red">
          <h3 class="text-xl font-bold mb-4">Autres Régions</h3>
          <p class="text-gray-600 mb-4">Ziguinchor, Kolda, Tambacounda, Fatick, Kaffrine, Kédougou, Louga, Matam, Sédhiou.</p>
          <div class="text-sm text-gray-500">
            <p>• Coordinations actives dans 9 régions</p>
            <p>• Membres actifs: 1500+</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commissions Thématiques -->
  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yam-red">Commissions Thématiques</h2>
        <div class="w-24 h-1 bg-yam-red mx-auto mb-8"></div>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Des groupes de travail spécialisés pour approfondir les différentes thématiques 
          de notre engagement citoyen.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-lg text-center group hover:-translate-y-2 transition-all">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Gouvernance & Démocratie</h3>
          <p class="text-gray-600 text-sm">Suivi des politiques publiques et promotion de la transparence</p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg text-center group hover:-translate-y-2 transition-all">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Éducation & Formation</h3>
          <p class="text-gray-600 text-sm">Développement de programmes d'éducation civique</p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg text-center group hover:-translate-y-2 transition-all">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Communication & Médias</h3>
          <p class="text-gray-600 text-sm">Stratégies de communication et relations avec les médias</p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg text-center group hover:-translate-y-2 transition-all">
          <div class="bg-yam-red rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Mobilisation des Ressources</h3>
          <p class="text-gray-600 text-sm">Recherche de financement et gestion des partenariats</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Fonctionnement -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div>
            <h2 class="text-4xl font-bold mb-6 text-yam-red">Fonctionnement Démocratique</h2>
            <div class="w-16 h-1 bg-yam-red mb-6"></div>
          </div>
          
          <p class="text-lg text-gray-700 leading-relaxed">
            Y'EN A MARRE fonctionne selon des principes démocratiques stricts qui garantissent 
            la participation de tous les membres et la transparence dans les décisions.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-2 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Élections Transparentes</h3>
                <p class="text-gray-700">
                  Tous les responsables sont élus selon des procédures démocratiques transparentes.
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-2 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Rotation des Responsabilités</h3>
                <p class="text-gray-700">
                  Limitation des mandats pour favoriser le renouvellement et éviter la concentration du pouvoir.
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-yam-red rounded-full p-2 flex-shrink-0 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2">Redevabilité Permanente</h3>
                <p class="text-gray-700">
                  Rapports réguliers et assemblées de reddition de comptes à tous les niveaux.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src="/placeholder.svg?height=600&width=800&query=Democratic assembly meeting in Senegal" 
            alt="Assemblée démocratique Y'EN A MARRE" 
            class="w-full h-auto rounded-2xl shadow-2xl"
          />
          <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-lg shadow-lg border-l-4 border-yam-red">
            <div class="text-center">
              <div class="text-2xl font-bold text-yam-red">5000+</div>
              <div class="text-sm text-gray-600">Membres actifs</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-16 bg-yam-red text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Rejoignez Notre Organisation</h2>
      <p class="text-xl max-w-3xl mx-auto mb-8">
        Participez à la construction d'une organisation citoyenne forte et démocratique. 
        Votre engagement peut faire la différence dans votre région.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/rejoindre" class="btn bg-white text-yam-red hover:bg-gray-100 font-bold py-4 px-8 text-lg rounded-lg transition-all">
          Devenir membre
        </a>
        <a href="/contact" class="btn bg-transparent border-2 border-white text-white hover:bg-white/10 py-4 px-8 text-lg rounded-lg transition-all">
          Contacter une coordination
        </a>
      </div>
    </div>
  </section>
</MainLayout>
