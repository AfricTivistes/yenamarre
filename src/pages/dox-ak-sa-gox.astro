---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectNavbar from '../components/ProjectNavbar.astro';
import BureauxMap from '../components/BureauxMap.astro';
import { getPageAcf, field } from '../utils/wp';
import { getIcon } from '../utils/icons';

// Contenu de secours : utilisé tant que les champs ACF de WordPress sont vides
// ou si le site WordPress est injoignable au build. La page reste donc identique
// à l'existant jusqu'à ce que l'éditeur renseigne les champs dans WP admin.
const defaults: Record<string, string> = {
  hero_title: 'Dox ak Sa Gox',
  hero_subtitle: 'Marcher avec sa communauté pour bâtir une citoyenneté active',
  hero_desc:
    "Un projet pour mobiliser et renforcer la participation citoyenne, en soutenant le contrôle citoyen de l'action publique et la reddition des comptes.",
  obj1_titre: 'Participation citoyenne',
  obj1_texte:
    "Favoriser une forte participation des citoyens aux débats publics : délibérations, fora, concertations locales d'intérêt public par la mise en place de l'observatoire de la démocratie représenté dans toutes les localités.",
  obj2_titre: 'Éveil de conscience',
  obj2_texte:
    "Susciter un éveil de conscience développé sur le droit des citoyens d'être informés sur la gestion des affaires publiques et l'obligation des élus de rendre compte aux citoyens par la création d'un site web consacré au monitoring.",
  obj3_titre: 'Sensibilisation',
  obj3_texte:
    "Mettre en œuvre un programme de sensibilisation sur le contrôle et la participation des citoyens dans l'action publique, la reddition des comptes et le respect des promesses électorales.",
  obj4_titre: 'Manifestations citoyennes',
  obj4_texte:
    "Initier des manifestations citoyennes populaires à l'échelle nationale, pour permettre aux citoyens d'exprimer leurs priorités, et aux élus de les prendre en compte dans l'élaboration des politiques publiques.",
  act1_titre: 'Formation et renforcement de capacités',
  act1_texte:
    "Le renforcement des capacités des jeunes a pour but de leur doter des outils susceptibles de leur permettre d'exercer un meilleur contrôle citoyen sur l'action des pouvoirs publics. Pour cette première année du programme, le Leadership et les outils de la Gouvernance locale ainsi que la prise en compte des questions de genre sont les principaux axes retenus pour les activités de renforcement des capacités.",
  act2_titre: 'Les "Jury citoyens itinérants"',
  act2_texte:
    "L'idée est de valoriser la capacité de mobilisation des leaders du mouvement Y en a Marre en leur faisant sillonner le pays dans le but de tenir de grands rassemblements citoyens ayant pour objectif de créer un dialogue constructif entre les citoyens et leurs élus. Ces manifestations donnent la possibilité aux citoyens des localités d'exprimer leur opinion sur la gouvernance locale, d'exposer leurs priorités pour une meilleure prise en compte de celles-ci par leurs élus, et offrent également l'opportunité d'interpeler les élus sur des échéances.",
  // Nom d'icône par défaut si le champ ACF est vide ou absent
  obj1_icone: 'users',
  obj2_icone: 'lightbulb',
  obj3_icone: 'book',
  obj4_icone: 'megaphone',
  act1_icone: 'book',
  act2_icone: 'badge-check',
};

// Valeurs ACF de la page WordPress "dox-ak-sa-gox" (chargées au build via dewp).
const acf = await getPageAcf('dox-ak-sa-gox');

// Valeur WordPress non vide, sinon repli sur le contenu par défaut.
const f = (key: string): string => field(acf, key, defaults[key]);

const objectifs = [
  {
    titre: f('obj1_titre'),
    texte: f('obj1_texte'),
    icon: getIcon(f('obj1_icone')),
  },
  {
    titre: f('obj2_titre'),
    texte: f('obj2_texte'),
    icon: getIcon(f('obj2_icone')),
  },
  {
    titre: f('obj3_titre'),
    texte: f('obj3_texte'),
    icon: getIcon(f('obj3_icone')),
  },
  {
    titre: f('obj4_titre'),
    texte: f('obj4_texte'),
    icon: getIcon(f('obj4_icone')),
  },
];

const activites = [
  {
    titre: f('act1_titre'),
    texte: f('act1_texte'),
    gradient: 'from-green-600 to-green-700',
    icon: getIcon(f('act1_icone')),
  },
  {
    titre: f('act2_titre'),
    texte: f('act2_texte'),
    gradient: 'from-gray-800 to-black',
    icon: getIcon(f('act2_icone')),
  },
  {
    titre: f('act3_titre'),
    texte: f('act3_texte'),
    gradient: 'from-orange-600 to-orange-700',
    icon: getIcon(f('act3_icone')),
  },
  // Masqué tant que le champ ACF act3_titre est vide (pas de valeur par défaut pour cette 3e activité).
].filter((act) => act.titre && act.texte);

const navItems = [
  { name: 'Présentation', url: '/dox-ak-sa-gox#presentation' },
  { name: 'Objectifs', url: '/dox-ak-sa-gox#objectifs' },
  { name: 'Activités', url: '/dox-ak-sa-gox#activites' },
  { name: 'Nos bureaux', url: '/dox-ak-sa-gox#bureaux' },
  { name: 'Impact', url: '/dox-ak-sa-gox#impact' },
];
---

<MainLayout title={`${f('hero_title')} - Y'EN A MARRE`} currentPath="/dox-ak-sa-gox">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative min-h-[70vh] bg-gradient-to-br from-green-600 to-green-800 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/rassemblement1.webp')] bg-cover bg-center opacity-20"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-green-600/90 to-green-800/90"></div>

    <div class="container-custom relative z-20 h-full flex flex-col justify-center py-20 md:py-32">
      <div class="text-white text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          {f('hero_title')}
        </h1>
        <p class="text-xl md:text-2xl mb-8">
          {f('hero_subtitle')}
        </p>
        <p class="text-lg md:text-xl text-gray-100 max-w-3xl mx-auto">
          {f('hero_desc')}
        </p>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
      </svg>
    </div>
  </section>

  <!-- Bureaux Map Section -->
  <BureauxMap />

  <!-- Project Navigation -->
  <ProjectNavbar navItems={navItems} />

  <!-- Objectifs Section -->
  <section id="objectifs" class="py-16 md:py-24 bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Nos objectifs</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Quatre objectifs stratégiques pour renforcer la participation citoyenne
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {objectifs.map((obj) => (
          <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
            <div class="flex items-start mb-4">
              <div class="bg-green-600 text-white rounded-lg p-3 mr-4">
                <Fragment set:html={obj.icon} />
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">{obj.titre}</h3>
                <p class="text-gray-600">{obj.texte}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Activités Section -->
  <section id="activites" class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Nos activités</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Des actions concrètes pour renforcer la citoyenneté active
        </p>
      </div>

      <div class="max-w-5xl mx-auto space-y-8">
        {activites.map((act) => (
          <div class={`bg-gradient-to-r ${act.gradient} rounded-2xl overflow-hidden shadow-xl`}>
            <div class="p-8 md:p-12 text-white">
              <div class="flex items-center mb-6">
                <div class="bg-white/20 rounded-lg p-4 mr-6">
                  <Fragment set:html={act.icon} />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold">{act.titre}</h3>
              </div>
              <p class="text-lg leading-relaxed">{act.texte}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</MainLayout>
